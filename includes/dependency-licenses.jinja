{#- The dependency licenses CI accepts, as SPDX ids, derived from the `license` answer.
    Import it `with context`. Every project license can take the permissive ones and
    MPL-2.0, whose copyleft stays in the dependency's own files. The GPL family goes in
    only for a GPL or AGPL project, and the AGPL only for an AGPL one. A project without
    a license gets the list a permissive one gets. -#}
{%- set copyleft = license in ('GPL-3.0-or-later', 'AGPL-3.0-or-later') -%}
{%- set dependency_licenses = ['0BSD', 'Apache-2.0', 'BSD-2-Clause', 'BSD-3-Clause', 'CC0-1.0', 'ISC', 'MIT', 'MPL-2.0', 'Unicode-3.0', 'Zlib']
  + (['GPL-2.0-or-later', 'GPL-3.0-only', 'GPL-3.0-or-later', 'LGPL-2.1-or-later', 'LGPL-3.0-only', 'LGPL-3.0-or-later'] if copyleft else [])
  + (['AGPL-3.0-only', 'AGPL-3.0-or-later'] if license == 'AGPL-3.0-or-later' else []) -%}
