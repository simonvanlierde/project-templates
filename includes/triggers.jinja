{#- The push and pull_request triggers of the per-stack workflows. A nested package
    runs its workflow only when its own files, the workflow or the scripts it
    calls change. -#}
{% macro push_and_pr(dir, workflow, scripts=[]) %}
  push:
    branches: [main]
{%- if dir != '.' %}
    paths: ["{{ dir }}/**", ".github/workflows/{{ workflow }}.yml"{% for s in scripts %}, ".github/scripts/{{ s }}"{% endfor %}]
{%- endif %}
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
{%- if dir != '.' %}
    paths: ["{{ dir }}/**", ".github/workflows/{{ workflow }}.yml"{% for s in scripts %}, ".github/scripts/{{ s }}"{% endfor %}]
{%- endif %}
{%- endmacro %}
