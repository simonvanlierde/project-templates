{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    // Digest pins and config-migration PRs.
    "config:best-practices",
    ":semanticCommits",
    "schedule:weekly",
    // Minor and patch in one PR. The actions group below overrides it for actions.
    // Majors stay separate.
    "group:allNonMajor",
    // `# renovate: datasource=... depName=...` comments above `X_VERSION:` in
    // workflow env blocks.
    "customManagers:githubActionsVersions",
  ],
  // Both come in with config:best-practices. The npm preset's 3-day wait would beat the 7-day
  // minimumReleaseAge below, and this repo commits no lockfiles to maintain.
  ignorePresets: ["security:minimumReleaseAgeNpm", ":maintainLockFilesWeekly"],

  // Everything automerges and then runs with CI tokens, on developer machines, or
  // in every new scaffold. Scaffolds resolve only releases a week old (uv
  // exclude-newer, pnpm minimumReleaseAge). The wait gives a hijacked release
  // time to be yanked, and matches Dependabot's cooldown in scaffolds.
  minimumReleaseAge: "7 days",
  // A datasource with no release timestamps (some image digests) updates without
  // the wait instead of never.
  minimumReleaseAgeBehaviour: "timestamp-optional",

  // Renovate runs here because the pins live in .jinja files, which only
  // Renovate can be pointed at. Generated projects use Dependabot.

  // Both managers are line-based, so Jinja tags don't break them. They only need
  // patterns that match the .jinja names. The workflow pattern has no extension
  // because some files are named `{% if ... %}x.yml{% endif %}.jinja`.
  "github-actions": {
    managerFilePatterns: ["/(^|/)\\.github/workflows/.+/"],
  },
  dockerfile: {
    managerFilePatterns: ["/(^|/)[^/]*Dockerfile[^/]*\\.jinja$/"],
  },

  // The pre-commit, pep621 and npm managers parse their files, and Jinja breaks
  // the parse. These read raw text instead. They match nothing when a pattern
  // drifts, which lint.yml checks.
  customManagers: [
    {
      // Includes the root config: the built-in pre-commit manager is off by default.
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.pre-commit-config\\.yaml(\\.jinja)?$/"],
      matchStrings: ["repo: https://github\\.com/(?<depName>\\S+)\\s+rev: (?<currentValue>\\S+)"],
      datasourceTemplate: "github-tags",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)pyproject\\.toml\\.jinja$/"],
      matchStrings: [
        // Open-ended `"name>=x"` pins. The closing quote excludes the uv_build
        // range: raising only its floor could pass the cap.
        "\"(?<depName>[a-z][a-z0-9._-]*)>=(?<currentValue>\\d[\\d.]*)\"",
        // uv_build as one range, so both bounds move together.
        "\"(?<depName>uv_build)(?<currentValue>>=[\\d.]+,<[\\d.]+)\"",
      ],
      datasourceTemplate: "pypi",
      versioningTemplate: "pep440",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)package\\.json\\.jinja$/", "/(^|/)Dockerfile\\.jinja$/"],
      matchStrings: [
        // Caret ranges are the devDependencies. Keep @types/node literal. A
        // {{ node_version }} placeholder cannot be extracted.
        "\"(?<depName>@?[\\w.\\-/]+)\": \"\\^(?<currentValue>\\d[^\"]*)\"",
        "\"packageManager\": \"(?<depName>[a-z]+)@(?<currentValue>[\\d.]+)\"",
        // The ts image's bootstrap pnpm. Same depName as packageManager, so both
        // move in one PR.
        "npm i -g (?<depName>pnpm)@(?<currentValue>[\\d.]+)",
      ],
      datasourceTemplate: "npm",
    },
    {
      // copier.yml defaults Renovate can bump: the language versions and the go
      // stack's tool pins, each under a `# renovate: datasource=... depName=...`
      // comment. Quotes around the value stay outside the capture.
      customType: "regex",
      managerFilePatterns: ["/^copier\\.yml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n\\w+:\\n(?:  .*\\n)*?  default: \"?(?<currentValue>[^\"\\s]+)",
      ],
    },
  ],

  packageRules: [
    // Non-major updates merge once the required checks pass. Majors stay manual.
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },
    {
      matchManagers: ["github-actions"],
      groupName: "actions",
    },
    // A new language release becomes every new scaffold's default, before its
    // ecosystem may have caught up: merge those by hand.
    {
      matchFileNames: ["copier.yml"],
      matchDepNames: ["python", "node", "go", "rust-lang/rust"],
      automerge: false,
    },
    // `widen` raises uv_build's cap and keeps the floor, so older installed uv
    // versions keep working.
    {
      matchPackageNames: ["uv_build"],
      rangeStrategy: "widen",
    },
    // Maintained (commits in 2026-08) but tagged about once a year, which trips
    // the 1-year abandonment threshold.
    {
      matchPackageNames: ["pre-commit/pre-commit-hooks"],
      abandonmentThreshold: null,
    },
  ],
}
