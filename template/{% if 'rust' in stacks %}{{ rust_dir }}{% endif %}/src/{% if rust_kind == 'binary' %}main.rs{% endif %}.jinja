//! {{ project_description or project_name }}
//!
//! `{{ slug }} [--json] [NAME]` prints a greeting; `--help` and `--version` print and exit 0.
//! Exit codes: 0 ran, 2 usage error, 3 stdout could not be written. With `--json` every exit
//! that prints, a usage error included, writes one object on stdout that `output.schema.json`
//! describes; without it, errors go to stderr.

use std::io::{self, ErrorKind, Write};
use std::process::ExitCode;

use serde_json::json;

const USAGE: &str = "{{ slug }} [--json] [NAME]";

enum Action {
    Greet(String),
    Help,
    Version,
}

fn main() -> ExitCode {
    let args: Vec<String> = std::env::args().skip(1).collect();
    let json = args.iter().any(|a| a == "--json");
    let (text, code) = match parse(&args) {
        Ok(Action::Greet(name)) if json => (
            json!({ "schema_version": 1, "greeting": greeting(&name), "errors": [] }).to_string(),
            0,
        ),
        Ok(Action::Greet(name)) => (greeting(&name), 0),
        Ok(Action::Help) => (format!("usage: {USAGE}"), 0),
        Ok(Action::Version) => (
            concat!(env!("CARGO_PKG_NAME"), " ", env!("CARGO_PKG_VERSION")).to_owned(),
            0,
        ),
        Err(message) if json => {
            let error = json!({ "message": message, "help": USAGE });
            (
                json!({ "schema_version": 1, "errors": [error] }).to_string(),
                2,
            )
        }
        Err(message) => {
            eprintln!("error: {message}\nhelp: usage: {USAGE}");
            return ExitCode::from(2);
        }
    };
    let mut out = io::stdout().lock();
    match writeln!(out, "{text}").and_then(|()| out.flush()) {
        Ok(()) => ExitCode::from(code),
        // A closed pipe (`| head -1`) is the reader's choice, so it gets no message.
        Err(e) if e.kind() == ErrorKind::BrokenPipe => ExitCode::from(3),
        Err(e) => {
            eprintln!("error: cannot write to stdout: {e}");
            ExitCode::from(3)
        }
    }
}

/// What to do. A flag or value is echoed with `{:?}`, which escapes control characters.
fn parse(args: &[String]) -> Result<Action, String> {
    let mut name = None;
    for arg in args {
        match arg.as_str() {
            "--json" => {}
            "--help" => return Ok(Action::Help),
            "--version" => return Ok(Action::Version),
            flag if flag.starts_with('-') => return Err(format!("unknown option {flag:?}")),
            value if name.is_none() => name = Some(value.to_owned()),
            value => return Err(format!("unexpected argument {value:?}")),
        }
    }
    Ok(Action::Greet(name.unwrap_or_else(|| "world".to_owned())))
}

fn greeting(name: &str) -> String {
    format!("Hello, {name}!")
}

#[cfg(test)]
mod tests {
    use super::greeting;

    #[test]
    fn greets() {
        assert_eq!(greeting("world"), "Hello, world!");
    }
}
