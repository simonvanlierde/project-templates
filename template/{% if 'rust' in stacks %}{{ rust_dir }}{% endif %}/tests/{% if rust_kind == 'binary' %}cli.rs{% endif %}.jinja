//! Real runs of the binary, checked against the committed `--json` schema.

use std::process::Command;

use serde_json::Value;

/// Runs the binary and returns its exit code and stdout.
fn run(args: &[&str]) -> (i32, String) {
    let out = Command::new(env!("CARGO_BIN_EXE_{{ crate_name }}"))
        .args(args)
        .output()
        .unwrap();
    (
        out.status.code().unwrap(),
        String::from_utf8(out.stdout).unwrap(),
    )
}

fn assert_valid(stdout: &str) -> Value {
    let schema: Value = serde_json::from_str(include_str!("../output.schema.json")).unwrap();
    let document: Value = serde_json::from_str(stdout).unwrap();
    jsonschema::validate(&schema, &document).unwrap();
    document
}

#[test]
fn json_success_matches_the_schema() {
    let (code, stdout) = run(&["--json", "Ada"]);
    assert_eq!(code, 0);
    assert_eq!(assert_valid(&stdout)["greeting"], "Hello, Ada!");
}

#[test]
fn json_usage_error_matches_the_schema() {
    let (code, stdout) = run(&["--json", "--nope"]);
    assert_eq!(code, 2);
    assert_eq!(assert_valid(&stdout)["errors"].as_array().unwrap().len(), 1);
}
