{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "{{ slug }} --json",
  "description": "The one object {{ slug }} prints with --json, on every exit. Change a field's meaning or remove one only with a new schema_version and a major release.",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "greeting", "errors"],
      "properties": {
        "schema_version": { "const": 1 },
        "greeting": { "type": "string" },
        "errors": { "type": "array", "maxItems": 0 }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "errors"],
      "properties": {
        "schema_version": { "const": 1 },
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["message", "help"],
            "properties": { "message": { "type": "string" }, "help": { "type": "string" } }
          }
        }
      }
    }
  ]
}
