{% from 'includes/dependency-licenses.jinja' import dependency_licenses with context -%}
# cargo-deny: `just rs-check` and CI run `cargo deny check` against this file.

# Vulnerabilities and unmaintained crates fail the check; yanked crates only warn.
[advisories]

[licenses]
{%- if license != 'none' %}
# The dependency licenses that this crate's {{ license }} license can take. Add an
# exception per crate rather than widening the list.
{%- else %}
# Permissive licenses only, for dependencies. Add an exception per crate rather than
# widening the list.
{%- endif %}
allow = [
{%- for l in dependency_licenses %}
  "{{ l }}",
{%- endfor %}
  # cargo-deny matches a license exception only as the whole expression (target-lexicon).
  "Apache-2.0 WITH LLVM-exception",
]
# The list is policy, not an inventory: allowed licenses nothing uses yet are fine.
unused-allowed-license = "allow"

# Crates with `publish = false`, this one included, are not license-checked.
[licenses.private]
ignore = true

[bans]
multiple-versions = "warn"

# crates.io only: a git dependency or another registry fails the check.
[sources]
unknown-registry = "deny"
unknown-git = "deny"
