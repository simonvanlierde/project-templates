# The documentation site: `just docs` builds the Markdown in docs/ into _docs/, and
# docs.yml deploys it to GitHub Pages. Without a `nav`, the menu follows the files in docs/.
# Settings: https://zensical.org/docs/setup/basics/
[project]
site_name = {{ project_name | to_json }}
{%- if project_description %}
site_description = {{ project_description | to_json }}
{%- endif %}
site_url = "https://{{ github_user | lower }}.github.io/{{ slug }}/"
repo_url = "https://github.com/{{ github_user }}/{{ slug }}"
repo_name = "{{ github_user }}/{{ slug }}"
edit_uri = "edit/main/docs/"
copyright = {{ (author_name ~ (' · ' ~ license if license != 'none' else '')) | to_json(ensure_ascii=False) }}
site_dir = "_docs"
extra_css = ["assets/docs-tokens.css", "assets/docs.css"]
extra_javascript = ["assets/docs.js"]

[project.theme]
font = false
custom_dir = "docs-overrides"
features = [
  "content.action.edit",
  "content.code.copy",
  "navigation.footer",
  "navigation.path",
  "navigation.sections",
  "navigation.top",
  "navigation.tracking",
  "search.highlight",
  "toc.follow",
]

[project.theme.icon]
repo = "fontawesome/brands/github"

# Follows the reader's system setting until they pick one with the header toggle.
[[project.theme.palette]]
media = "(prefers-color-scheme)"
toggle.icon = "lucide/sun-moon"
toggle.name = "Switch to light mode"

[[project.theme.palette]]
media = "(prefers-color-scheme: light)"
scheme = "default"
toggle.icon = "lucide/sun"
toggle.name = "Switch to dark mode"

[[project.theme.palette]]
media = "(prefers-color-scheme: dark)"
scheme = "slate"
toggle.icon = "lucide/moon"
toggle.name = "Switch to system preference"

# docs-overrides/main.html reads og_image for the link-preview tags. `just og-card` renders the
# image and puts its hash in this URL, since link previews cache by URL.
[project.extra]
og_image = "assets/og.png"
# The footer names the project's own links, not the site generator.
generator = false

[[project.extra.social]]
icon = "fontawesome/brands/github"
link = "https://github.com/{{ github_user }}/{{ slug }}"
name = "Source on GitHub"
{%- if publish_to_pypi | default(false) %}

[[project.extra.social]]
icon = "fontawesome/brands/python"
link = "https://pypi.org/project/{{ slug }}/"
name = "{{ slug }} on PyPI"
{%- endif %}

# Line anchors are empty links, which screen readers announce without a name.
[project.markdown_extensions.pymdownx.highlight]
anchor_linenums = false
{%- if docs_api %}

# docs/reference.md renders the docstrings under this path, read without importing the package.
[project.plugins.mkdocstrings.handlers.python]
paths = ["{{ python_dir if python_layout == 'flat' else ('' if python_dir == '.' else python_dir ~ '/') ~ 'src' }}"]
{%- endif %}
