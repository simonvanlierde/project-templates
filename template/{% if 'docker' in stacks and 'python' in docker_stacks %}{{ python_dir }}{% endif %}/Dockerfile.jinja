# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
#
# Follows https://docs.astral.sh/uv/guides/integration/docker/, in particular its
# "non-editable install" multi-stage pattern. The final image gets the venv only:
# no source tree, no uv, no lockfile.

# ---- build ------------------------------------------------------------------
FROM python:{{ python_version }}-slim-trixie AS builder

# Astral's recommended install: copy the binary in instead of basing the image on
# uv, so both stages share one base. Tag plus digest, since a tag alone is
# mutable. No bot updates this line in a generated project: bump it by hand,
# together with the uv_build pin in pyproject.toml, which ships from the same
# release.
COPY --from=ghcr.io/astral-sh/uv:0.12.22@sha256:f513a91fc62fe7c17567eee97230dd198e43edb8a9fbecca843714a4358fe1bc /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# Dependencies first, bind-mounted instead of copied: the layer stays cached until
# the lockfile changes, and neither file lands in the image.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project --no-editable

COPY . /app
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-editable

# ---- runtime ----------------------------------------------------------------
FROM python:{{ python_version }}-slim-trixie AS runtime

LABEL org.opencontainers.image.source="https://github.com/{{ github_user }}/{{ slug }}" \
      org.opencontainers.image.description={{ project_description | to_json }} \
{%- if license != 'none' %}
      org.opencontainers.image.licenses="{{ license }}" \
{%- endif %}
      org.opencontainers.image.title={{ project_name | to_json }}

RUN groupadd --system --gid 1001 app \
 && useradd --system --uid 1001 --gid app --no-create-home app

WORKDIR /app

# --no-editable installed the project into the venv, so the venv is the whole
# application and the source tree never enters this stage.
COPY --from=builder --chown=app:app /app/.venv /app/.venv

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
{%- if kind == 'web-service' %}

# The app defaults to loopback. In the container it must listen on every
# interface for the published port to reach it.
ENV HOST=0.0.0.0 \
    PORT={{ app_port }}
{%- endif %}

# Numeric, so the uid holds even where the host has no user named app.
USER 1001:1001
EXPOSE {{ app_port }}

# NOTE: assumes an HTTP GET /health returning 200. Drop this if the image is not a service.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["python", "-c", "import urllib.request as r,sys; sys.exit(0 if r.urlopen('http://127.0.0.1:{{ app_port }}/health').status==200 else 1)"]

{% if kind != 'web-service' -%}
# NOTE: needs src/{{ module_name }}/__main__.py. Replace with your real entrypoint.
{% endif -%}
CMD ["python", "-m", "{{ module_name }}"]
