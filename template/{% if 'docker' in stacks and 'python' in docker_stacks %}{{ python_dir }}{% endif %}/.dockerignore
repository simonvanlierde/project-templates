# Keep the build context small: everything here is rebuilt in the image,
# irrelevant to it, or a secret. Each image has its own file next to its
# Dockerfile, because Docker reads it from the root of the build context.

# VCS / tooling metadata
.git
.github
.copier-answers.yml

# Rebuilt inside the image
.venv
build
dist
*.egg-info

# Test, lint, and cache artifacts
__pycache__
.pytest_cache
.ruff_cache
.ipynb_checkpoints
htmlcov
.coverage
coverage.xml

# Left out of the image. With `COPY . /app` they would enter the layer hash. Touching
# a test or notebook would then rebuild every layer from that `COPY` on, which
# `docker compose up --watch` does on every source change.
tests
notebooks
data
.editorconfig
.pre-commit-config.yaml

# Secrets
.env
.env.*
!.env.example

# Docker meta files themselves
Dockerfile
.dockerignore
compose.yaml
