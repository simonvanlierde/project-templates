{%- set imports = [('python', 'py'), ('ts', 'ts'), ('rust', 'rs'), ('go', 'go'), ('docker', 'docker')] | selectattr('0', 'in', stacks) | list -%}
# Task runner: https://just.systems. `just` lists the recipes, `just <name>` runs one.
{%- if imports %}
#
# Each stack's recipes are in just/, prefixed ({% for stack, prefix in imports if not (stack == 'docker' and docker_image) %}`{{ prefix }}-`{{ ', ' if not loop.last }}{% endfor %}) because
# imports share one namespace, except the few only one kind has, such as `pipeline` or `up`.
{%- for stack, _ in imports %}
import? 'just/{{ stack }}.just'
{%- endfor %}
{%- endif %}

# List the recipes (what a bare `just` runs).
default:
    @just --list

# The stack checks CI runs{% if 'python' in stacks and kind == 'data-pipeline' %}, except the live `just pipeline`{% endif %}. `just hooks` runs the git hooks, which CI also runs.
check:
{%- if 'python' in stacks %}
    @just py-check
{%- endif %}
{%- if 'ts' in stacks %}
    @just ts-check
{%- endif %}
{%- if 'rust' in stacks %}
    @just rs-check
{%- endif %}
{%- if 'go' in stacks %}
    @just go-check
{%- endif %}
{%- if compose_only %}
    @just docker-check
{%- endif %}
{%- if site == 'astro' %}
    @just site
{%- endif %}
    @if just --show local-check >/dev/null 2>&1; then just local-check; fi

# Fix and format every stack here, as each stack's `fmt` recipe does.
fmt:
{%- if 'python' in stacks %}
    @just py-fmt
{%- endif %}
{%- if 'ts' in stacks %}
    @just ts-fmt
{%- endif %}
{%- if 'rust' in stacks %}
    @just rs-fmt
{%- endif %}
{%- if 'go' in stacks %}
    @just go-fmt
{%- endif %}
{%- if compose_only %}
    @just docker-fmt
{%- endif %}
{%- set prek = ('pnpm' if ts_dir == '.' else 'pnpm -C ' ~ ts_dir) ~ ' exec prek' if ('ts' in stacks and 'python' not in stacks) else 'prek' %}

# The checks workflow skips the hooks in its SKIP list, which the stack workflows run
# instead. Here they all run, so this can fail where the checks workflow passes.

# Run every git hook over the whole repo, not just staged files.
hooks:
    {{ prek }} run -a
{%- if site != 'none' %}

# Replace the body with the project's own build, such as `uv run site/build.py --out {{ site_out }}`.

# Build the page in site/ into {{ site_out }}/, which site.yml deploys{% if site_on_workers and worker %}, after the Worker's tests{% endif %}.
site:
{%- if site_on_workers and worker %}
    node --test site/worker/index.test.mjs
{%- endif %}
{%- if site == 'plain' %}
    rm -rf {{ site_out }}
    cp -R site {{ site_out }}
{%- if site_on_workers and worker %}
    # The Worker script is code, not a page to serve.
    rm -rf {{ site_out }}/worker
{%- endif %}
{%- elif site == 'astro' %}
    pnpm -C site install --frozen-lockfile
    ASTRO_TELEMETRY_DISABLED=1 pnpm -C site run build
{%- endif %}
{%- endif %}
{%- if site == 'astro' %}

# `just site` and CI install with --frozen-lockfile.

# Install the site's node_modules, and write site/pnpm-lock.yaml if it is missing.
site-sync:
    pnpm -C site install
{%- endif %}
{%- if docs_site %}
{%- set zensical = 'uvx --exclude-newer "1 week"' ~ (' --with mkdocstrings-python==' ~ mkdocstrings_python_version if docs_api else '') ~ ' zensical@' ~ zensical_version %}

# Build docs/ into _docs/, which docs.yml deploys. --strict fails on any warning, such as a broken link.
docs:
    {{ zensical }} build --strict

# Serve docs/ at http://localhost:8000, rebuilt on each save.
docs-serve:
    {{ zensical }} serve
{%- endif %}
{% if citable %}
# The writer exits 1 whenever it changes a file, so the check that follows decides
# the result.

# Rewrite codemeta.json to agree with CITATION.cff, then check.
citation:
    -{{ prek }} run citesync-write --hook-stage manual --all-files
    {{ prek }} run citesync --all-files
{% endif %}
{%- set app_pkg = (ts_dir ~ '/' if ts_dir != '.' else '') ~ 'package.json' if web_app else '' %}
# Release X.Y.Z. First run: {% if app_pkg %}set {{ app_pkg }}'s version, {% endif %}cut CHANGELOG's [Unreleased] into [X.Y.Z] and commit {{ 'both' if app_pkg else 'it' }}; merge that to main. Second run, on up-to-date main: sign and push tag vX.Y.Z.
release version:
    #!/usr/bin/env bash
    set -euo pipefail
    version={% raw %}{{ version }}{% endraw %}
    [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "not a version: $version" >&2; exit 1; }
    tag=v$version
    repo=https://github.com/{{ github_user }}/{{ slug }}
{%- if 'python' in stacks and publish_to_pypi %}
    # The build takes its version from the manifest and refuses a tag that differs.
    [ "$(uv version --short --no-sync --directory {{ python_dir }})" = "$version" ] || { echo "{{ python_dir ~ '/' if python_dir != '.' else '' }}pyproject.toml is not at $version" >&2; exit 1; }
{%- endif %}
{%- if 'ts' in stacks and publish_to_npm %}
    [ "$(node -p "require('./{{ ts_dir }}/package.json').version")" = "$version" ] || { echo "{{ ts_dir ~ '/' if ts_dir != '.' else '' }}package.json is not at $version" >&2; exit 1; }
{%- endif %}
{%- if citable %}
    # citesync fails while the manifests and citation files disagree. Run it before any file changes.
    {{ prek }} run citesync --all-files
{%- endif %}
    git fetch --quiet origin main
    # Not grep -q: it stops reading early, and under pipefail git show then fails on a
    # changelog bigger than the pipe buffer.
    if git show origin/main:CHANGELOG.md | grep "^## \[$version\] - " >/dev/null; then
{%- if app_pkg %}
        # The app shows {{ app_pkg }}'s version, so the tag must name the same one.
        app=$(git show origin/main:{{ app_pkg }} | node -p 'JSON.parse(require("fs").readFileSync(0, "utf8")).version')
        [ "$app" = "$version" ] || { echo "{{ app_pkg }} on origin/main is at $app, not $version" >&2; exit 1; }
{%- endif %}
        .github/scripts/tag-release.sh "$version"
{%- if public and citable %}
        echo "Archive it in Software Heritage: https://archive.softwareheritage.org/save/ (git, $repo). The README badge then links to the SWHID."
{%- endif %}
        exit 0
    fi
    prev=$(sed -n 's/^## \[\([0-9][0-9.]*\)\].*/\1/p' CHANGELOG.md | head -1)
    if [ -n "$prev" ]; then link=$repo/compare/v$prev...$tag; else link=$repo/releases/tag/$tag; fi
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    awk -v v="$version" -v d="$(date +%F)" -v repo="$repo" -v link="$link" '
        /^## \[Unreleased\]/ && !h { print; print ""; print "## [" v "] - " d; h = 1; next }
        /^\[Unreleased\]: / { print "[Unreleased]: " repo "/compare/v" v "...HEAD"; print "[" v "]: " link; l = 1; next }
        { print }
        END { if (!h) exit 1; if (!l) { print ""; print "[Unreleased]: " repo "/compare/v" v "...HEAD"; print "[" v "]: " link } }
    ' CHANGELOG.md >"$tmp" || { echo "CHANGELOG.md has no [Unreleased] section" >&2; exit 1; }
    .github/scripts/release-notes.sh "$tag" "$tmp" >/dev/null || { echo "[Unreleased] has no entries to release" >&2; exit 1; }
{%- if app_pkg %}
    # A line edit keeps the file as Biome formats it.
    sed -i.bak 's/^  "version": "[^"]*",$/  "version": "'"$version"'",/' {{ app_pkg }} && rm {{ app_pkg }}.bak
    [ "$(node -p "require('./{{ app_pkg }}').version")" = "$version" ] || { echo "could not set the version in {{ app_pkg }}" >&2; exit 1; }
{%- endif %}
    cp "$tmp" CHANGELOG.md
    git add CHANGELOG.md{{ ' ' ~ app_pkg if app_pkg }}
    git commit -s -m "chore: release $version" -- CHANGELOG.md{{ ' ' ~ app_pkg if app_pkg }}
    echo "Merge this commit to main, then run: just release $version"

# Protect the default branch (no deletion, no force-push, linear history, PRs squash-merged after the always-on checks pass{% if public %} and one approval{% endif %}) and the v* tags{% if public %}. Turn on secret scanning with push protection, private vulnerability reporting, CodeQL default setup{% endif %} and Dependabot alerts{% if publish_to_pypi or publish_to_npm or publish_to_ghcr %}. Set up release environments with required review{% endif %}{% if web_app %}. Create the `preview` environment for pull request previews and the `production` environment, deployed from `main` only{% endif %}{% if dependency_bot == 'dependabot' %}. Create the `copier-update` environment, used from `main` only{% endif %}. Safe to rerun.
repo-settings:
    #!/usr/bin/env bash
    set -euo pipefail
    err=$(mktemp)
    trap 'rm -f "$err"' EXIT
    fail() {
        cat "$err" >&2
        grep -qE 'HTTP (403|404)' "$err" && echo "Rulesets on a private repo need a paid GitHub plan (or the repo does not exist, or you lack admin rights)." >&2
{%- if public and dependency_bot == 'renovate' %}
        grep -q 'must be part of the ruleset source' "$err" && echo "The main ruleset lets the Renovate app bypass the review, and GitHub accepts that only once the app is installed on this repo: add it at https://github.com/apps/renovate, then rerun." >&2
{%- endif %}
        exit 1
    }
    # Merge-method switches live on the repo itself; the ruleset also limits the PR button.
    gh api -X PATCH repos/{owner}/{repo} -F allow_squash_merge=true -F allow_merge_commit=false -F allow_rebase_merge=false -F delete_branch_on_merge=true{% if public %} -F web_commit_signoff_required=true{% endif %} >/dev/null 2>"$err" || fail
{%- if public %}
    # Push protection refuses a push that holds a known secret format, before it reaches the repo.
    # A private repo without Secret Protection refuses this, so it warns instead of failing.
    if gh api -X PATCH repos/{owner}/{repo} -f 'security_and_analysis[secret_scanning][status]=enabled' -f 'security_and_analysis[secret_scanning_push_protection][status]=enabled' >/dev/null 2>"$err"; then
        echo "Turned on secret scanning and push protection."
    else
        echo "Warning: secret scanning could not be turned on (a private repo needs Secret Protection): $(cat "$err")" >&2
    fi
{%- endif %}
    # Adopt an existing ruleset by name, else one with the same target that protects the same
    # refs as the file, updating it in place. The list has no conditions, so each candidate is read.
    for name in main{% if public %} main-checks{% endif %} tags; do
        file=.github/rulesets/$name.json
        case "$name" in
            main) want='["~DEFAULT_BRANCH"]' filter='.[] | select(.target == "branch" and (.name | test("checks?") | not)) | .id' ;;
            main-checks) want='["~DEFAULT_BRANCH"]' filter='.[] | select(.target == "branch" and (.name | test("checks?"))) | .id' ;;
            tags) want='["refs/tags/v*"]' filter='.[] | select(.target == "tag") | .id' ;;
        esac
        id=$(gh api "repos/{owner}/{repo}/rulesets?includes_parents=false" --jq "first(.[] | select(.name == \"$name\") | .id) // empty" 2>"$err") || fail
        if [ -z "$id" ]; then
            candidates=$(gh api "repos/{owner}/{repo}/rulesets?includes_parents=false" --jq "$filter" 2>"$err") || fail
            for candidate in $candidates; do
                same=$(gh api "repos/{owner}/{repo}/rulesets/$candidate" --jq ".conditions.ref_name.include == $want" 2>"$err") || fail
                if [ "$same" = true ]; then
                    id=$candidate
                    break
                fi
            done
        fi
        if [ -n "$id" ]; then
            gh api -X PUT "repos/{owner}/{repo}/rulesets/$id" --input "$file" >"$err" 2>&1 || fail
            echo "Updated ruleset '$name' ($id)."
        else
            # gh prints GitHub's reason for a refusal on stdout, so fail() needs both.
            gh api -X POST repos/{owner}/{repo}/rulesets --input "$file" >"$err" 2>&1 || fail
            echo "Created ruleset '$name'."
        fi
    done
{%- if public %}
    # SECURITY.md sends reports to a private security advisory, which this turns on.
    gh api -X PUT repos/{owner}/{repo}/private-vulnerability-reporting >/dev/null 2>"$err" || fail
    echo "Turned on private vulnerability reporting."
    # CodeQL default setup scans every PR and push to main.
    if gh api -X PATCH repos/{owner}/{repo}/code-scanning/default-setup -f state=configured >"$err" 2>&1; then
        echo "Turned on CodeQL default setup."
    else
        echo "Warning: CodeQL default setup could not be turned on, so code scanning stays off: $(cat "$err")" >&2
    fi
{%- endif %}
    # Dependabot alerts let {{ 'Renovate' if dependency_bot == 'renovate' else 'Dependabot' }} open security PRs and turn on the dependency graph.
    gh api -X PUT repos/{owner}/{repo}/vulnerability-alerts >/dev/null 2>"$err" || fail
    echo "Turned on Dependabot alerts."
{%- set release_envs = [('pypi', publish_to_pypi | default(false)), ('npm', publish_to_npm | default(false)), ('ghcr', publish_to_ghcr | default(false))] | selectattr('1') | map(attribute='0') | list %}
{%- if release_envs %}
    # Environments limit publishing to version tags and require review before release.
    user_id=$(gh api user --jq .id 2>"$err") || fail
    for env in {{ release_envs | join(' ') }}; do
        gh api -X PUT "repos/{owner}/{repo}/environments/$env" \
            -F "reviewers[][type]=User" \
            -F "reviewers[][id]=$user_id" \
            -F "deployment_branch_policy[protected_branches]=false" \
            -F "deployment_branch_policy[custom_branch_policies]=true" >/dev/null 2>"$err" || fail
        policies=$(gh api "repos/{owner}/{repo}/environments/$env/deployment-branch-policies" --jq '.branch_policies[].name' 2>/dev/null || true)
        if ! echo "$policies" | grep -qxF 'v*'; then
            gh api -X POST "repos/{owner}/{repo}/environments/$env/deployment-branch-policies" -f name="v*" -f type="tag" >/dev/null 2>"$err" || fail
        fi
        if [ "$env" = "ghcr" ] && ! echo "$policies" | grep -qxF 'main'; then
            gh api -X POST "repos/{owner}/{repo}/environments/$env/deployment-branch-policies" -f name="main" -f type="branch" >/dev/null 2>"$err" || fail
        fi
        echo "Configured environment '$env'."
    done
{%- endif %}
{%- if web_app or site != 'none' %}
    # The preview jobs read the Cloudflare secrets from this environment. It takes no reviewer
    # or branch limit: previews run on pull request refs and must start unattended.
    gh api -X PUT "repos/{owner}/{repo}/environments/preview" >/dev/null 2>"$err" || fail
    echo "Configured environment 'preview'."
{%- endif %}
{%- if web_app or site_on_workers or dependency_bot == 'dependabot' %}
    # An environment that only main may deploy from, with no reviewer.
    main_only_env() {
        gh api -X PUT "repos/{owner}/{repo}/environments/$1" \
            -F "deployment_branch_policy[protected_branches]=false" \
            -F "deployment_branch_policy[custom_branch_policies]=true" >/dev/null 2>"$err" || fail
        policies=$(gh api "repos/{owner}/{repo}/environments/$1/deployment-branch-policies" --jq '.branch_policies[].name' 2>/dev/null || true)
        if ! echo "$policies" | grep -qxF 'main'; then
            gh api -X POST "repos/{owner}/{repo}/environments/$1/deployment-branch-policies" -f name="main" -f type="branch" >/dev/null 2>"$err" || fail
        fi
    }
{%- endif %}
{%- if web_app or site_on_workers %}
    # The production jobs deploy from main only, unattended, so no reviewer.
    main_only_env production
    echo "Configured environment 'production'. Add CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID to both environments: see the {{ 'Deploy' if web_app else 'Site' }} section of the README."
{%- endif %}
{%- if dependency_bot == 'dependabot' %}
    # copier-update.yml's push job reads the update App's key from this environment, from main only.
    main_only_env copier-update
    echo "Configured environment 'copier-update'. For template updates that change workflows, add the update App: https://github.com/simonvanlierde/project-templates/blob/main/docs/usage.md#the-update-app"
{%- endif %}
{%- set site_on_pages = site != 'none' and not site_on_workers %}
{%- if site_on_pages or docs_site %}
    # {{ 'site.yml' if site_on_pages else 'docs.yml' }} deploys to GitHub Pages from the workflow, not from a branch. GitHub answers
    # 409 when Pages is already on, and then the PUT switches its source instead. A 403 or
    # 422 means this repo cannot have Pages, such as a private repo on the free plan.
    if gh api -X POST repos/{owner}/{repo}/pages -f build_type=workflow >"$err" 2>&1; then
        echo "GitHub Pages deploys from Actions."
    elif grep -q 'HTTP 409' "$err"; then
        gh api -X PUT repos/{owner}/{repo}/pages -f build_type=workflow >"$err" 2>&1 || fail
        echo "GitHub Pages deploys from Actions."
    elif grep -qE 'HTTP (403|422)' "$err"; then
        echo "Warning: GitHub Pages is not available for this repo (a private repo needs a paid plan for it), so {{ 'site.yml' if site_on_pages else 'docs.yml' }}'s deploy job skips.{{ ' Previews still run.' if site_on_pages else '' }}" >&2
    else
        fail
    fi
{%- if site_on_pages %}
    echo "For the site's previews, add CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID to the 'preview' environment: https://github.com/simonvanlierde/project-templates/blob/main/docs/usage.md#static-site"
{%- endif %}
{%- endif %}
{%- if publish_to_pypi %}
    repo_full_name=$(gh api repos/{owner}/{repo} --jq .full_name 2>"$err") || fail
    owner=${repo_full_name%%/*}
    repo=${repo_full_name##*/}
    echo "PyPI pending publisher: https://pypi.org/manage/account/publishing/?provider=github&project_name={{ slug }}&owner=$owner&repository=$repo&workflow_filename=python-release.yml&environment=pypi"
{%- endif %}
{%- if public and citable %}
    echo "Zenodo: https://zenodo.org/account/settings/github/"
{%- endif %}
{%- if (public and (citable or level != 'minimal')) or publish_to_pypi %}
    if [ -f .github/first-release.md ]; then echo "First-release checklist: gh issue create --title 'First release' --body-file .github/first-release.md"; fi
{%- endif %}

# Set the GitHub About box from your answers: description{% if web_app or site_on_workers %}, homepage{% endif %} and a topic per stack. Adds topics, never removes yours. Safe to rerun.
repo-about:
    gh repo edit
{%- if project_description %} --description {{ "'" ~ project_description | replace("'", "'\\''") | replace("{{", "{{{{") ~ "'" }}
{%- endif %}
{%- if web_app or site_on_workers %} --homepage '{{ site_url }}'
{%- endif %}
{%- for t in [('python' in stacks, 'python'), ('ts' in stacks, 'typescript'), ('rust' in stacks, 'rust'), ('go' in stacks, 'go'), ('docker' in stacks, 'docker')] if t[0] %} --add-topic {{ t[1] }}
{%- endfor %}

# A repo's own recipes that copier updates never touch. A `local-check` recipe there runs
# at the end of `just check`.
import? 'just/local.just'
