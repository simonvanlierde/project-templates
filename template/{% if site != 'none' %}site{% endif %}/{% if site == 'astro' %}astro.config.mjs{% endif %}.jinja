import { defineConfig } from "astro/config";
{% if site_on_workers %}
// Static output: `astro build` writes plain files to dist/, which site.yml deploys to a
// Cloudflare Worker. It serves them from the root of `site`, as do the previews.
export default defineConfig({
  output: "static",
  // `just site-serve` prints port 4321, so a busy port is an error, not a silent move.
  server: { port: 4321 },
  vite: { server: { strictPort: true } },
  site: "{{ site_url if not web_app else 'https://' ~ worker_slug ~ '-site.' ~ github_user | lower ~ '.workers.dev' }}",
});
{%- else %}
// Static output: `astro build` writes plain files to dist/, which site.yml deploys.
// GitHub Pages serves a project's site at https://<user>.github.io/<repo>/, so links
// start from `base`. With a custom domain, set `site` to it and drop `base`, and change
// the preview job in site.yml to match: it serves the build under /{{ slug }}/.
export default defineConfig({
  output: "static",
  // `just site-serve` prints port 4321, so a busy port is an error, not a silent move.
  server: { port: 4321 },
  vite: { server: { strictPort: true } },
  site: "https://{{ github_user | lower }}.github.io",
  base: "/{{ slug }}",
});
{%- endif %}
