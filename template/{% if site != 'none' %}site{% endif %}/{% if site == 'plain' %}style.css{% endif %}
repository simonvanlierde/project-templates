/* TODO: this tool's own palette and type. The roles stay; the values are the project's. */
:root {
  color-scheme: light dark;
  --ground: #f4f5f2;
  --field: #fff;
  --ink: #17191c;
  --muted: #545a62;
  --rule: #d3d6d0;
  --accent: #0b6457;
  --on-accent: #fff;
  --error: #a8261b;
  --mono: ui-monospace, "Cascadia Code", "Source Code Pro", Menlo, Consolas, monospace;
  font:
    1rem / 1.5 system-ui,
    sans-serif;
}

@media (prefers-color-scheme: dark) {
  :root {
    --ground: #131517;
    --field: #1b1e21;
    --ink: #e7e9ea;
    --muted: #a0a7ae;
    --rule: #33383d;
    --accent: #6fd2bf;
    --on-accent: #0c1513;
    --error: #ff9a8c;
  }
}

* {
  box-sizing: border-box;
}

::selection {
  background: color-mix(in srgb, var(--accent) 28%, transparent);
}

body {
  margin: 0;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  background: var(--ground);
  color: var(--ink);
  accent-color: var(--accent);
  caret-color: var(--accent);
}

main {
  flex: 1;
}

a {
  color: inherit;
  text-decoration-color: var(--muted);
  text-underline-offset: 0.2em;
}

a:hover {
  text-decoration-color: currentColor;
}

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.wrap {
  width: min(72rem, 100% - 2rem);
  margin-inline: auto;
}

.skip {
  position: absolute;
  left: -100vw;
}

/* Over the header, so showing it moves nothing. */
.skip:focus {
  left: 1rem;
  top: 0.5rem;
  z-index: 1;
  padding: 0.5rem 1rem;
  background: var(--ground);
}

/* The skip link focuses <main> to move the reading point, not to show a ring around it. */
main:focus {
  outline: none;
}

/* Name, job and docs in one band, so the tool starts in the first screen. */
.masthead {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem 1.5rem;
  align-items: center;
  justify-content: space-between;
  padding-block: 1rem;
}

h1 {
  margin: 0;
  font-size: 1.375rem;
  line-height: 1.2;
  letter-spacing: -0.01em;
}

.job {
  margin: 0.125rem 0 0;
  max-width: 60ch;
  color: var(--muted);
}

/* Link targets and controls at least 44px tall. */
.masthead > a,
.links a,
button,
select,
.file {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
}

.workspace {
  display: grid;
  gap: 1rem 1.5rem;
}

@media (min-width: 48rem) {
  .workspace {
    grid-template-columns: 1fr 1fr;
  }
}

.pane {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.pane-head {
  display: flex;
  flex-wrap: wrap;
  gap: 0 1rem;
  align-items: center;
  justify-content: space-between;
  min-height: 44px;
}

.pane-head label:first-child,
h2 {
  margin: 0;
  font-size: 1rem;
  font-weight: 600;
}

textarea,
pre {
  height: clamp(12rem, 40dvh, 28rem);
  margin: 0;
  padding: 0.75rem;
  overflow: auto;
  font: 0.875rem / 1.55 var(--mono);
  tab-size: 2;
  color: var(--ink);
  background: var(--field);
  border: 1px solid var(--rule);
  border-radius: 6px;
  scrollbar-color: var(--rule) transparent;
}

textarea {
  width: 100%;
  resize: vertical;
}

textarea[aria-invalid] {
  border-color: var(--error);
}

pre {
  white-space: pre;
}

/* The result waits on a valid input: muted until it is the real thing. */
[data-state="empty"] pre,
[data-state="invalid"] pre {
  color: var(--muted);
  font-family: inherit;
}

.hint,
.error {
  margin: 0.375rem 0 0;
  font-size: 0.875rem;
}

.hint {
  color: var(--muted);
}

.error {
  color: var(--error);
  font-weight: 600;
}

.state {
  font-size: 0.875rem;
  color: var(--muted);
}

[data-state="ready"] .state {
  color: var(--accent);
  font-weight: 600;
}

[data-state="invalid"] .state {
  color: var(--error);
  font-weight: 600;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  align-items: center;
  margin-top: 0.75rem;
}

.actions output {
  font-size: 0.875rem;
  color: var(--muted);
}

button,
select,
.file {
  padding: 0 1rem;
  font: inherit;
  color: var(--ink);
  background: var(--field);
  border: 1px solid var(--rule);
  border-radius: 6px;
  cursor: pointer;
  transition: background-color 0.15s ease-out;
}

.primary {
  font-weight: 600;
  color: var(--on-accent);
  background: var(--accent);
  border-color: var(--accent);
}

.primary:hover:not(:disabled) {
  background: color-mix(in srgb, var(--accent) 85%, var(--ink));
}

button:disabled {
  color: var(--muted);
  background: transparent;
  border-color: var(--rule);
  cursor: not-allowed;
}

.file {
  font-size: 0.875rem;
}

.file:hover,
button:not(.primary, :disabled):hover {
  background: color-mix(in srgb, var(--accent) 8%, var(--field));
}

/* Out of sight, still read and focusable: the status line, and the native file control
   whose label is the button. */
.vh,
.file input {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.file:focus-within {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

details {
  margin-top: 1.5rem;
  padding-top: 0.25rem;
  border-top: 1px solid var(--rule);
}

details + details {
  margin-top: 0;
}

summary {
  padding-block: 0.625rem;
  font-weight: 600;
  cursor: pointer;
}

.detail {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  align-items: center;
  padding-bottom: 1rem;
}

.detail p {
  margin: 0;
  max-width: 65ch;
}

.colophon {
  margin-top: 2.5rem;
  padding-block: 0.75rem;
  border-top: 1px solid var(--rule);
  color: var(--muted);
  font-size: 0.875rem;
}

.colophon p {
  max-width: 65ch;
}

.links {
  display: flex;
  flex-wrap: wrap;
  gap: 0 1.25rem;
}

/* Forced colours paint over the palette: keep the primary action and the error visible. */
@media (forced-colors: active) {
  .primary {
    border: 2px solid ButtonText;
  }
  .error {
    text-decoration: underline;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    /* biome-ignore lint/complexity/noImportantStyles: reduced motion must override every transition. */
    transition: none !important;
  }
}
