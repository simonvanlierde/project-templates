{
  "name": "{{ slug }}-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@{{ pnpm_version }}",
  "engines": {
    "node": ">={{ node_version }}"
  },
  "scripts": {
    "build": "astro build",
{%- if license != 'none' %}
    "licenses": "pnpm licenses list --prod --json | node scripts/checkLicenses.mjs",
{%- endif %}
    "dev": "astro dev"
  },
  "devDependencies": {
{#- Astro builds static files; it does not ship with them. Exact: copier.yml pins it, and Renovate bumps it there and in each project. #}
    "astro": "{{ astro_version }}"
  }
}
