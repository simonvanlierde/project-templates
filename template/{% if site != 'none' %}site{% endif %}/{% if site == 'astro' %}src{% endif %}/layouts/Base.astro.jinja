---
{%- set repo = 'https://github.com/' ~ github_user ~ '/' ~ slug %}
// The page skeleton every page shares: a compact header, the page in <main>, and a
// footer with the licence and the privacy line. A Markdown page passes its frontmatter,
// and its title becomes the page's heading.
const name = {{ project_name | to_json }};
const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? Astro.props.title;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const repo = "{{ repo }}";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title ? `${title} · ${name}` : name}</title>
{%- if project_description %}
    <meta name="description" content={{ project_description | to_json }} />
{%- endif %}
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="wrap">
      <p><a href={base}><b>{name}</b></a></p>
      <nav aria-label="Site">
        <a href={`${base}about/`}>About</a>
        <a href={`${repo}#readme`}>Docs</a>
      </nav>
    </header>
    <main id="main" class="wrap" tabindex="-1">
      {frontmatter?.title && <h1>{frontmatter.title}</h1>}
      <slot />
    </main>
    <footer class="wrap">
      <p>This site sets no cookies and stores nothing in your browser. Its host keeps the usual server logs.</p>
      <p class="links">
{%- if license != 'none' %}
        <a href={`${repo}/blob/main/LICENSE`}>{{ license }}</a>
{%- endif %}
        <a href={repo}>Source</a>
        <a href={`${repo}/issues`}>Report a problem</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fbfaf6;
    --fg: #1d1f1c;
    --muted: #5b5f58;
    --line: #d8d6cf;
    --link: #1f5fa8;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #181a17;
      --fg: #e8e6df;
      --muted: #a6a99f;
      --line: #3a3d37;
      --link: #8cb8ee;
    }
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
  }

  a {
    color: var(--link);
  }

  :focus-visible {
    outline: 3px solid var(--link);
    outline-offset: 2px;
  }

  .wrap {
    box-sizing: border-box;
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  header,
  nav,
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    align-items: center;
  }

  header {
    justify-content: space-between;
  }

  footer {
    margin-top: 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  /* Link targets at least 44px tall. */
  header a,
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .skip {
    position: absolute;
    left: -100vw;
  }

  .skip:focus {
    position: static;
  }
</style>
