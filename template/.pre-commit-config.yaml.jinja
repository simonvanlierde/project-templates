{#- Hooks run from the repo root with repo-root-relative filenames, so point each
    tool at a nested package instead of cd-ing into it. --project keeps the cwd so
    filenames still resolve. --directory moves it, so use it only where the hook
    passes no filenames. Both render bare at '.'. -#}
{%- set uv_project = 'uv run --frozen' if python_dir == '.' else 'uv run --frozen --project ' ~ python_dir %}
{%- set uv_cd = 'uv run --frozen' if python_dir == '.' else 'uv run --frozen --directory ' ~ python_dir %}
{%- set pnpm = 'pnpm' if ts_dir == '.' else 'pnpm -C ' ~ ts_dir %}
{%- set mp = '' if rust_dir == '.' else ' --manifest-path ' ~ rust_dir ~ '/Cargo.toml' %}
{#- golangci-lint fmt takes a path. run loads packages from the cwd's module and
    has no flag to name another, so it is the one hook that cds into a nested module. #}
{%- set go_fmt = 'golangci-lint fmt' if go_dir == '.' else 'golangci-lint fmt ' ~ go_dir %}
{%- set go_run = 'golangci-lint run' if go_dir == '.' else "sh -c 'cd " ~ go_dir ~ " && exec golangci-lint run'" -%}
# Run with prek, a drop-in pre-commit replacement: prek install && prek run -a
#
# Python projects get prek from `uv tool install prek`. TypeScript-only projects
# get it from the @j178/prek devDependency. Revs are commit SHAs, since tags are
# mutable; the dependency bot moves each SHA and its `# frozen:` tag together.

# `prek install` sets up each of these: the commit message is checked as you commit{% if 'ts' in stacks and ts_kind == 'web-app' %},
# and the unit tests run before each push{% endif %}.
default_install_hook_types: [pre-commit, commit-msg{% if 'ts' in stacks and ts_kind == 'web-app' %}, pre-push{% endif %}]
{%- if 'python' in stacks %}

# data/ holds inputs: the whitespace, end-of-file and notebook hooks must not rewrite them.
# Excluded per hook, so the secret scan and the large-file check still cover data/.
{%- set data_exclude = '^' ~ ('' if python_dir == '.' else python_dir ~ '/') ~ 'data/' %}
{%- endif %}
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: 3e8a8703264a2f4a69428a0aa4dcb512790b2c8c # frozen: v6.0.0
    hooks:
      - id: check-added-large-files
      - id: check-merge-conflict
      - id: check-yaml
        # pnpm writes its own version into the lockfile as a second YAML document.
        exclude: (^|/)pnpm-lock\.yaml$
      - id: end-of-file-fixer
{%- if 'python' in stacks %}
        exclude: {{ data_exclude }}
{%- endif %}
      - id: mixed-line-ending
{%- if 'python' in stacks %}
        exclude: {{ data_exclude }}
{%- endif %}
      - id: trailing-whitespace
{%- if 'python' in stacks %}
        exclude: {{ data_exclude }}
{%- endif %}
      # Not gated to python: .rumdl.toml ships to every stack.
      - id: check-toml

  # Commit messages follow committed.toml: Conventional Commits, imperative, no period.
  - repo: https://github.com/crate-ci/committed
    rev: faeed42f2e10c244533a01525f13c4d8b6ce383f # frozen: v1.1.11
    hooks:
      - id: committed
        # git writes a merge commit's message itself, so skip the check during a merge.
        entry: sh -c 'test -f "$(git rev-parse --git-path MERGE_HEAD)" || exec committed "$@"' --
{%- if public and license != 'none' and openssf_badge == 'silver' %}

  # The dco workflow fails a pull request with an unsigned commit, so refuse one here. Merge
  # commits are skipped, as the workflow skips them.
  - repo: local
    hooks:
      - id: dco-signoff
        name: commit message has a Signed-off-by line (git commit -s)
        entry: sh -c 'test -f "$(git rev-parse --git-path MERGE_HEAD)" || grep -qE "^Signed-off-by:[ ].+ <[^>]+>[[:space:]]*$" "$1"' --
        language: system
        stages: [commit-msg]
{%- endif %}
{%- if license != 'none' %}

  # Every file has a copyright and license, from REUSE.toml or its own header.
  - repo: https://github.com/fsfe/reuse-tool
    rev: a1bb792acda6fd0724936b4ebbdbc8eceb9c0459 # frozen: v6.2.0
    hooks:
      - id: reuse
{%- endif %}

  # Not gated to ts: .vscode/ and .github/rulesets/ JSON ship to every stack.
  # .json files are read as JSON5, so comments and trailing commas in tsconfig
  # and VS Code settings pass; syntax errors and duplicate keys fail.
  - repo: https://github.com/simonvanlierde/jsonvet
    rev: 022d320d5b971eccb28cfa6ce205152cbb382e53 # frozen: v3.2.0
    hooks:
      - id: jsonvet

  # Formats first, so yamllint below sees the formatted file.
  - repo: https://github.com/google/yamlfmt
    rev: 21ca5323a9c87ee37a434e0ca908efc0a89daa07 # frozen: v0.21.0
    hooks:
      - id: yamlfmt

  - repo: https://github.com/adrienverge/yamllint
    rev: cba56bcde1fdd01c1deb3f945e69764c291a6530 # frozen: v1.38.0
    hooks:
      - id: yamllint

  # gitleaks' successor from the same authors. gitleaks takes security fixes only.
  - repo: https://github.com/betterleaks/betterleaks
    rev: 81aff7a638638aae3a659845d089043e1d8fe9ac # frozen: v1.9.0
    hooks:
      - id: betterleaks

  # Audits .github/ for template injection, credential leakage, cache poisoning
  # and impostor commits. Set GH_TOKEN to enable the audits that need the API;
  # without it only the offline subset runs.
  - repo: https://github.com/zizmorcore/zizmor-pre-commit
    rev: c92afdf2c6ca336aaa8f39e2bd8d48f62dbd8e1f # frozen: v1.31.1
    hooks:
      - id: zizmor

  # Checks what zizmor doesn't: unknown keys, bad `needs`, expression type errors,
  # and shellcheck over every `run:` when shellcheck is on PATH. jactionlint is a
  # maintained fork of actionlint that adds release, cache and concurrency checks.
  - repo: https://github.com/jdx/jactionlint
    rev: a65ab044e916760429068fe5794b8306abdfcbb9 # frozen: v2.3.0
    hooks:
      - id: jactionlint
{%- if 'docker' in stacks %}

  # Runs from its own image: nothing to install, but it needs the Docker daemon.
  - repo: https://github.com/hadolint/hadolint
    rev: 2eece55955ced00200be9729e9728cb7dacca505 # frozen: v2.15.1
    hooks:
      - id: hadolint-docker
{%- endif %}
{%- if citable %}

  # CITATION.cff against the official schema. GitHub's "Cite this repository"
  # silently drops a file that fails it.
  - repo: https://github.com/python-jsonschema/check-jsonschema
    rev: 0494aa7fa1314e98913a41227d8f0a515b2c1049 # frozen: 0.38.2
    hooks:
      - id: check-citation-file-format

  # CITATION.cff is the source: codemeta.json, any .zenodo.json and the package manifests
  # must agree with it. `just citation` runs the manual-stage writer to fix them.
  - repo: https://github.com/simonvanlierde/citesync
    rev: a3c5a9794449e78a33583e456af41bb24ebd240e # frozen: v0.1.0
    hooks:
      - id: citesync
      - id: citesync-write
{%- endif %}
{%- if 'python' in stacks %}

  - repo: https://github.com/kynan/nbstripout
    rev: 34071b78c181af3bf5af955c1426466e096fc3db # frozen: 0.9.1
    hooks:
      - id: nbstripout
        exclude: {{ data_exclude }}
{%- endif %}
  - repo: https://github.com/rvben/rumdl-pre-commit
    rev: 03a7d1a4936b5889602852175bca2d39acb3281e # frozen: v0.3.0
    hooks:
      - id: rumdl
        args: [--fix]

  # Misspelt words in code, comments and docs. It fixes the ones it is sure of and
  # fails, so you review the fix. List a word it must leave alone in _typos.toml.
  - repo: https://github.com/crate-ci/typos
    rev: 7f9d0819ca1c008ade73f4b41fa9d258d48f605b # frozen: v1.51.1
    hooks:
      - id: typos
        # Copier writes the template's commit id here, and a hex id can spell a word
        # typos rejects.
        exclude: ^\.copier-answers\.yml$

  # Dead relative links in Markdown and HTML. Offline, so a commit never waits on the
  # network: the weekly links.yml checks the web links. lychee's own hook installs its
  # binary with an unpinned install script, so this takes upstream's wheel from PyPI
  # at an exact version instead.
  - repo: local
    hooks:
      - id: lychee
        name: lychee --offline
        entry: lychee --no-progress --offline
        language: python
        additional_dependencies: [lychee-bin==0.24.2]
        types_or: [markdown, html]
        require_serial: true
{%- if 'python' in stacks or 'ts' in stacks or 'rust' in stacks or 'go' in stacks %}

  - repo: local
    hooks:
{%- endif %}
{%- if 'python' in stacks %}
      # Runs from the project's venv, not the ruff-pre-commit mirror, so it uses the
      # same ruff as CI. --force-exclude keeps ruff's excludes when the hook passes
      # explicit filenames.
      - id: ruff-check
        name: ruff check
        entry: {{ uv_project }} ruff check --fix --force-exclude
        language: system
        types_or: [python, pyi, jupyter]
        require_serial: true

      - id: ruff-format
        name: ruff format
        entry: {{ uv_project }} ruff format --force-exclude
        language: system
        types_or: [python, pyi, jupyter]
        require_serial: true

      - id: ty
        name: ty check
        entry: {{ uv_cd }} ty check
        language: system
        pass_filenames: false
        types: [python]
{%- endif %}
{%- if 'ts' in stacks %}
      - id: biome
        name: biome check
{%- if ts_dir == '.' %}
        entry: pnpm exec biome check --write --no-errors-on-unmatched
{%- else %}
        # biome has no --project, and pnpm -C moves the cwd away from repo-root-relative
        # paths, so check the whole package.
        entry: {{ pnpm }} exec biome check --write --no-errors-on-unmatched
        pass_filenames: false
{%- endif %}
        language: system
        types_or: [javascript, jsx, ts, tsx, json, css, html]

      - id: tsc
        name: tsc --noEmit
        entry: {{ pnpm }} exec tsc --noEmit
        language: system
        pass_filenames: false
        types_or: [ts, tsx]
{%- if ts_kind == 'web-app' %}

      # Before a push, not each commit: the unit tests take longer than a lint.
      - id: vitest
        name: vitest run
        entry: {{ pnpm }} exec vitest run
        language: system
        pass_filenames: false
        types_or: [javascript, jsx, ts, tsx, css]
        stages: [pre-push]
{%- endif %}
{%- endif %}
{%- if 'rust' in stacks %}
      # cargo takes no file list: both hooks work on the whole crate.
      - id: cargo-fmt
        name: cargo fmt
        entry: cargo fmt{{ mp }}
        language: system
        pass_filenames: false
        types: [rust]

      - id: cargo-clippy
        name: cargo clippy
        entry: cargo clippy{{ mp }} --all-targets --all-features -- -D warnings
        language: system
        pass_filenames: false
        types: [rust]
{%- endif %}
{%- if 'go' in stacks %}
      # Both work on the whole module, with the policy in .golangci.yml.
      - id: golangci-lint-fmt
        name: golangci-lint fmt
        entry: {{ go_fmt }}
        language: system
        pass_filenames: false
        types: [go]

      - id: golangci-lint
        name: golangci-lint run
        entry: {{ go_run }}
        language: system
        pass_filenames: false
        types: [go]
{%- endif %}
