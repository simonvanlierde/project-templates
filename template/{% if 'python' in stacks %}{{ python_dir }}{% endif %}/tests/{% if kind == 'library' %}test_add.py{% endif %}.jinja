@given(st.integers(), st.integers())
def test_order_does_not_matter(left: int, right: int) -> None:
    """Hypothesis tries many pairs, and shrinks any that fails to the simplest one."""
    assert add(left, right) == add(right, left)


@given(st.integers())
def test_zero_changes_nothing(value: int) -> None:
    """Adding zero is the identity."""
    assert add(value, 0) == value
