"""Tests the app in process, and its telemetry in a child process."""

import os
import socket
import subprocess
import sys
import time
from contextlib import closing
from http.client import HTTPConnection
from typing import TYPE_CHECKING

import pytest
from fastapi.testclient import TestClient

from {{ module_name }}.__main__ import start_telemetry
from {{ module_name }}.app import app

if TYPE_CHECKING:
    from pathlib import Path


def test_health() -> None:
    """/health answers 200 with a fixed body."""
    with TestClient(app) as client:
        response = client.get("/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}


def test_unknown_path_is_404() -> None:
    """Anything else is a 404, the API docs included while API_DOCS is unset."""
    with TestClient(app) as client:
        for path in ("/nope", "/docs", "/openapi.json"):
            assert client.get(path).status_code == 404


@pytest.mark.parametrize("endpoint", [None, ""])
def test_telemetry_is_off_without_an_endpoint(monkeypatch: pytest.MonkeyPatch, endpoint: str | None) -> None:
    """No endpoint, or an empty one: telemetry stays off."""
    if endpoint is None:
        monkeypatch.delenv("OTEL_EXPORTER_OTLP_ENDPOINT", raising=False)
    else:
        monkeypatch.setenv("OTEL_EXPORTER_OTLP_ENDPOINT", endpoint)
    assert not start_telemetry()


# Instrumenting patches FastAPI for the rest of the process, so this runs in a child.
# Console exporters stand in for the collector. The endpoint only switches telemetry on.
CHILD = """
from {{ module_name }}.__main__ import start_telemetry
assert start_telemetry()
from fastapi.testclient import TestClient
from {{ module_name }}.app import app
assert TestClient(app).get("/health").status_code == 200
"""


def test_telemetry_records_a_span_and_the_request_duration() -> None:
    """With an endpoint, a request leaves a span and a duration histogram point."""
    env = os.environ | {
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:9",
        "OTEL_RESOURCE_ATTRIBUTES": "project={{ slug }},env=dev",
        "OTEL_TRACES_EXPORTER": "console",
        "OTEL_METRICS_EXPORTER": "console",
        "OTEL_LOGS_EXPORTER": "none",
    }
    child = subprocess.run(  # noqa: S603
        [sys.executable, "-c", CHILD], env=env, capture_output=True, text=True, check=True, timeout=60
    )
    assert '"name": "GET /health"' in child.stdout
    assert '"project": "{{ slug }}"' in child.stdout
    assert '"env": "dev"' in child.stdout
    # The stable semantic-convention name, or the older one, depending on
    # OTEL_SEMCONV_STABILITY_OPT_IN.
    assert "http.server.request.duration" in child.stdout or "http.server.duration" in child.stdout


@pytest.mark.skipif(sys.platform == "win32", reason="Windows terminate() does not send SIGTERM")
def test_unavailable_collector_keeps_serving_and_stops_on_sigterm(tmp_path: Path) -> None:
    """A real OTLP HTTP export failure neither stops requests nor blocks SIGTERM."""
    # Binding without listening reserves an endpoint that refuses every connection.
    with socket.socket() as collector, socket.socket() as address:
        collector.bind(("127.0.0.1", 0))
        address.bind(("127.0.0.1", 0))
        port = address.getsockname()[1]
        address.close()
        env = {key: value for key, value in os.environ.items() if not key.startswith("OTEL_")}
        env.update(
            {
                "HOST": "127.0.0.1",
                "PORT": str(port),
                "NO_PROXY": "127.0.0.1",
                "no_proxy": "127.0.0.1",
                "OTEL_EXPORTER_OTLP_ENDPOINT": f"http://127.0.0.1:{collector.getsockname()[1]}",
                "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
                "OTEL_EXPORTER_OTLP_TIMEOUT": "1",
                "OTEL_BSP_SCHEDULE_DELAY": "10",
                "OTEL_TRACES_EXPORTER": "otlp",
                "OTEL_METRICS_EXPORTER": "none",
                "OTEL_LOGS_EXPORTER": "none",
            }
        )
        log_path = tmp_path / "server.log"
        with log_path.open("w", encoding="utf-8") as log:
            child = subprocess.Popen([sys.executable, "-m", "{{ module_name }}"], env=env, stdout=log, stderr=log)
            try:
                deadline = time.monotonic() + 20
                while True:
                    assert child.poll() is None, log_path.read_text(encoding="utf-8")
                    try:
                        with closing(HTTPConnection("127.0.0.1", port, timeout=1)) as client:
                            client.request("GET", "/health")
                            response = client.getresponse()
                            assert response.status == 200
                            assert response.read() == b'{"status":"ok"}'
                    except OSError:
                        pass
                    output = log_path.read_text(encoding="utf-8")
                    if "/v1/traces" in output and "Connection refused" in output:
                        break
                    assert time.monotonic() < deadline, output
                    time.sleep(0.05)
                # The request after the real export failure must still succeed.
                with closing(HTTPConnection("127.0.0.1", port, timeout=1)) as client:
                    client.request("GET", "/health")
                    assert client.getresponse().status == 200
                child.terminate()
                child.wait(timeout=5)
            finally:
                if child.poll() is None:
                    child.kill()
                child.wait(timeout=5)
