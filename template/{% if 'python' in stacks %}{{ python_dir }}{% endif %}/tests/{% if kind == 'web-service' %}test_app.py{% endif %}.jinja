"""The app in process; its telemetry in a child process."""

import os
import subprocess
import sys

import pytest
from fastapi.testclient import TestClient

from {{ module_name }}.__main__ import start_telemetry
from {{ module_name }}.app import app


def test_health() -> None:
    """/health answers 200 with a fixed body."""
    with TestClient(app) as client:
        response = client.get("/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}


def test_title_is_the_project_name() -> None:
    """The OpenAPI title is the project name exactly, quotes included."""
    assert app.title == {{ project_name | pprint if '"' in project_name and "'" not in project_name else project_name | to_json }}


def test_unknown_path_is_404() -> None:
    """Anything else is a 404."""
    with TestClient(app) as client:
        assert client.get("/nope").status_code == 404


@pytest.mark.parametrize("endpoint", [None, ""])
def test_telemetry_is_off_without_an_endpoint(monkeypatch: pytest.MonkeyPatch, endpoint: str | None) -> None:
    """No endpoint, or an empty one: telemetry stays off."""
    if endpoint is None:
        monkeypatch.delenv("OTEL_EXPORTER_OTLP_ENDPOINT", raising=False)
    else:
        monkeypatch.setenv("OTEL_EXPORTER_OTLP_ENDPOINT", endpoint)
    assert not start_telemetry()


# Instrumenting patches FastAPI for the rest of the process, so this runs in a child.
# Console exporters stand in for the collector; the endpoint only switches telemetry on.
CHILD = """
from {{ module_name }}.__main__ import start_telemetry
assert start_telemetry()
from fastapi.testclient import TestClient
from {{ module_name }}.app import app
assert TestClient(app).get("/health").status_code == 200
"""


def test_telemetry_records_a_span_and_the_request_duration() -> None:
    """With an endpoint, a request leaves a span and a duration histogram point."""
    env = os.environ | {
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:9",
        "OTEL_TRACES_EXPORTER": "console",
        "OTEL_METRICS_EXPORTER": "console",
        "OTEL_LOGS_EXPORTER": "none",
    }
    child = subprocess.run(  # noqa: S603
        [sys.executable, "-c", CHILD], env=env, capture_output=True, text=True, check=True, timeout=60
    )
    assert '"name": "GET /health"' in child.stdout
    # The stable semantic-convention name, or the older one, depending on
    # OTEL_SEMCONV_STABILITY_OPT_IN.
    assert "http.server.request.duration" in child.stdout or "http.server.duration" in child.stdout
