"""Hypothesis profiles. `just py-property` runs the tests under the long one."""

from hypothesis import settings

# A new profile copies the loaded one, which in CI is Hypothesis's derandomized "ci"
# profile. derandomize=False makes each weekly run draw new inputs. print_blob prints
# how to replay a failure.
settings.register_profile("long", max_examples=10_000, derandomize=False, print_blob=True)
