"""The FastAPI application."""

import os

from fastapi import FastAPI

# /docs, /redoc and /openapi.json list every route to anyone who asks, so they are off
# unless API_DOCS is set (to anything), e.g. for local development.
app = FastAPI(title={{ title }}, openapi_url="/openapi.json" if os.environ.get("API_DOCS") else None)


@app.get("/health")
def health() -> dict[str, str]:
    """Liveness: the process answers. The image's HEALTHCHECK probes this."""
    # Unauthenticated: no version, config or environment in the body.
    return {"status": "ok"}
