"""Fetch, build and validate the sources declared in sources.toml.

The stages come from sourceledger: each download gets a fetch record, and every output
row names the bytes it came from (see https://github.com/simonvanlierde/sourceledger).
What is this project's own is `parse`, which reads each raw file.
"""

from __future__ import annotations

import sourceledger
from sourceledger import Source


def parse(source: Source, payload: bytes) -> tuple[list[str], list[dict[str, str]]]:
    """One raw file as its columns and rows.

    Every source is read as CSV here. Branch on `source["id"]` for a source that is not.
    """
    return sourceledger.parse_csv(source, payload)


def main(argv: list[str] | None = None) -> int:
    """Run one stage: `{{ slug }} fetch|build|validate`, or `revisions <older fetch log>`."""
    return sourceledger.main(argv, parse=parse, prog="{{ slug }}", user_agent="{{ slug }}")


if __name__ == "__main__":
    raise SystemExit(main())
