{#- `readme` and `license-files` resolve against this file's directory and cannot
    escape it. A nested package therefore gets its own README and drops
    license-files instead of pointing at an unreachable LICENSE. The SPDX
    expression below still records the license. -#}
[project]
name = "{{ slug }}"
version = "0.1.0"
description = {{ project_description | to_json }}
readme = "README.md"
requires-python = ">={{ python_min if python_kind == 'library' else python_version }}"
authors = [{ name = {{ author_name | to_json }}, email = {{ author_email | to_json }} }]
{%- if license != 'none' %}
license = "{{ license }}"
{%- if python_dir == '.' %}
license-files = ["LICENSE"]
{%- endif %}
{%- endif %}
{%- if python_kind == 'web-service' %}
dependencies = [
  "fastapi>=0.162.0",
  "opentelemetry-distro>=0.65b0",
  "opentelemetry-exporter-otlp-proto-http>=1.45.1",
  "opentelemetry-instrumentation-fastapi>=0.65b0",
  # FastAPI allows older Starlette; 1.2.0 is the first whose TestClient takes httpx2.
  "starlette>=1.10.0",
  "uvicorn>=0.54.0",
]
{%- elif python_kind == 'data-pipeline' %}
# Parquet outputs. Add the `xlsx` extra to read Excel sources.
dependencies = [
  "sourceledger[parquet]>=0.5.0",
]
{%- else %}
dependencies = []
{%- endif %}
{%- if publish_to_pypi %}
{%- set py_min = (python_min if python_min is defined and python_min else python_version).split('.')[1] | int %}
{%- set py_max = (python_version if python_version is defined and python_version else '3.14').split('.')[1] | int %}
keywords = [] # citesync compares this list to keywords in CITATION.cff
classifiers = [
  "Development Status :: 3 - Alpha",
  "Programming Language :: Python :: 3",
{%- for m in range(py_min, [py_max, py_min] | max + 1) %}
  "Programming Language :: Python :: 3.{{ m }}",
{%- endfor %}
{%- if python_kind == 'library' %}
  "Typing :: Typed",
{%- endif %}
]
{%- else %}
# PyPI rejects unknown classifiers, so this one blocks an accidental upload.
# Delete it (and set publish_to_pypi) to publish.
classifiers = ["Private :: Do Not Upload"]
{%- endif %}
{% if python_kind == 'data-pipeline' %}
# `{{ slug }} fetch|build|validate`, what the `just` recipes of the same names run.
[project.scripts]
{{ slug | to_json }} = "{{ module_name }}.pipeline:entry"
{% endif %}{% if python_kind == 'web-service' %}
# `{{ slug }}` serves on HOST:PORT, as `python -m {{ module_name }}` does in the image.
[project.scripts]
{{ slug | to_json }} = "{{ module_name }}.__main__:main"
{% endif %}{% if python_kind == 'library' or publish_to_pypi %}
[project.urls]
Homepage = "https://github.com/{{ github_user }}/{{ slug }}"
Issues = "https://github.com/{{ github_user }}/{{ slug }}/issues"
{%- if publish_to_pypi %}
Changelog = "https://github.com/{{ github_user }}/{{ slug }}/blob/main/CHANGELOG.md"
{%- endif %}
{% endif %}
[dependency-groups]
dev = [
  "pytest>=9.2.0",
{%- if codspeed %}
  "pytest-codspeed>=5.0.3",
{%- endif %}
  "pytest-cov>=7.1.0",
  "ruff>=0.17.3",
  "ty>=0.0.93",
{%- if python_kind == 'research' %}
  "jupyterlab>=4.6.4",
{%- endif %}
{%- if python_kind == 'web-service' %}
  "httpx2>=2.16.0", # fastapi.testclient
{%- endif %}
{%- if python_kind == 'library' and 'property' in test_extras %}
  "hypothesis>=6.170.13",
{%- endif %}
{%- if python_kind == 'library' and 'mutation' in test_extras %}
  "mutmut>=3.8.1",
{%- endif %}
]

{% if python_kind == 'data-pipeline' -%}
# Packaged, so the `{{ slug }}` script and the tests import `{{ module_name }}`
# without sys.path edits.
{% elif python_kind == 'research' -%}
# Research projects are packaged too, so notebooks can `import {{ module_name }}`
# without sys.path edits.
{% endif -%}
[build-system]
requires = ["uv_build>=0.12.19,<0.14.0"]
build-backend = "uv_build"

# Resolve only releases at least a week old: a compromised release is usually
# caught and yanked within that window. The dependency bot waits the same week.
# Set here, not user-wide, so every machine writes the same uv.lock.
[tool.uv]
exclude-newer = "1 week"
{%- if python_kind == 'research' %}
# TODO: remove after 2026-11-16: Tornado 6.6.1 then clears the one-week release window.
override-dependencies = ["tornado @ https://github.com/tornadoweb/tornado/archive/c1adc39faea87d87d99421529aa06cdd3d39f660.tar.gz"]
{%- endif %}
{%- if python_kind == 'data-pipeline' %}
# sourceledger is released with this template, and a template release can need its newest
# version on the day it ships.
exclude-newer-package = { sourceledger = false }
{%- endif %}

# uv_build derives the package dir from the normalized project.name, so pin it
# for a module_name that differs.
[tool.uv.build-backend]
module-name = "{{ module_name }}"
{%- if python_layout == 'flat' %}
# The package sits at the root, not under src/.
module-root = ""
{%- endif %}
{%- if python_layout == 'flat' and python_kind == 'library' and 'mutation' in test_extras %}

# mutmut otherwise guesses lib/, src/ or the directory name, and fails on a flat package.
[tool.mutmut]
source_paths = ["{{ module_name }}"]
{%- endif %}

# NOTE: self-contained ruff config, deliberately not extended from any shared base.
# No target-version: ruff derives it from requires-python above.
[tool.ruff]
line-length = 120

[tool.ruff.format]
docstring-code-format = true

[tool.ruff.lint]
select = ["ALL"]
ignore = [
  "ANN204", # missing-return-type-special-method
  "COM812", # trailing-comma-missing: conflicts with the formatter
  "CPY001", # missing copyright notice
  "D105",   # undocumented-magic-method
  "D107",   # undocumented-public-init
  "TD002",  # missing-todo-author: a plain `# TODO:` is enough
  "TD003",  # missing-todo-link
]

# Tests assert, use literal expectations, and need no docstrings, return
# annotations, or package __init__.py.
[tool.ruff.lint.per-file-ignores]
"**/tests/**" = ["S101", "D1", "INP001", "PLR2004", "ANN201"]
{%- if python_kind == 'research' %}
"*.ipynb" = ["T201", "E402"] # notebooks print and import late
{%- endif %}

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.pylint]
allow-magic-value-types = ["int"]
max-args = 10

# A rule set to "warn" reports without failing: ty otherwise exits 1 on warnings too.
[tool.ty.terminal]
error-on-warning = false

# pytest 9's native table. strict turns unknown config keys, unknown markers and
# an xfail test that passes into errors, and filterwarnings turns warnings into
# failures, so a deprecation shows up in CI, not after the upgrade that removes it.
[tool.pytest]
minversion = "9.0"
addopts = ["-ra", "--import-mode=importlib"]
testpaths = ["tests"]
strict = true
filterwarnings = ["error"]
log_level = "INFO"

# Coverage is opt-in via `pytest --cov` (`just py-cov`), not addopts, because it
# slows every plain test run. No fail_under until there is a suite worth setting
# one against.
[tool.coverage.run]
source = ["{{ 'src' if python_layout == 'src' else module_name }}"]
branch = true

[tool.coverage.report]
show_missing = true
exclude_also = ["if TYPE_CHECKING:", "raise NotImplementedError"]

# Checks from Scientific Python's repo-review (the sp-repo-review git hook) that this
# project skips on purpose. `prek run sp-repo-review --all-files` runs the rest.
[tool.repo-review.ignore]
PY007 = "just is the task runner: `just check` runs what CI runs"
PC110 = "ruff format runs as a local hook from the venv, the same ruff CI runs"
PC140 = "ty runs as a local hook from the venv"
PC170 = "no reStructuredText: rumdl checks the Markdown docs"
PC190 = "ruff check runs as a local hook from the venv"
PC901 = "the hooks run in CI's checks workflow, not on pre-commit.ci"
PC902 = "the hooks run in CI's checks workflow, not on pre-commit.ci"
PC903 = "the hooks run in CI's checks workflow, not on pre-commit.ci"
{%- if license == 'none' %}
PY003 = "no license yet (license=none)"
{%- elif python_dir != '.' %}
PY003 = "LICENSE sits at the repo root, out of reach of license-files (see the top of this file)"
{%- endif %}
{%- if python_dir != '.' %}
PY004 = "docs/ sits at the repo root"
{%- endif %}
{%- if dependency_bot == 'dependabot' %}
GH212 = "dependabot.yml groups the actions with the hook revs under multi-ecosystem-groups, which this check does not read"
{%- elif dependency_bot == 'renovate' %}
GH200 = "Renovate updates the actions and hook revs (renovate.json5)"
{%- endif %}
