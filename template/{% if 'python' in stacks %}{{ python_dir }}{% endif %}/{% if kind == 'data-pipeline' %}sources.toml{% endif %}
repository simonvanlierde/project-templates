#:schema https://raw.githubusercontent.com/simonvanlierde/sourceledger/main/src/sourceledger/sources.schema.json

# Input manifest: every source this pipeline reads, declared before any code reads it.
#
# `just fetch` downloads each `implemented` source to data/raw/, `just build` turns
# it into data/processed/<id>.csv, and `just validate` checks what was published.
#
# Keep each `url` a small cut of its source (one series, a few years, a filtered API
# query). CI runs the whole pipeline against these URLs on every push.
#
# Per source:
#   id         ASCII letters, digits, `_` and `-`; names the raw file (<id> plus the URL's extension) and the output
#   status     "implemented", or "unimplemented" plus a `reason`: a source you know
#              about but do not read yet. It stays out of the output by design, and
#              `just validate` fails if it ever produces any.
#   url        what `just fetch` downloads. Change it and `just build` refuses the old
#              download until you fetch again.
#   vintage    optional: the edition you expect, recorded with each fetch and stamped
#              on each output row
#   sha256     optional: the SHA-256 the download must have. Pin it for a fixed release
#              and `just fetch` refuses bytes that changed upstream. Leave it out for a
#              URL that tracks a moving source.
#   max_bytes  optional: the largest download `just fetch` accepts, 200 MiB unless set.
#              Raise it for a source that is bigger than that on purpose.
#   format     optional: "csv", "json" (an array of objects) or "xlsx" (needs the
#              `sourceledger[xlsx]` extra). Otherwise from the URL's extension. A
#              gzipped CSV or JSON file is decompressed.
#   sheet      optional: the Excel sheet to read, the first unless set.
#   headers    optional: request headers such as an API key, each value naming an
#              environment variable: { Authorization = "env:API_TOKEN" }. A literal
#              value is refused, so no secret lands in this file.
#   terms      the publisher's reuse terms, in their words, plus `terms_url`. Required
#              for every implemented source, and listed again in ATTRIBUTION.md.
#   license    the same terms as an SPDX id (https://spdx.org/licenses/), such as
#              "CC-BY-4.0", or "LicenseRef-<name>" for terms with no SPDX id. Required.
#   redistribute  true if the terms let you republish the raw file, false if not, so
#              a later release step knows what it may ship. Required.

# EXAMPLE: replace with your own sources. Mauna Loa annual mean CO2, as repackaged
# by the Frictionless Data `datasets` project. About 1 kB.
[[source]]
id = "example-co2"
name = "Mauna Loa CO2 annual mean (EXAMPLE)"
status = "implemented"
url = "https://raw.githubusercontent.com/datasets/co2-ppm/main/data/co2-annmean-mlo.csv"
vintage = "unversioned, main branch"
terms = "ODC-PDDL-1.0 (datasets/co2-ppm package; original data from NOAA GML)"
terms_url = "https://opendatacommons.org/licenses/pddl/"
license = "PDDL-1.0"
redistribute = true

# EXAMPLE: a source you know about but do not read yet.
[[source]]
id = "example-later"
name = "A second source (EXAMPLE)"
status = "unimplemented"
reason = "No reader written yet."
