/**
 * Entrypoint for the container image.
 *
 * Serves the /health endpoint the Dockerfile's HEALTHCHECK probes, so
 * `docker run` works before you write anything. Replace the handler
 * with your real application.
 */
import { createServer } from "node:http";

const PORT = {{ app_port }};

const server = createServer((req, res) => {
  if (req.url === "/health") {
    res.writeHead(200, { "Content-Type": "application/json" });
    res.end('{"status":"ok"}');
    return;
  }
  res.writeHead(404);
  res.end("not found");
}).listen(PORT);

// PID 1 ignores SIGTERM unless a handler is set, so without this `docker stop` waits
// 10 s and then kills the process.
process.on("SIGTERM", () => server.close(() => process.exit(0)));
