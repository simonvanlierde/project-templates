# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
#
# Follows https://pnpm.io/docker, in particular its prod-deps / build stage
# split: pnpm builds the production node_modules instead of pruning it afterwards.
#
# One deviation: that page installs pnpm with `corepack enable`, which Node
# stopped shipping in v25. `npm i -g pnpm@<version>` replaces it, pinned to the
# `packageManager` version in package.json. Renovate bumps both together.

# ---- base -------------------------------------------------------------------
FROM node:{{ node_version }}-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="/pnpm/bin:$PATH"
ENV CI=1
RUN npm i -g pnpm@12.8.1

WORKDIR /app

# Manifests only: prod-deps and build both start here, so their install layers
# stay cached until the lockfile changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# ---- production dependencies ------------------------------------------------
FROM base AS prod-deps
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --prod --frozen-lockfile

# ---- build ------------------------------------------------------------------
FROM base AS build
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

# ---- runtime ----------------------------------------------------------------
# Plain node, not `base`: the final image needs no pnpm.
FROM node:{{ node_version }}-slim AS runtime

LABEL org.opencontainers.image.source="https://github.com/{{ github_user }}/{{ slug }}" \
      org.opencontainers.image.description={{ project_description | to_json }} \
{%- if license != 'none' %}
      org.opencontainers.image.licenses="{{ license }}" \
{%- endif %}
      org.opencontainers.image.title={{ project_name | to_json }}

ENV NODE_ENV=production
WORKDIR /app

# The node images already ship an unprivileged `node` user (uid 1000).
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/package.json ./

# The node image's own user, by uid, so it holds where the host has no user named node.
USER 1000:1000
EXPOSE {{ app_port }}

# NOTE: assumes an HTTP GET /health returning 200. Drop this if the image is not a service.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:{{ app_port }}/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["node", "dist/main.js"]
