# Keep the build context small: everything here is rebuilt in the image,
# irrelevant to it, or a secret. Each image has its own file next to its
# Dockerfile, because Docker reads it from the root of the build context.

# VCS / tooling metadata
.git
.github
.copier-answers.yml

# Rebuilt inside the image
node_modules
dist

# Test, lint, and cache artifacts
coverage
*.tsbuildinfo

# Left out of the image. With `COPY . .` they would enter the layer hash. Touching a
# test would then rebuild every layer from that `COPY` on, which `docker compose up
# --watch` does on every source change. tsconfig.build.json already keeps them
# out of the build.
src/**/*.test.ts
.editorconfig
.pre-commit-config.yaml

# Secrets
.env
.env.*
!.env.example

# Docker meta files themselves
Dockerfile
.dockerignore
compose.yaml
