{#- just runs every recipe from the root justfile's directory, so a nested crate
    is reached with cargo's own --manifest-path rather than with a cd. It renders
    empty for the flat layout, where the root already is the crate. -#}
{%- set mp = '' if rust_dir == '.' else ' --manifest-path ' ~ rust_dir ~ '/Cargo.toml' -%}
# What CI runs: format check, clippy, tests{% if rust_kind == 'library' %} (nextest, then the doctests it skips){% endif %}, cargo-deny.
rs-check:
    cargo fmt{{ mp }} --check
    cargo clippy{{ mp }} --all-targets --all-features -- -D warnings
    cargo nextest run{{ mp }} --all-features
{%- if rust_kind == 'library' %}
    cargo test{{ mp }} --doc --all-features
{%- endif %}
    cargo deny{{ mp }} check

# Download the dependencies, writing Cargo.lock if it is missing or stale. CI uses --locked.
rs-sync:
    cargo fetch{{ mp }}

# Apply clippy's machine-applicable fixes, then format.
rs-fmt:
    cargo clippy{{ mp }} --all-targets --all-features --fix --allow-dirty --allow-staged
    cargo fmt{{ mp }}

# Tests only; extra arguments reach nextest (`just rs-test name`).
rs-test *args:
    cargo nextest run{{ mp }} {% raw %}{{ args }}{% endraw %}
{%- if rust_kind == 'library' %}

# Compare the public API with the last v* tag, as CI's api job does. Not in rs-check: a
# deliberate break stays red until Cargo.toml's version is bumped to match.
rs-api:
    #!/usr/bin/env bash
    set -euo pipefail
    tag=$(git describe --tags --abbrev=0 --match 'v*' 2>/dev/null) || { echo "No v* tag yet: nothing to compare against."; exit 0; }
    cargo semver-checks{{ mp }} --baseline-rev "$tag"
{%- endif %}
{%- if rust_kind == 'library' and 'mutation' in test_extras %}

# Plant small bugs in src/ and report each one the tests miss. Slow: CI runs it
# weekly (mutation.yml); run it by hand after writing tests. Results land in mutants.out/.
rs-mutation:
    cargo mutants{{ '' if rust_dir == '.' else ' --dir ' ~ rust_dir }}

# The same for the code this branch changed since it split off a git ref (origin/main
# unless you give one): fast enough to run on each change. Fails on a missed mutant, as CI does.
rs-mutation-diff base='origin/main':
    #!/usr/bin/env bash
    set -euo pipefail
    diff=$(mktemp)
    trap 'rm -f "$diff"' EXIT
    # cargo mutants reads the paths in the diff relative to --dir.
    git diff{{ '' if rust_dir == '.' else ' --relative=' ~ rust_dir }} "$(git merge-base {% raw %}{{ base }}{% endraw %} HEAD)" >"$diff"
    cargo mutants{{ '' if rust_dir == '.' else ' --dir ' ~ rust_dir }} --in-diff "$diff"
{%- endif %}
{%- if profiling %}

# Build the profiling profile with frame pointers, so profilers get whole call stacks.
rs-profiling-build:
    RUSTFLAGS="-C force-frame-pointers=yes" cargo build{{ mp }} --profile profiling --all-targets

# Record a command with samply and open the profile in Firefox Profiler, e.g.
# `just rs-profile {{ '' if rust_dir == '.' else rust_dir ~ '/' }}target/profiling/<binary> <args>`. Needs samply and perf events
# (`perf_event_paranoid` 1 or lower).
rs-profile *cmd: rs-profiling-build
    samply record {% raw %}{{ cmd }}{% endraw %}

# Count instructions, cycles and branch misses for a command, five runs. Instruction counts
# barely move between runs, so compare those across changes rather than wall time.
rs-counters *cmd: rs-profiling-build
    perf stat -r 5 -e instructions,cycles,branches,branch-misses {% raw %}{{ cmd }}{% endraw %}
{%- endif %}
{%- if rust_kind == 'library' and 'property' in test_extras %}

# The tests with proptest at 10,000 cases a property instead of 256. CI runs it
# weekly (property.yml).
rs-property:
    PROPTEST_CASES=10000 cargo test{{ mp }} --all-features
{%- endif %}
