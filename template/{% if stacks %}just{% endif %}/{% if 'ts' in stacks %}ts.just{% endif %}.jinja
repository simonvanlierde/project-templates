{#- just runs every recipe from the root justfile's directory, so a nested package
    is reached with pnpm's -C, not a cd. It renders empty for the flat layout,
    where the root is the package. -#}
{%- set pnpm = 'pnpm' if ts_dir == '.' else 'pnpm -C ' ~ ts_dir -%}
# Install node_modules, writing pnpm-lock.yaml if it is missing. CI uses --frozen-lockfile.
ts-sync:
    {{ pnpm }} install

# What CI runs: lint and unused code, types, tests, build{% if publish_to_npm %}, API report{% endif %}{% if ts_kind == 'web-app' %}, bundle budget{% endif %}, dependency audit.
ts-check:
    {{ pnpm }} run check
    {{ pnpm }} run typecheck
    {{ pnpm }} run {{ 'coverage' if codecov else 'test' }}
    {{ pnpm }} run build
{%- if publish_to_npm %}
    {{ pnpm }} run api
{%- endif %}
{%- if ts_kind == 'web-app' %}
    {{ pnpm }} run budget
{%- endif %}
    {{ pnpm }} audit --prod --audit-level=moderate

# Fix what biome can fix, then format.
ts-fmt:
    {{ pnpm }} run fix

# Tests with a coverage summary.
ts-cov:
    {{ pnpm }} run coverage

# Tests only; extra arguments reach vitest (`just ts-test -t name`).
ts-test *args:
    {{ pnpm }} exec vitest run {% raw %}{{ args }}{% endraw %}
{%- if publish_to_npm %}

# Rewrite {{ slug }}.api.md from the built types after a deliberate API change, and
# commit it: its diff is the API change reviewers see. api-extractor.json gives
# the compiler its own options because api-extractor's bundled TypeScript 5 can't
# read this tsconfig.json.
ts-api:
    {{ pnpm }} run build
    {{ pnpm }} exec api-extractor run --local
{%- endif %}
{%- if ts_kind == 'library' and 'mutation' in test_extras %}

# Plant small bugs in src/ and report each one the tests miss. Slow: CI runs it
# weekly (mutation.yml); run it by hand after writing tests. The HTML report lands in
# reports/mutation/. stryker.config.json names the runner plugin, which Stryker can't
# find in pnpm's node_modules on its own, and sets an empty tsconfigFile: Stryker's
# tsconfig rewrite calls a TypeScript API that TypeScript 7 no longer has.
ts-mutation:
    {{ pnpm }} exec stryker run
{%- endif %}
{%- if ts_kind == 'library' and 'property' in test_extras %}

# The tests with fast-check at 10,000 runs a property instead of 100 (FC_NUM_RUNS,
# read in src/index.test.ts). CI runs it weekly (property.yml).
ts-property:
    FC_NUM_RUNS=10000 {{ pnpm }} exec vitest run
{%- endif %}
{%- if ts_kind == 'web-app' %}

# Playwright against the production build: the accessibility and CSP specs.
# Install the browser once per machine: `{{ pnpm }} exec playwright install chromium`.
ts-e2e *args:
    {{ pnpm }} run test:e2e {% raw %}{{ args }}{% endraw %}
{%- endif %}
