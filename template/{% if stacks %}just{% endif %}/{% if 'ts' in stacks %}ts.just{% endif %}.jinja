{#- just runs every recipe from the root justfile's directory, so a nested package
    is reached with pnpm's -C, not a cd. It renders empty for the flat layout,
    where the root is the package. -#}
{%- set pnpm = 'pnpm' if ts_dir == '.' else 'pnpm -C ' ~ ts_dir -%}
# Install node_modules from pnpm-lock.yaml.
ts-sync:
    {{ pnpm }} install

# What CI runs: lint and unused code, types, tests, build, dependency audit.
ts-check:
    {{ pnpm }} run check
    {{ pnpm }} run typecheck
    {{ pnpm }} run test
    {{ pnpm }} run build
    {{ pnpm }} audit --prod --audit-level=moderate

# Fix what biome can fix, then format.
ts-fmt:
    {{ pnpm }} run fix

# Tests with coverage: a terminal summary, plus coverage/lcov.info for an uploader.
ts-cov:
    {{ pnpm }} run coverage

# Tests only; extra arguments reach vitest (`just ts-test -t name`).
ts-test *args:
    {{ pnpm }} exec vitest run {% raw %}{{ args }}{% endraw %}
