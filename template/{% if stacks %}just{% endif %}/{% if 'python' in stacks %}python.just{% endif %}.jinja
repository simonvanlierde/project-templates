{#- just runs every recipe from the root justfile's directory, so a nested package
    is reached with uv's --directory, not a cd. It renders empty for the flat
    layout, where the root is the package. -#}
{%- set uv = 'uv' if python_dir == '.' else 'uv --directory ' ~ python_dir -%}
# Install the venv, writing uv.lock if it is missing or stale. CI uses --locked.
py-sync:
    {{ uv }} sync

# What CI runs: lint, format check, types, tests, dependency audit{% if kind == 'data-pipeline' %}. CI also runs the `just pipeline` stages{% endif %}.
py-check:
    {{ uv }} run ruff check
    {{ uv }} run ruff format --check
    {{ uv }} run ty check
    {{ uv }} run pytest
    {{ uv }} audit --locked --preview-features audit-command

# Fix what ruff can fix, then format.
py-fmt:
    {{ uv }} run ruff check --fix
    {{ uv }} run ruff format

# Tests with a coverage summary.
py-cov:
    {{ uv }} run pytest --cov --cov-report=term-missing

# Tests only; extra arguments reach pytest (`just py-test -k name`).
py-test *args:
    {{ uv }} run pytest {% raw %}{{ args }}{% endraw %}
{%- if kind == 'library' and 'mutation' in test_extras %}
{%- set cd = '' if python_dir == '.' else 'cd ' ~ python_dir ~ '\n    ' %}

# Plant small bugs in the package. Fails on a mutant the tests miss (or that no test
# reaches) unless tests/mutation-baseline.txt lists it, and on a listed one that no longer
# survives. Slow: CI runs it weekly (mutation.yml); run it by hand after writing tests.
# `mutmut browse` shows survivors.
py-mutation:
    #!/usr/bin/env bash
    set -euo pipefail
    {{ cd }}# Byte order, so sort and comm agree on the ǁ in class method mutant names.
    export LC_ALL=C
    # mutmut reuses results from mutants/ even after the tests change, so start clean.
    rm -rf mutants
    uv run mutmut run >/dev/null
    survivors=$(uv run mutmut results | sed -nE 's/^ *(.*): (survived|no tests)$/\1/p' | sort)
    listed=$(grep -vE '^(#|$)' tests/mutation-baseline.txt | awk '{ print $1 }' | sort || true)
    new=$(comm -23 <(echo "$survivors" | sed '/^$/d') <(echo "$listed" | sed '/^$/d'))
    gone=$(comm -13 <(echo "$survivors") <(echo "$listed" | sed '/^$/d'))
    echo "$(echo "$survivors" | grep -c . || true) survivors; not in tests/mutation-baseline.txt:"
    echo "${new:-none}"
    echo "listed but no longer surviving (drop them):"
    echo "${gone:-none}"
    [ -z "$new$gone" ]

# The same check for the functions that differ from a git ref (origin/main unless you
# give one): fast enough to run on each change. Fails on a survivor not in the baseline.
# Run `just py-mutation` before a release, since it also finds the listed ones to drop.
py-mutation-diff base='origin/main':
    #!/usr/bin/env bash
    set -euo pipefail
    {{ cd }}export LC_ALL=C
    rm -rf mutants
    patterns=$(uv run python {% raw %}{{ justfile_directory() }}{% endraw %}/just/mutation_diff.py {% raw %}{{ base }}{% endraw %})
    if [ -z "$patterns" ]; then echo "no changed function in a mutated module"; exit 0; fi
    # The patterns hold *, so keep the shell from expanding them as file names.
    set -f
    uv run mutmut run $patterns >/dev/null
    survivors=$(uv run mutmut results | sed -nE 's/^ *(.*): (survived|no tests)$/\1/p' | sort)
    listed=$(grep -vE '^(#|$)' tests/mutation-baseline.txt | awk '{ print $1 }' | sort || true)
    new=$(comm -23 <(echo "$survivors" | sed '/^$/d') <(echo "$listed" | sed '/^$/d'))
    echo "survivors not in tests/mutation-baseline.txt:"
    echo "${new:-none}"
    [ -z "$new" ]
{%- endif %}
{%- if profiling %}

# Profile a script or module with pyinstrument and print the call tree, e.g.
# `just py-profile -m mypackage.cli <args>`. Needs no perf events, so it runs on any host.
py-profile *args:
    {{ uv }} run --with pyinstrument pyinstrument {% raw %}{{ args }}{% endraw %}
{%- endif %}
{%- if kind == 'library' and 'property' in test_extras %}

# The tests under Hypothesis's "long" profile (tests/conftest.py): 10,000 examples a
# property instead of 100. CI runs it weekly (property.yml).
py-property:
    {{ uv }} run pytest --hypothesis-profile=long
{%- endif %}
{%- if kind == 'data-pipeline' %}

# Download each implemented source in sources.toml to data/raw/, with a fetch record.
fetch:
    {{ uv }} run {{ slug }} fetch

# Turn data/raw/ into data/processed/, verifying each checksum first.
build:
    {{ uv }} run {{ slug }} build

# Re-read data/processed/ and re-hash data/raw/ against the fetch records.
validate:
    {{ uv }} run {{ slug }} validate

# Print the Markdown table of implemented sources and their terms, for ATTRIBUTION.md.
attribution:
    {{ uv }} run {{ slug }} attribution

# One line per source: status, vintage, last fetch, checksum, licence. Reads no network.
status:
    {{ uv }} run {{ slug }} status

# The whole chain, from the network to validated output.
pipeline: fetch build validate
{%- endif %}
{%- if kind == 'web-service' %}

# Serve on 127.0.0.1:{{ app_port }} (HOST and PORT override), outside Docker.
serve:
    {{ uv }} run {{ slug }}
{%- endif %}
