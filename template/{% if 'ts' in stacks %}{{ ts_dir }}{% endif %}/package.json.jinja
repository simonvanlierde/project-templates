{
  "name": "{{ slug }}",
  "version": "0.1.0",
  "description": {{ project_description | to_json }},
{%- if license != 'none' %}
  "license": "{{ license }}",
{%- endif %}
  "author": "{{ author_name }} <{{ author_email }}>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{{ github_user }}/{{ slug }}.git"
  },
  "type": "module",
{%- if ts_kind == 'library' %}
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/main.*"
  ],
{%- endif %}
{%- if not publish_to_npm %}
  "private": true,
{%- endif %}
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">={{ node_version }}"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check && knip",
    "coverage": "vitest run --coverage --coverage.reporter=text",
    "fix": "biome check --write",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "knip": {
    "ignoreDependencies": [
      "@j178/prek"
{#- Only ts-release.yml runs publint. knip finds it there from a root package,
    but a nested one never sees .github/. #}
{%- if publish_to_npm and ts_dir != '.' %},
      "publint"
{%- endif %}
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@j178/prek": "^0.5.3",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "knip": "^6.38.0",
{%- if publish_to_npm %}
    "publint": "^0.3.24",
{%- endif %}
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
