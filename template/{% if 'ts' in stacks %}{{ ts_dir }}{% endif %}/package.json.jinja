{%- set mutation = ts_kind == 'library' and 'mutation' in test_extras -%}
{
  "name": "{{ slug }}",
  "version": "0.1.0",
  "description": {{ project_description | to_json }},
{%- if license != 'none' %}
  "license": "{{ license }}",
{%- endif %}
  "author": {{ (author_name ~ " <" ~ author_email ~ ">") | to_json }},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{{ github_user }}/{{ slug }}.git"
  },
  "type": "module",
{%- if ts_kind == 'library' %}
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/main.*"
  ],
{%- endif %}
{%- if not publish_to_npm %}
  "private": true,
{%- endif %}
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">={{ node_version }}"
  },
  "scripts": {
{%- if publish_to_npm %}
    "api": "api-extractor run",
{%- endif %}
{%- if web_app %}
    "budget": "node scripts/checkBundleBudget.mjs{% if site_path %} dist{{ site_path }}/assets{% endif %}",
    "build": "vite build",
{%- else %}
    "build": "tsc -p tsconfig.build.json",
{%- endif %}
    "check": "biome check && knip",
    "coverage": "vitest run --coverage --coverage.reporter=text",
{%- if web_app %}
    "dev": "vite",
{%- endif %}
    "fix": "biome check --write",
{%- if web_app %}
    "page-weight": "node scripts/page-weight.mjs dist",
{%- endif %}
{%- if license != 'none' %}
    "licenses": "pnpm licenses list --prod --json | node scripts/checkLicenses.mjs",
{%- endif %}
{%- if web_app %}
    "preview": "vite preview",
{%- endif %}
    "test": "vitest run",
{%- if web_app %}
    "test:e2e": "playwright test",
    "typecheck": "{{ 'svelte-check --fail-on-warnings' if web_framework == 'svelte' else 'tsc' }}{% if worker %} && tsc -p worker{% endif %}"
{%- else %}
    "typecheck": "tsc --noEmit"
{%- endif %}
  },
  "knip": {
    "ignoreDependencies": [
      "@j178/prek"
{#- Only workflows run publint (ts-release.yml). knip finds it there from a root
    package, but a nested one never sees .github/. wrangler runs only from
    .github/scripts/deploy-worker.sh, a shell script knip does not read. #}
{%- if publish_to_npm and ts_dir != '.' %},
      "publint"
{%- endif %}
{%- if web_app %},
      "wrangler"
{%- endif %}
    ]
{%- if ts_dir == '.' and (site != 'none' or docs_starlight) %},
{#- site/ and docs-site/ are packages of their own: nothing in this one imports them.
    site.yml runs the site's page-weight script with node, which knip does not read. #}
    "ignoreFiles": [
      {{ ([] + (['".github/scripts/page-weight.mjs"', '"site/**"'] if site != 'none' else []) + (['"docs-site/**"'] if docs_starlight else [])) | join(',\n      ') }}
    ]
{%- endif %}
{%- if web_app %},
{#- playwright.config.ts adds tests/shots only when SHOTS is set, so knip, which
    loads the config without it, needs the spec named. The plugin's entry adds to
    the config's test files; a top-level entry would replace knip's defaults. #}
    "playwright": {
      "entry": [
        "tests/shots/*.spec.ts"
      ]
    }
{%- endif %}
  },
{%- if web_app %}
  "dependencies": {
{%- if web_framework == 'preact' %}
    "preact": "^11.1.0"
{%- elif web_framework == 'svelte' %}
    "svelte": "^5.57.3"
{%- else %}
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
{%- endif %}
  },
{%- endif %}
  "devDependencies": {
{%- if web_app %}
    "@axe-core/playwright": "^4.14.0",
{%- endif %}
    "@biomejs/biome": "^2.6.3",
{%- if web_app and worker %}
    "@cloudflare/workers-types": "^5.20261001.1",
{%- endif %}
    "@j178/prek": "^0.5.7",
{%- if publish_to_npm %}
    "@microsoft/api-extractor": "^7.60.0",
{%- endif %}
{%- if mutation %}
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
{%- endif %}
{%- if web_app %}
    "@playwright/test": "^1.64.1",
{#- @testing-library/react takes the DOM library as a peer; the preact and svelte ones bundle it. #}
{%- if web_framework == 'preact' %}
    "@testing-library/preact": "^3.2.6",
{%- elif web_framework == 'svelte' %}
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
{%- else %}
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
{%- endif %}
{%- endif %}
    "@types/node": "^26.6.5",
{%- if web_app and web_framework == 'react' %}
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
{%- endif %}
    "@vitest/coverage-v8": "^5.0.5",
{%- if ts_kind == 'library' and 'property' in test_extras %}
    "fast-check": "^4.10.2",
{%- endif %}
{%- if web_app %}
    "jsdom": "^30.1.3",
{%- endif %}
    "knip": "^6.43.0",
{%- if web_app %}
{#- Exact: a change in how it renders the legal pages comes in its own bump, not in a lockfile refresh. #}
    "marked": "18.1.1",
{%- endif %}
{%- if publish_to_npm %}
    "publint": "^0.3.25",
{%- endif %}
{%- if web_app and web_framework == 'svelte' %}
    "svelte-check": "^4.7.7",
{%- endif %}
{%- if web_app and web_framework == 'svelte' %}
{#- svelte-check 4.7 refuses TypeScript 7 unless 6 is installed beside it and it runs with --tsgo. #}
    "typescript": "^6.0.3",
{%- else %}
    "typescript": "^7.0.2",
{%- endif %}
{%- if web_app %}
    "vite": "^8.3.5",
{%- endif %}
    "vitest": "^5.0.5"{% if web_app %},
{#- Exact: CI runs it with the Cloudflare token. Renovate bumps it on its own. #}
    "wrangler": "{{ wrangler_version }}"{% endif %}
  }
}
