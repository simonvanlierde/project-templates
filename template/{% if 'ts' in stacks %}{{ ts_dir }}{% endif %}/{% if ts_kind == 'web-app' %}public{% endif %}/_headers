# Response headers for the Cloudflare Worker, which reads this file from the build output.
# These apply to production. The preview job in ts.yml appends X-Robots-Tag: noindex to
# its own copy of the build, so previews stay out of search results and this site does not.
# The page loads nothing but its own files, so the policy allows this origin only.
# script-src 'self' blocks inline scripts: put code that must run before first paint
# in a file under public/ and load it with <script src>. tests/e2e/csp.spec.ts runs
# the built app under this policy and fails on any violation.
# HSTS leaves out includeSubDomains: other subdomains may not be served from here.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
