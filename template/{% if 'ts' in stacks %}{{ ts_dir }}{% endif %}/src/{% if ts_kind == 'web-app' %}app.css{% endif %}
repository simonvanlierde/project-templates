:root {
  color-scheme: light dark;
  font-family: system-ui, sans-serif;
  line-height: 1.5;
  color: light-dark(#1a1a1a, #f0f0f0);
  background: light-dark(#ffffff, #121212);
}

body {
  margin: 0;
}

main {
  max-width: 40rem;
  margin: 0 auto;
  padding: 2rem 1rem;
}

/* A long word or URL wraps instead of forcing a sideways scroll (WCAG 1.4.10). */
main {
  overflow-wrap: anywhere;
}
