<script lang="ts" module>
import accessibility from "../docs/accessibility.md";
import privacy from "../docs/privacy.md";
{%- if user_data == 'accounts' %}
import terms from "../docs/terms.md";
{%- endif %}

export const title = {{ project_name | to_json }};
{%- if project_description %}
const description = {{ project_description | to_json }};
{%- endif %}

// Where the app is served: "/", or site_url's path, such as "/app/" (vite.config.ts `base`).
const BASE = import.meta.env.BASE_URL;

// The pages rendered from docs/, by path. The Cloudflare Worker and vite preview
// answer an unknown path with index.html, so each loads the app.
const PAGES: Record<string, { title: string; html: string }> = {
  "/accessibility": { title: "Accessibility statement", html: accessibility },
  "/privacy": { title: "Privacy statement", html: privacy },
{%- if user_data == 'accounts' %}
  "/terms": { title: "Terms of use", html: terms },
{%- endif %}
};
</script>

<script lang="ts">
const page = PAGES[location.pathname.slice(BASE.length - 1).replace(/\/$/, "")];

$effect(() => {
  document.title = page ? `${page.title} · ${title}` : title;
});
</script>
{# raw: Svelte's {#if} and {#each} would open Jinja comments. #}
{% raw -%}
<main>
  {#if page}
    <!-- {@html}: our own Markdown, rendered at build time -->
    <article>{@html page.html}</article>
  {:else}
    <h1>{title}</h1>
{%- endraw %}
{%- if project_description %}
    <p>{description}</p>
{%- endif %}
{% raw %}  {/if}
</main>
<footer>
  <nav aria-label="About this site">
    {#if page}<a href={BASE}>{title}</a>{/if}
    {#each Object.entries(PAGES) as [path, { title: name }] (path)}
      <a href={BASE + path.slice(1)} aria-current={PAGES[path] === page ? "page" : undefined}>{name}</a>
    {/each}
  </nav>
</footer>{% endraw %}
