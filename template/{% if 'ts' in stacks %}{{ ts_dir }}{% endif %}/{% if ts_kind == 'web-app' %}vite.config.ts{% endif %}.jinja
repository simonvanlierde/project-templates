{% if web_framework == 'react' -%}
import react from "@vitejs/plugin-react";
{% endif -%}
import { marked } from "marked";
import { defineConfig, type Plugin } from "vite";

/**
 * Turns an imported .md file into its HTML at build time, so the pages in docs/
 * ship as HTML and no Markdown code reaches the browser. GitHub shows the same files.
 * HTML comments are notes for the author, so they are dropped before visitors see them.
 */
const markdown = (): Plugin => ({
  name: "markdown-html",
  transform(code, id) {
    if (id.endsWith(".md")) {
      // Strip until nothing changes: one pass over "<!<!---->---->" leaves a comment behind.
      let text = code;
      for (let before = ""; before !== text; ) {
        before = text;
        text = text.replace(/<!--[\s\S]*?-->/g, "");
      }
      const html = marked.parse(text, { async: false });
      return { code: `export default ${JSON.stringify(html)};`, map: null };
    }
  },
});

export default defineConfig({
{%- if web_framework == 'preact' %}
  plugins: [markdown()],
  resolve: {
    // Code written for React, including libraries, imports react and react-dom.
    // preact/compat answers those imports. The longer paths come first: each
    // key also matches the paths below it.
    alias: {
      "react/jsx-runtime": "preact/jsx-runtime",
      "react/jsx-dev-runtime": "preact/jsx-dev-runtime",
      "react-dom/test-utils": "preact/test-utils",
      "react-dom/client": "preact/compat/client",
      "react-dom": "preact/compat",
      react: "preact/compat",
    },
  },
{%- else %}
  plugins: [react(), markdown()],
{%- endif %}
});
