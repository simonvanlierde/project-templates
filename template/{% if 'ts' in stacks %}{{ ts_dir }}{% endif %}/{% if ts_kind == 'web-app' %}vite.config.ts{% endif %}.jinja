import { execFileSync } from "node:child_process";
{% if site_path -%}
import { copyFileSync } from "node:fs";
{% endif -%}
{% if web_framework == 'react' -%}
import react from "@vitejs/plugin-react";
{% elif web_framework == 'svelte' -%}
import { svelte } from "@sveltejs/vite-plugin-svelte";
import { svelteTesting } from "@testing-library/svelte/vite";
{% endif -%}
import { marked } from "marked";
import { defineConfig, type Plugin } from "vite";

function buildRevision(): string {
  try {
    const options = { encoding: "utf8", stdio: "pipe" } as const;
    execFileSync("git", ["ls-files", "--error-unmatch", "--", "package.json"], options);
    return execFileSync("git", ["describe", "--tags", "--always", "--dirty"], options).trim();
  } catch {
    return "unknown";
  }
}

const revision = buildRevision();

const versionFile = (): Plugin => ({
  name: "version-file",
  apply: "build",
  generateBundle() {
    this.emitFile({ type: "asset", fileName: "version.txt", source: `${revision}\n` });
  },
});

/**
 * Turns an imported .md file into its HTML at build time, so the pages in docs/
 * ship as HTML and no Markdown code reaches the browser. GitHub shows the same files.
 * HTML comments are notes for the author, so they are dropped before visitors see them.
 */
const markdown = (): Plugin => ({
  name: "markdown-html",
  transform(code, id) {
    if (id.endsWith(".md")) {
      // Strip until nothing changes: one pass over "<!<!---->---->" leaves a comment behind.
      let text = code;
      for (let before = ""; before !== text; ) {
        before = text;
        text = text.replace(/<!--[\s\S]*?-->/g, "");
      }
      const html = marked.parse(text, { async: false });
      return { code: `export default ${JSON.stringify(html)};`, map: null };
    }
  },
});

{%- if site_path %}

/**
 * Production routes {{ site_path }}/ to the Worker, which looks each request's full path up
 * in dist/, so the build goes to dist{{ site_path }}/. Cloudflare reads _headers only at the
 * top of dist/, and answers a page path it has no file for with dist/index.html, so both
 * get a copy there. That index.html already loads its assets from {{ site_path }}/.
 */
const topLevelCopies = (): Plugin => ({
  name: "top-level-copies",
  apply: "build",
  closeBundle() {
    for (const name of ["index.html", "_headers"]) {
      copyFileSync(`dist{{ site_path }}/${name}`, `dist/${name}`);
    }
  },
});
{%- endif %}

export default defineConfig({
  define: { "import.meta.env.VITE_BUILD_REVISION": JSON.stringify(revision) },
{%- if site_path %}
  // The path in site_url. import.meta.env.BASE_URL gives it to the app.
  base: "{{ site_path }}/",
  build: { outDir: "dist{{ site_path }}" },
{%- endif %}
{%- if web_framework == 'preact' %}
  plugins: [markdown(), versionFile(){% if site_path %}, topLevelCopies(){% endif %}],
  resolve: {
    // Code written for React, including libraries, imports react and react-dom.
    // preact/compat answers those imports. The longer paths come first: each
    // key also matches the paths below it.
    alias: {
      "react/jsx-runtime": "preact/jsx-runtime",
      "react/jsx-dev-runtime": "preact/jsx-dev-runtime",
      "react-dom/test-utils": "preact/test-utils",
      "react-dom/client": "preact/compat/client",
      "react-dom": "preact/compat",
      react: "preact/compat",
    },
  },
{%- elif web_framework == 'svelte' %}
  // svelteTesting acts under vitest only: it loads Svelte's browser build and unmounts after each test.
  plugins: [svelte(), svelteTesting(), markdown(), versionFile(){% if site_path %}, topLevelCopies(){% endif %}],
{%- else %}
  plugins: [react(), markdown(), versionFile(){% if site_path %}, topLevelCopies(){% endif %}],
{%- endif %}
});
