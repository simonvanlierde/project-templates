import { expect, test } from "@playwright/test";
import { ROUTES } from "./routes";

/**
 * Guards docs/accessibility.md as the app renders it at /accessibility. The
 * statement's value is that it claims no more than the repo can show, so these
 * fail when it overclaims, loses its contact, or goes a year without review.
 * a11y.spec.ts runs axe over it with the other routes.
 */

// The status sentence, with the W3C conformance terms the statement may use.
// "Fully conformant" needs a full external audit: allow it only once one is done.
const STATUS = /^Its conformance is (not assessed|partially conformant|non-conformant)\b/i;
const SECTIONS = [
  {{ ('Using ' ~ project_name) | to_json }},
  {{ ('How accessible ' ~ project_name ~ ' is') | to_json }},
  "Known problems",
  "Tell us about a problem",
  "How we check",
  "Tested with",
  "About this statement",
];
// A yearly review plus a month's grace.
const MAX_REVIEW_AGE_DAYS = 400;
const DAY_MS = 86_400_000;

test("the statement renders its sections and claims no more than was checked", async ({ page }) => {
  await page.goto("/accessibility");
  await expect(page).toHaveTitle(/^Accessibility statement/);
  const statement = page.locator("article");
  await expect(statement.getByRole("heading", { level: 1 })).toHaveText("Accessibility statement");
  await expect(statement.getByRole("heading", { level: 2 })).toHaveText(SECTIONS);

  // The term must sit in the status sentence, not anywhere on the page.
  await expect(statement.getByText(/^Its conformance is /)).toHaveText(STATUS);
  await expect(statement).not.toContainText(/fully conformant/i);

  // Email first: a GitHub account must never be the only way to report a barrier.
  await expect(statement.getByRole("link", { name: /@/ }).first()).toHaveAttribute("href", /^mailto:.+@.+/);
  await expect(statement).toContainText(/within \d+ working days/);
});

test("the statement was reviewed in the last 400 days", async ({ page }) => {
  await page.goto("/accessibility");
  const line = await page
    .locator("article")
    .getByText(/^Last reviewed:/)
    .textContent();
  const reviewed = new Date((line ?? "").replace(/^Last reviewed:\s*/, ""));
  expect(Number.isNaN(reviewed.getTime()), `unreadable date in "${line}"`).toBe(false);
  const ageDays = (Date.now() - reviewed.getTime()) / DAY_MS;
  // A date in the future is a typo, and would hold the check off for years.
  expect(ageDays).toBeGreaterThan(-1);
  expect(ageDays).toBeLessThan(MAX_REVIEW_AGE_DAYS);
});

// The template leaves a TODO wherever only the project knows the answer.
test("the statement has no TODO left", async ({ page }) => {
  await page.goto("/accessibility");
  await expect(page.locator("article")).not.toContainText("TODO");
});

for (const path of ROUTES) {
  test(`${path} links the statement from its footer`, async ({ page }) => {
    await page.goto(path);
    await page.getByRole("contentinfo").getByRole("link", { name: "Accessibility statement" }).click();
    await expect(page).toHaveURL(/\/accessibility$/);
    await expect(page.getByRole("heading", { level: 1 })).toHaveText("Accessibility statement");
  });
}
