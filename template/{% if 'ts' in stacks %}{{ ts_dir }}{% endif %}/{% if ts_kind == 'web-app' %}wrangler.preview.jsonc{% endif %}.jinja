// PR previews only. CI always deploys this file with --name <slug>-pr-<number>, so
// the name below is never used. Pages ignores it: production is wrangler.jsonc.
//
// Keep the slug short: a Worker name can have at most 63 characters, and "-pr-123" takes seven.
{
  "name": "{{ slug | replace('.', '-') | replace('_', '-') }}-preview",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // A single-page app answers every path with index.html, as Pages does.
    "not_found_handling": "single-page-application"
  },
  // Off, so the workers.dev address is the Worker's only one, and the retire job can
  // check that one address after the delete.
  "preview_urls": false,
  "workers_dev": true
}
