<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
{%- if project_description %}
    <meta name="description" content="{{ project_description | e }}" />
{%- endif %}
    <title>{{ project_name | e }}</title>
    <!-- No inline <script>: public/_headers allows scripts from this origin only.
         Code that must run before first paint goes in a file under public/,
         loaded with <script src="/name.js">. -->
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
