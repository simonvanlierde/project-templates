<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
{%- if project_description %}
    <meta name="description" content="{{ project_description | e }}" />
{%- endif %}
    <meta property="og:image" content="{{ site_url | regex_replace('/$', '') }}/opengraph-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ (project_name ~ (": " ~ project_description if project_description else "")) | e }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{{ project_name | e }}</title>
    <!-- No inline <script>: public/_headers allows scripts from this origin only.
         Code that must run before first paint goes in a file under public/,
         loaded with <script src="/name.js">. -->
  </head>
  <body>
    <div id="root"></div>
    <noscript>This app needs JavaScript. To report a problem, email <a href="mailto:{{ author_email | e }}">{{ author_email | e }}</a>.</noscript>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
