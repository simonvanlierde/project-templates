# The patch check fails a pull request when tests cover under 90% of the lines it adds
# or changes. Total coverage is shown, not enforced: it moves with code the pull
# request did not touch, so it says little about the change.
coverage:
  status:
    project:
      default:
        informational: true
    patch:
      default:
        target: 90%

# No pull request comment: the patch check links to the report.
comment: false

# With both stacks, CI uploads one report per stack. Codecov compares as soon as the
# first arrives, so the other stack's lines would count as a drop. Carryforward fills a
# missing report with the base commit's numbers for that flag.
flag_management:
  default_rules:
    carryforward: true
