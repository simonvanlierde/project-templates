# Codecov reports coverage; CI's tests are the gate. It fails a pull request only when
# total coverage drops by more than 2 points, and the new lines' share is shown, not
# enforced.
coverage:
  status:
    project:
      default:
        target: auto
        threshold: 2%
    patch:
      default:
        informational: true

# Comment only when a pull request adds lines no test runs. A total drop of over 2 points
# shows as the failing project check instead. (coverage_drop would comment on any drop at
# all, threshold or not.)
comment:
  require_changes: "uncovered_patch"

# With both stacks, CI uploads one report per stack. Codecov compares as soon as the
# first arrives, so the other stack's lines would count as a drop. Carryforward fills a
# missing report with the base commit's numbers for that flag.
flag_management:
  default_rules:
    carryforward: true
