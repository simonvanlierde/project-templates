{%- set holder = (copyright_year ~ ' ' ~ (author_name | trim)) | to_json -%}
# Who holds the copyright on each file and under which license, per the REUSE spec
# (https://reuse.software). The texts are in LICENSES/; `reuse lint` checks every
# file is covered. A header in a file overrides these defaults, so a file copied
# from elsewhere keeps its own: add `SPDX-FileCopyrightText` and
# `SPDX-License-Identifier` lines to it, or an annotation below.
version = 1

[[annotations]]
path = "**"
SPDX-FileCopyrightText = {{ holder }}
SPDX-License-Identifier = "{{ license }}"
{%- if public %}

# The Code of Conduct is the Contributor Covenant 3.0, which keeps its own license.
[[annotations]]
path = ".github/CODE_OF_CONDUCT.md"
SPDX-FileCopyrightText = "Organization for Ethical Source"
SPDX-License-Identifier = "CC-BY-SA-4.0"
{%- endif %}
{%- if data_license != 'none' %}

# Data is licensed apart from the code. The last matching annotation wins.
[[annotations]]
path = "{{ '' if python_dir == '.' else python_dir ~ '/' }}data/**"
SPDX-FileCopyrightText = {{ holder }}
SPDX-License-Identifier = "{{ data_license }}"
{%- endif %}
