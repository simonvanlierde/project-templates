// Renovate, the `dependency_bot` answer: it needs the Renovate GitHub App on this repo.
// It follows the same rules as the template's Dependabot config, except that Dependabot
// also groups npm security updates. No automerge.
//
// `minimumReleaseAge` holds a version update back until the release has been public for
// a week, long enough for a compromised release to be caught and yanked. Security
// updates ignore it and the schedule. They need Dependabot alerts on in the repo settings,
// and cover only the dependencies a manifest names.
//
// No Dockerfile or compose updates: the FROM tags are copier answers, so those PRs
// would fight the next `copier update`.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  schedule: ['before 9am on monday'],
  minimumReleaseAge: '7 days',
  // A weekly relock is the only way a fix reaches a dependency that only the lockfile
  // names. A relock has no release date, so the week's wait above would hold it back for
  // good: uv's exclude-newer and pnpm's minimumReleaseAge keep the week instead. It runs
  // all Monday, because the hosted app often misses Renovate's 'before 4am' window.
  lockFileMaintenance: {
    enabled: true,
    schedule: ['on monday'],
    minimumReleaseAge: null,
  },
  // Off by default in Renovate. The hook revs are commit SHAs with a `# frozen:` tag
  // comment; check that the first hooks PR keeps that form.
  'pre-commit': { enabled: true },
  dockerfile: { enabled: false },
  'docker-compose': { enabled: false },
  packageRules: [
    // Actions and hook revs are all CI and dev tooling: one PR for both.
    { matchManagers: ['github-actions', 'pre-commit'], groupName: 'actions and hooks' },
    // Dev tooling lands as one PR and runtime minor and patch bumps as another, so a
    // risky bump is not buried in lint-tool churn. A runtime major gets its own PR. The
    // dev-tooling rule comes second, so it wins for dev dependencies.
    {
      matchManagers: ['pep621', 'npm', 'cargo', 'gomod'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'runtime',
    },
    {
      matchManagers: ['pep621', 'npm', 'cargo'],
      matchDepTypes: ['dependency-groups', 'devDependencies', 'dev-dependencies'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'dev tooling',
    },
    {
      matchManagers: ['pep621', 'npm', 'cargo', 'gomod'],
      matchUpdateTypes: ['major'],
      minimumReleaseAge: '30 days',
    },
    // Template releases, from .copier-answers.yml. Their tags carry no release date,
    // so the week's wait above would hold them back for good.
    { matchManagers: ['copier'], minimumReleaseAge: null },
  ],
}
