# One ignore file for every stack in this repo.

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
coverage.xml

# Node
node_modules/
.pnpm-store/
*.tsbuildinfo
coverage/
{%- if 'ts' in stacks and ts_kind == 'web-app' %}
playwright-report/
test-results/
blob-report/
.wrangler/
dev-dist/
{%- endif %}

# Rust
target/
{%- if 'go' in stacks %}
{%- set d = '' if go_dir == '.' else go_dir ~ '/' %}

# Go
{{ d }}coverage.out
{%- if go_kind == 'binary' %}
# What `go build` writes: a binary named after the module path's last element,
# without a trailing major version such as /v2.
/{{ d }}{{ (go_module|regex_replace('/v[0-9]+$', '')).split('/')[-1] }}
{%- endif %}
{%- endif %}
{%- if 'python' in stacks and kind == 'data-pipeline' %}
{%- set d = '' if python_dir == '.' else python_dir ~ '/' %}

# Never committed: `just pipeline` rebuilds both from sources.toml, so the repo
# redistributes no source data.
{{ d }}data/raw/*
!{{ d }}data/raw/.gitkeep
{{ d }}data/processed/*
!{{ d }}data/processed/.gitkeep
{%- endif %}
{%- if test_extras %}

# Test extras: Hypothesis's example database and what the mutation tools write
.hypothesis/
mutants/
.stryker-tmp/
# Stryker writes it beside the package, which may be nested.
**/reports/mutation/
mutants.out*/
{%- endif %}
