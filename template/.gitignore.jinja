# One ignore file for every stack in this repo.

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Secrets
.env
.env.*
!.env.example

# Vale
.vale/styles/

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
coverage.xml

# Node
node_modules/
.pnpm-store/
*.tsbuildinfo
coverage/

# Rust
target/
{%- if 'go' in stacks %}
{%- set d = '' if go_dir == '.' else go_dir ~ '/' %}

# Go
{{ d }}coverage.out
{%- if go_kind == 'binary' %}
# What `go build` writes: a binary named after the module path's last element.
/{{ d }}{{ go_module.split('/')[-1] }}
{%- endif %}
{%- endif %}
{%- if 'python' in stacks and kind == 'data-pipeline' %}
{%- set d = '' if python_dir == '.' else python_dir ~ '/' %}

# Pipeline data, never committed: `just pipeline` rebuilds both from sources.toml,
# so the repository redistributes no source data.
{{ d }}data/raw/*
!{{ d }}data/raw/.gitkeep
{{ d }}data/processed/*
!{{ d }}data/processed/.gitkeep
{%- endif %}
