# One ignore file for every stack in this repo.

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Secrets
.env
.env.*
!.env.example

# Vale
.vale/styles/

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
coverage.xml

# Node
node_modules/
.pnpm-store/
*.tsbuildinfo
coverage/

# Rust
target/
{%- if 'python' in stacks and kind == 'data-pipeline' %}
{%- set d = '' if python_dir == '.' else python_dir ~ '/' %}

# Never committed: `just pipeline` rebuilds both from sources.toml, so the repo
# redistributes no source data.
{{ d }}data/raw/*
!{{ d }}data/raw/.gitkeep
{{ d }}data/processed/*
!{{ d }}data/processed/.gitkeep
{%- endif %}
