{%- set name = (author_name | trim).split(none, 1) -%}
# GitHub reads this for its "Cite this repository" button, and Zenodo when it
# archives a release. Software indexes read codemeta.json. Edit this file only, then
# run `just citation` to bring codemeta.json in line; the citesync git hook fails while they or the package manifests disagree. Check the name split below:
# the first word becomes the given name.
cff-version: 1.2.0
message: If you use this software, please cite it as below.
title: {{ project_name | to_json }}
{%- if project_description %}
abstract: {{ project_description | to_json }}
{%- endif %}
authors:
{%- if name | length > 1 %}
  - given-names: {{ name[0] | to_json }}
    family-names: {{ name[1] | to_json }}
{%- else %}
  - family-names: {{ name[0] | to_json }}
{%- endif %}
{%- if author_orcid %}
    orcid: "https://orcid.org/{{ author_orcid }}"
{%- endif %}
    email: {{ author_email | to_json }}
repository-code: "https://github.com/{{ github_user }}/{{ slug }}"
{%- if license != 'none' %}
license: {{ license }}
{%- endif %}
