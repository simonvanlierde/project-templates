# Dependabot, not Renovate: no app install, and it covers every ecosystem here,
# including the `rev` pins in .pre-commit-config.yaml. No automerge: that needs a
# workflow with contents:write.
#
# `cooldown` holds a version update back until the release has been public for a
# week, long enough for a compromised release to be caught and yanked. Security
# updates ignore it. github-actions and pre-commit take default-days only.
version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule: { interval: weekly }
    cooldown: { default-days: 7 }
    groups:
      actions: { patterns: ["*"] }

  # Version updates only; Dependabot has no security updates for this ecosystem.
  # Hook revs group wholesale: all dev tooling.
  - package-ecosystem: pre-commit
    directory: /
    schedule: { interval: weekly }
    cooldown: { default-days: 7 }
    groups:
      hooks: { patterns: ["*"] }
{%- if 'python' in stacks %}

  # Dev tooling lands as one PR. A runtime dependency gets its own, so a risky bump
  # is not buried in lint-tool churn.
  - package-ecosystem: uv
    directory: {{ '/' if python_dir == '.' else '/' ~ python_dir }}
    schedule: { interval: weekly }
    cooldown: { default-days: 7, semver-major-days: 30 }
    groups:
      dev-tooling:
        dependency-type: development
        update-types: [minor, patch]
        patterns: ["*"]
{%- endif %}
{%- if 'ts' in stacks %}

  - package-ecosystem: npm
    directory: {{ '/' if ts_dir == '.' else '/' ~ ts_dir }}
    schedule: { interval: weekly }
    cooldown: { default-days: 7, semver-major-days: 30 }
    groups:
      dev-tooling:
        dependency-type: development
        update-types: [minor, patch]
        patterns: ["*"]
{%- endif %}
{%- if 'rust' in stacks %}

  - package-ecosystem: cargo
    directory: {{ '/' if rust_dir == '.' else '/' ~ rust_dir }}
    schedule: { interval: weekly }
    cooldown: { default-days: 7, semver-major-days: 30 }
    groups:
      dev-tooling:
        dependency-type: development
        update-types: [minor, patch]
        patterns: ["*"]
{%- endif %}
{%- if 'go' in stacks %}

  # No dev-tooling group: go.mod has no development dependencies to split out.
  - package-ecosystem: gomod
    directory: {{ '/' if go_dir == '.' else '/' ~ go_dir }}
    schedule: { interval: weekly }
    cooldown: { default-days: 7, semver-major-days: 30 }
{%- endif %}

# No docker ecosystem: it reads FROM lines only, and those tags are copier answers,
# so its PRs would fight the next `copier update`.
