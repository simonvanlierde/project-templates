{
  "name": "main-checks",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [{ "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request" }],
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          { "context": "git hooks", "integration_id": 15368 },
          { "context": "pull request title", "integration_id": 15368 },
          { "context": "DCO sign-off", "integration_id": 15368 },
          { "context": "dependency review", "integration_id": 15368 }
{#- A nested stack's workflow runs only when its folder changes, so its check can't be required. #}
{%- if 'python' in stacks and python_dir == '.' %},
          { "context": "python: lint, types, {% if kind == 'data-pipeline' %}pipeline, {% endif %}tests", "integration_id": 15368 }
{%- endif %}
{%- if 'ts' in stacks and ts_dir == '.' %},
          { "context": "ts: lint, types, tests", "integration_id": 15368 }
{%- endif %}
{%- if 'rust' in stacks and rust_dir == '.' %},
          { "context": "fmt, clippy, tests, deny", "integration_id": 15368 }
{%- endif %}
{%- if 'go' in stacks and go_dir == '.' %},
          { "context": "golangci-lint, tests, govulncheck", "integration_id": 15368 }
{%- endif %}
        ]
      }
    }
  ]
}
