{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
{%- if public %}
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request" }
{%- if dependency_bot == 'renovate' %},
    { "actor_id": 2740, "actor_type": "Integration", "bypass_mode": "pull_request" }
{%- endif %}
  ],
{%- endif %}
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["squash"],
        "required_approving_review_count": {{ 1 if public else 0 }},
        "dismiss_stale_reviews_on_push": {{ public | tojson }},
        "require_code_owner_review": false,
        "require_last_push_approval": {{ public | tojson }},
        "required_review_thread_resolution": false
      }
{%- if public %}
    }
{%- else %}
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          { "context": "git hooks", "integration_id": 15368 },
          { "context": "pull request title", "integration_id": 15368 },
          { "context": "dependency review", "integration_id": 15368 }
        ]
      }
    }
{%- endif %}
  ]
}
