# Dependabot, the default `dependency_bot` answer: no app install, and it covers every
# ecosystem here, including the `rev` pins in .pre-commit-config.yaml. You merge every PR:
# merging them automatically needs a workflow with `contents: write` and, in a public repo,
# where `main` asks for an approval, Actions allowed to approve PRs. For updates that merge
# themselves, answer `dependency_bot=renovate` instead.
#
# `cooldown` holds a version update back until the release has been public for a
# week, long enough for a compromised release to be caught and yanked. One number for
# every ecosystem and every update type. Security updates ignore it.
#
# No docker ecosystem: it reads FROM lines only, and those tags are copier answers,
# so its PRs would fight the next `copier update`.{% if 'docker' in stacks and not docker_stacks %} A Compose-only repo has no Dockerfile
# and its images are yours, so it gets the docker-compose ecosystem below.{% endif %}
# `commit-message` gives each PR a Conventional Commits title, `chore(deps): bump ...`, which
# the pr-title workflow checks.
version: 2

# Actions and hook revs are all CI and dev tooling, so they share one weekly PR. Fewer
# PRs means fewer branches to bring up to date, one after another, where main requires it.
multi-ecosystem-groups:
  actions-and-hooks:
    schedule: {interval: weekly}
    # Members of a group can't set commit-message; the group sets it for them.
    commit-message: {prefix: chore, include: scope}

updates:
  - package-ecosystem: github-actions
    directory: /
    multi-ecosystem-group: actions-and-hooks
    patterns: ["*"]
    cooldown: {default-days: 7}

  # Version updates only. Dependabot has no security updates for this ecosystem.
  - package-ecosystem: pre-commit
    directory: /
    multi-ecosystem-group: actions-and-hooks
    patterns: ["*"]
    cooldown: {default-days: 7}
{#- An Astro site in site/ is an npm package of its own. #}
{%- for eco, on, dir in [
      ('uv', 'python' in stacks, python_dir),
      ('npm', 'ts' in stacks, ts_dir),
      ('npm', site == 'astro', 'site'),
      ('cargo', 'rust' in stacks, rust_dir),
      ('gomod', 'go' in stacks, go_dir),
    ] if on %}
{% if loop.first and eco != 'gomod' %}
  # Dev tooling lands as one PR and runtime minor and patch bumps as another, so a risky
  # bump is not buried in lint-tool churn. A runtime major gets its own PR.
{%- elif eco == 'gomod' %}
  # No dev-tooling group: go.mod has no development dependencies to split out.
{%- endif %}
  - package-ecosystem: {{eco}}
    directory: {{'/' if dir == '.' else '/' ~ dir}}
    schedule: {interval: weekly}
    cooldown: {default-days: 7}
    commit-message: {prefix: chore, include: scope}
    groups:
      runtime:
        dependency-type: production
        update-types: [minor, patch]
        patterns: ["*"]
{%- if eco != 'gomod' %}
      dev-tooling:
        dependency-type: development
        update-types: [minor, patch]
        patterns: ["*"]
{%- if eco == 'npm' %}
      # Advisories arrive outside the weekly window and ignore the group above, so
      # without this each one opens its own pull request and its own CI run.
      security:
        applies-to: security-updates
        patterns: ["*"]
{%- endif %}
{%- endif %}
{%- endfor %}

{%- if 'docker' in stacks and not docker_stacks %}
  # The images compose.yaml names, tag and digest together.
  - package-ecosystem: docker-compose
    directory: /
    schedule: {interval: weekly}
    cooldown: {default-days: 7}
    commit-message: {prefix: chore, include: scope}
{%- endif %}
