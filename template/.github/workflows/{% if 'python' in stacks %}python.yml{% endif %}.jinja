{% from 'includes/triggers.jinja' import push_and_pr -%}
name: python

on:
{{- push_and_pr(python_dir, 'python') }}
{%- if kind == 'data-pipeline' %}
  # Weekly, to catch a publisher revising its data. This is the only run that sets TRIPWIRE.
  schedule:
    - cron: "0 6 * * 1"
{%- endif %}
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  # The event is in the group because a queued run replaces a pending one in its group
  # whatever cancel-in-progress says, so a push to main must not wait beside the weekly run.
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}-${{ github.event_name }}{% endraw %}
  # Only a newer push to the same pull request cancels a run. A push to main must not cancel
  # the weekly scheduled run, or that week's revision report is lost.
  cancel-in-progress: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}

env:
  # uv checks every package against OSV's malware advisories before its code
  # runs, and fails if OSV is unreachable. The preview flag only silences the
  # "experimental" warning.
  UV_MALWARE_CHECK: "1"
  UV_PREVIEW_FEATURES: malware-check

jobs:
  check:
    name: "python: lint, types, {% if kind == 'data-pipeline' %}pipeline, {% endif %}tests"
    if: github.event_name != 'pull_request' || !github.event.pull_request.draft
    runs-on: ubuntu-latest
    timeout-minutes: 10
{%- if kind == 'library' %}
    # Every version from requires-python up: a library runs on interpreters its
    # author doesn't use.
    strategy:
      fail-fast: false
      matrix:
        python: [{% for m in range(python_min.split('.')[1] | int, python_version.split('.')[1] | int + 1) %}"3.{{ m }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if python_dir != '.' %}
    # Only `run:` steps take this. setup-uv needs no path: its cache glob is **/uv.lock,
    # which finds a nested lockfile.
    defaults:
      run:
        working-directory: {{ python_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          enable-cache: true
          version: "{{ uv_version }}"
{%- if kind == 'library' %}
          python-version: {% raw %}${{ matrix.python }}{% endraw %}
{%- endif %}

      - run: uv sync --locked
      # Checks every locked dependency, dev group included, against the OSV database
      # for known vulnerabilities and deprecated or quarantined projects. Still
      # experimental in uv, hence the preview flag.
      - run: uv audit --locked --preview-features audit-command

      - run: uv run ruff check --output-format=github
      - run: uv run ruff format --check
      - run: uv run ty check
{%- if kind == 'data-pipeline' %}

      # The committed fetch log, before fetch appends to it, for the revisions report below.
      - run: cp data/fetches.jsonl "$RUNNER_TEMP/fetches-before.jsonl" 2>/dev/null || touch "$RUNNER_TEMP/fetches-before.jsonl"

      # Runs the pipeline against the URLs in sources.toml, not a fixture. Keep each URL a
      # small cut of its source so this stays fast.
      - id: fetch
        run: uv run {{ slug }} fetch
      # The sources whose bytes changed since the committed log. Weekly only: on a pull
      # request, a revision is noise.
      - if: github.event_name == 'schedule'
        run: uv run {{ slug }} revisions "$RUNNER_TEMP/fetches-before.jsonl" >"$RUNNER_TEMP/revisions.md"
      - run: uv run {{ slug }} build
      - run: uv run {{ slug }} validate

      # tests/test_published.py fails, not skips, when the output is missing. The
      # literal-value tripwire runs only on the weekly schedule, so a publisher revision
      # fails that run instead of a PR.
      - run: uv run pytest{% if codecov %} --cov --cov-report=xml{% endif %}
        env:
          PIPELINE_OUTPUT_REQUIRED: "1"
          TRIPWIRE: {% raw %}${{ github.event_name == 'schedule' && '1' || '' }}{% endraw %}

      # Fetch records only: URL, timestamp, checksum, byte count, vintage. They hold
      # no source values, so the artifact redistributes nothing (see ATTRIBUTION.md).
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        # After a failed build or validate too, but not when fetch never ran.
        if: {% raw %}${{ !cancelled() && steps.fetch.outcome == 'success' }}{% endraw %}
        with:
          name: fetch-records
          path: {% if python_dir != '.' %}{{ python_dir }}/{% endif %}data/raw/*.fetch.json
          if-no-files-found: error
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        if: {% raw %}${{ !cancelled() && github.event_name == 'schedule' && steps.fetch.outcome == 'success' }}{% endraw %}
        with:
          name: revisions
          path: {% raw %}${{ runner.temp }}{% endraw %}/revisions.md
{%- else %}
      - run: uv run pytest{% if codecov %} --cov --cov-report=xml{% endif %}
{%- endif %}
{%- if codecov %}

      # Dependabot pull requests get no secrets, so their upload fails without failing CI.
      - uses: codecov/codecov-action@303a32d7a59b442fa8d48b6a1cc6825c09c847a5 # v7.1.1
{%- if kind == 'library' %}
        # Once per run: every matrix job measures the same code.
        if: matrix.python == '{{ python_version }}'
{%- endif %}
        with:
          token: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
          files: {% if python_dir != '.' %}{{ python_dir }}/{% endif %}coverage.xml
{%- if 'ts' in stacks %}
          flags: python
{%- endif %}
{%- endif %}
{%- if kind == 'data-pipeline' %}

  revisions:
    # Weekly only. Comments on one open issue when a publisher served new bytes for a
    # source the committed fetch log already had. The only job that may write issues.
    name: report revised sources
    needs: check
    if: {% raw %}${{ !cancelled() && github.event_name == 'schedule' }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      issues: write
    steps:
      # Missing when fetch failed: the check job already reports that.
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        continue-on-error: true
        with:
          name: revisions
          path: {% raw %}${{ runner.temp }}{% endraw %}/revisions
      - name: comment on the revisions issue
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          GH_REPO: {% raw %}${{ github.repository }}{% endraw %}
        run: |
          report="$RUNNER_TEMP/revisions/revisions.md"
          [ -s "$report" ] || exit 0
          title="Source data revised upstream"
          {
            echo "The weekly run fetched new bytes for these sources:"
            echo
            cat "$report"
            echo
            echo "Run \`just pipeline\` and commit \`{% if python_dir != '.' %}{{ python_dir }}/{% endif %}data/fetches.jsonl\` to record them."
          } >"$RUNNER_TEMP/body.md"
          issue=$(gh issue list --state open --author app/github-actions --search "in:title \"$title\"" --json number -q '.[0].number')
          if [ -n "$issue" ]; then
            gh issue comment "$issue" --body-file "$RUNNER_TEMP/body.md"
          else
            gh issue create --title "$title" --body-file "$RUNNER_TEMP/body.md"
          fi
{%- endif %}
{%- if publish_to_pypi %}

  api:
    # Fails when the public API lost or changed something since the last git tag,
    # so a breaking change shows before it ships. Passes when there is no tag yet.
    name: "python: API breaks since the last tag"
    if: github.event_name != 'pull_request' || !github.event.pull_request.draft
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # Full history and tags: griffe reads the last tag's code from git.
          fetch-depth: 0
          persist-credentials: false

      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "{{ uv_version }}"

      # Reads the source without importing it, so the package needs no install. Runs
      # from the root: griffe resolves --search against the repository root at the tag.
      - run: uvx griffe@{{ griffe_version }} check --search {{ python_dir if python_layout == 'flat' else ('' if python_dir == '.' else python_dir ~ '/') ~ 'src' }} --format github {{ module_name }}
{%- endif %}
