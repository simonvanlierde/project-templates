name: advisories

# The stack workflows audit dependencies on push and pull request, and zizmor audits
# workflows. A new advisory can land against a lockfile or action with no commit here, so
# this audits again every Monday. A failed scheduled run opens one issue, or comments on the
# open one.
on:
  schedule:
    - cron: "23 5 * * 1" # Mondays, 05:23 UTC
  workflow_dispatch:

permissions:
  contents: read

env:
  # The action installs the newest prek unless told otherwise.
{%- if dependency_bot == 'renovate' %}
  # renovate: datasource=github-releases depName=j178/prek
{%- else %}
  # Dependabot cannot read this pin; template updates refresh it.
{%- endif %}
  PREK_VERSION: 0.5.7

jobs:
  actions:
    name: "actions: zizmor"
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: j178/prek-action@44924fe9ef4a6f88253c4b6b1bf11c689d3ce53d # v3.1.0
        with:
          prek-version: {% raw %}${{ env.PREK_VERSION }}{% endraw %}
          extra-args: zizmor --all-files
          cache: false
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
{%- if 'python' in stacks %}
  python:
    name: "python: uv audit"
    runs-on: ubuntu-latest
    timeout-minutes: 10
{%- if python_dir != '.' %}
    defaults:
      run:
        working-directory: {{ python_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          version: "{{ uv_version }}"
      - run: uv audit --locked --preview-features audit-command
{%- endif %}
{%- if 'ts' in stacks %}
  ts:
    name: "ts: pnpm audit"
    runs-on: ubuntu-latest
    timeout-minutes: 10
{%- if ts_dir != '.' %}
    defaults:
      run:
        working-directory: {{ ts_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
{%- if ts_dir != '.' %}
        with:
          package_json_file: {{ ts_dir }}/package.json
{%- endif %}
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{ node_version }}"
      - run: pnpm audit --prod --audit-level=moderate
{%- endif %}
{%- if 'rust' in stacks %}
  rust:
    name: "rust: cargo deny advisories"
    runs-on: ubuntu-latest
    timeout-minutes: 10
{%- if rust_dir != '.' %}
    defaults:
      run:
        working-directory: {{ rust_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: taiki-e/install-action@1919c4a95903d2c33e4a221102edca87309fc14b # v2.89.0
        with:
          tool: cargo-deny
          fallback: none
      - run: cargo deny check advisories
{%- endif %}
{%- if 'go' in stacks %}
  go:
    name: "go: govulncheck"
    runs-on: ubuntu-latest
    timeout-minutes: 10
{%- if go_dir != '.' %}
    defaults:
      run:
        working-directory: {{ go_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: {{ '' if go_dir == '.' else go_dir ~ '/' }}go.mod
          cache-dependency-path: {{ '' if go_dir == '.' else go_dir ~ '/' }}go.sum
      - run: go tool govulncheck ./...
{%- endif %}

  notify:
    # Scheduled runs only. Opens one issue, or comments on the open one, when an audit fails.
    # The only job that may write issues.
    name: "advisories: report failure"
    needs: {{ ['actions'] + (['python', 'ts', 'rust', 'go'] | select('in', stacks) | list) }}
    # A job that runs past timeout-minutes ends cancelled, not failed.
    if: always() && github.event_name == 'schedule' && (contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled'))
    permissions:
      issues: write # opens or comments on the failure issue
    uses: $/.github/workflows/report-failure.yml
    with:
      title: Weekly advisory audit failed
