{%- set slug_ = slug | replace('.', '-') | replace('_', '-') -%}
name: Retire preview

# Deletes the preview Worker of a pull request that closes or turns draft, and sweeps
# daily for any that were missed. The README's "Pull request previews" has the rest.
on:
  pull_request:
    types: [closed, converted_to_draft]
  schedule:
    - cron: "17 4 * * *"
  workflow_dispatch:
    inputs:
      prs:
        description: PR numbers to retire, separated by spaces. Leave empty to run the daily sweep.
        required: false

permissions:
  contents: read

jobs:
  retire:
    name: Retire
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    environment: preview
    # One job per Worker name prefix, each in its preview job's group, so a retire waits for
    # that deploy in flight and the two kinds never cancel each other's pending runs.
    strategy:
      fail-fast: false
      matrix:
        include:
{%- if 'ts' in stacks and ts_kind == 'web-app' %}
          - { slug: {{ slug_ }}, group: preview }
{%- endif %}
{%- if site != 'none' %}
          - { slug: {{ slug_ }}-site, group: preview-site }
{%- endif %}
    concurrency:
      group: {% raw %}${{ matrix.group }}-${{ github.event.pull_request.number || github.run_id }}{% endraw %}
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: read # the sweep reads each PR's state
    steps:
      - name: Check credentials
        id: gate
        env:
          TOKEN: {% raw %}${{ secrets.CLOUDFLARE_API_TOKEN }}{% endraw %}
        run: |
          if [ -z "$TOKEN" ]; then
            echo "::notice::Nothing to retire: CLOUDFLARE_API_TOKEN is not set."
            echo "run=false" >> "$GITHUB_OUTPUT"
          else
            echo "run=true" >> "$GITHUB_OUTPUT"
          fi

      # The base branch's script: a closed pull request may have no merge ref left.
      - if: steps.gate.outputs.run == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {% raw %}${{ github.event.pull_request.base.ref }}{% endraw %}
          sparse-checkout: .github/scripts
          persist-credentials: false

      - if: steps.gate.outputs.run == 'true'
        name: Delete the preview Workers
        env:
          CLOUDFLARE_API_TOKEN: {% raw %}${{ secrets.CLOUDFLARE_API_TOKEN }}{% endraw %}
          CLOUDFLARE_ACCOUNT_ID: {% raw %}${{ secrets.CLOUDFLARE_ACCOUNT_ID }}{% endraw %}
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
          PRS: {% raw %}${{ github.event.pull_request.number || inputs.prs }}{% endraw %}
          SLUG: {% raw %}${{ matrix.slug }}{% endraw %}
        run: .github/scripts/preview-retire.sh
