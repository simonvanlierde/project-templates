{%- set py = 'python' in stacks and kind == 'library' -%}
{%- set ts = 'ts' in stacks and ts_kind == 'library' -%}
{%- set rs = 'rust' in stacks and rust_kind == 'library' -%}
{%- set go = 'go' in stacks and go_kind == 'library' -%}
name: property

# The property tests at length once a week, with the same `just <stack>-property` and
# `just go-fuzz` recipes you run by hand. The test job runs them briefly on every
# change; this run tries far more inputs. A failing input fails the job. Run it from the
# Actions tab with "Run workflow" after you change the tests.
on:
  schedule:
    - cron: "17 4 * * 1"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: false

jobs:
{%- if py %}
  python:
    name: "property: python"
    runs-on: ubuntu-latest
    timeout-minutes: 60
{%- if python_dir != '.' %}
    # Only `run:` steps take this. just finds the root justfile from here.
    defaults:
      run:
        working-directory: {{ python_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          enable-cache: true
          version: "{{ uv_version }}"

      - uses: taiki-e/install-action@ab6895351a88b908e96a4697860d4ffea5e57dbe # v2.87.27
        with:
          tool: just@{{ just_version }}

      - run: uv sync --locked
      - run: just py-property
{%- endif %}
{%- if ts %}
  ts:
    name: "property: ts"
    runs-on: ubuntu-latest
    timeout-minutes: 60
{%- if ts_dir != '.' %}
    # Only `run:` steps take this. Point the setup actions at the package separately.
    defaults:
      run:
        working-directory: {{ ts_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
{%- if ts_dir != '.' %}
        with:
          package_json_file: {{ ts_dir }}/package.json
{%- endif %}

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{ node_version }}"
          cache: pnpm
{%- if ts_dir != '.' %}
          cache-dependency-path: {{ ts_dir }}/pnpm-lock.yaml
{%- endif %}

      - run: pnpm install --frozen-lockfile

      - uses: taiki-e/install-action@ab6895351a88b908e96a4697860d4ffea5e57dbe # v2.87.27
        with:
          tool: just@{{ just_version }}

      - run: just ts-property
{%- endif %}
{%- if rs %}
  rust:
    name: "property: rust"
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: dtolnay/rust-toolchain@683b588c487a69d01f6c6ddf40f036ff682cc2c8 # v1
        with:
          toolchain: stable

      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2
{%- if rust_dir != '.' %}
        with:
          workspaces: {{ rust_dir }}
{%- endif %}

      - uses: taiki-e/install-action@ab6895351a88b908e96a4697860d4ffea5e57dbe # v2.87.27
        with:
          tool: just@{{ just_version }}

      - run: just rs-property
{%- endif %}
{%- if go %}
  go:
    name: "property: go"
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: {{ go_dir ~ '/' if go_dir != '.' else '' }}go.mod
          cache-dependency-path: {{ go_dir ~ '/' if go_dir != '.' else '' }}go.sum

      - uses: taiki-e/install-action@ab6895351a88b908e96a4697860d4ffea5e57dbe # v2.87.27
        with:
          tool: just@{{ just_version }}

      - run: just go-fuzz
      # The failing input, which `go test` reads back from testdata/fuzz/ to replay it.
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        if: failure()
        with:
          name: fuzz-inputs
          path: {{ go_dir ~ '/' if go_dir != '.' else '' }}testdata/fuzz/
{%- endif %}
