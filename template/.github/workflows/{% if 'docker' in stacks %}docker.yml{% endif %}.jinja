{#- The build and push jobs share one matrix and one smoke test. #}
{%- macro matrix(push=false) %}
{%- for stack, name, dir in [
      ('python', 'api', python_dir),
      ('ts', 'web', ts_dir),
    ] if stack in docker_stacks %}
{%- set suffix = '' if docker_stacks | length == 1 else name %}
          - stack: {{ stack }}
            context: {{ dir }}
            tag: {{ slug }}{% if suffix %}-{{ suffix }}{% endif %}:ci
{%- if push %}
            image: {% raw %}ghcr.io/${{ github.repository }}{% endraw %}{% if suffix %}/{{ suffix }}{% endif %}
{%- endif %}
{%- endfor %}
{%- endmacro %}
{%- macro smoke_test() %}
      - name: smoke test
        run: |-
          docker run -d --name ci -p {{ app_port }}:{{ app_port }} {% raw %}${{ matrix.tag }}{% endraw %}
          ok=""
          for _ in $(seq 1 30); do
            if curl -fsS "http://127.0.0.1:{{ app_port }}/health"; then ok=1; break; fi
            sleep 1
          done
          docker logs ci
          docker rm -f ci
          test -n "$ok" || { echo "::error::/health never answered"; exit 1; }
{%- endmacro -%}
name: docker

on:
  push:
    branches: [main]
{%- if publish_to_ghcr %}
    tags: ["v*"]
{%- endif %}
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  build:
    name: build
{%- if publish_to_ghcr %}
    # Builds and runs the image with no write scopes. `permissions` takes no expression,
    # so only a separate push job keeps packages: write and id-token: write away from a
    # pull request's Dockerfile steps and the dependencies they install.
    if: github.event_name == 'pull_request' && !github.event.pull_request.draft
{%- else %}
    # Build-only. To push, set publish_to_ghcr and re-run copier update.
    if: github.event_name != 'pull_request' || !github.event.pull_request.draft
{%- endif %}
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      # One image per containerized stack, each built from its own context.
      fail-fast: false
      matrix:
        include:
{{- matrix() }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1

      - uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: {% raw %}${{ matrix.context }}{% endraw %}
          # Scoped per stack: two images sharing the default gha scope would evict each
          # other's layers.
          cache-from: {% raw %}type=gha,scope=${{ matrix.stack }}{% endraw %}
{%- if publish_to_ghcr %}
          # No cache-to: this job runs on pull requests only, and a cache saved from a pull
          # request is dropped on merge. The push job below fills the shared scope.
{%- else %}
          # Export only on push. A cache saved from a pull request is readable by that PR
          # alone and dropped on merge. mode=max there would upload hundreds of MB that
          # nothing reads, evicting main's cache.
          cache-to: {% raw %}${{ github.event_name == 'push' && format('type=gha,mode=max,scope={0}', matrix.stack) || '' }}{% endraw %}
{%- endif %}
          push: false
          load: true # so the smoke test below can run it
          tags: {% raw %}${{ matrix.tag }}{% endraw %}
          # No provenance/sbom: the docker exporter cannot load attestations, and they only
          # matter once the image reaches a registry.

      # An image that cannot start is not a passing build. Matrix jobs get their
      # own runner, so both images can use {{ app_port }}.
{{- smoke_test() }}
{%- if publish_to_ghcr %}

  push:
    # The write half: builds and smoke-tests again, then pushes from the tested build's
    # cache, so only an image that answered /health reaches the registry.
    name: push
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    # Job-level permissions replace the workflow-level grant, so restate contents.
    permissions:
      contents: read
      packages: write
      id-token: write # keyless signing for the provenance attestation
      attestations: write
    strategy:
      # The build job's matrix again, plus the registry image name.
      fail-fast: false
      matrix:
        include:
{{- matrix(push=true) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1

      # Build to the local store and prove the image starts before the registry login puts
      # a credential on this runner. This job runs on push only, so it fills the per-stack
      # cache.
      - uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: {% raw %}${{ matrix.context }}{% endraw %}
          cache-from: {% raw %}type=gha,scope=${{ matrix.stack }}{% endraw %}
          cache-to: {% raw %}type=gha,mode=max,scope=${{ matrix.stack }}{% endraw %}
          push: false
          load: true # so the smoke test below can run it
          tags: {% raw %}${{ matrix.tag }}{% endraw %}
{{ smoke_test() }}

      - uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      # No type=ref,event=pr: this job never runs on a pull request.
      - id: meta
        uses: docker/metadata-action@dc802804100637a589fabce1cb79ff13a1411302 # v6.2.0
        with:
          images: {% raw %}${{ matrix.image }}{% endraw %}
          tags: |
            type=ref,event=branch
            type=semver,pattern={% raw %}{{version}}{% endraw %}
            type=semver,pattern={% raw %}{{major}}.{{minor}}{% endraw %}
            type=sha

      # Repeats the build above on the same builder, so every layer resolves
      # from its cache: the pushed image is the smoke-tested one, plus the
      # attestation manifests only a registry can hold.
      - id: build
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: {% raw %}${{ matrix.context }}{% endraw %}
          cache-from: {% raw %}type=gha,scope=${{ matrix.stack }}{% endraw %}
          push: true
          tags: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}
          labels: {% raw %}${{ steps.meta.outputs.labels }}{% endraw %}
          provenance: mode=max
          sbom: true

      - uses: actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8 # v4.2.2
        with:
          subject-name: {% raw %}${{ matrix.image }}{% endraw %}
          subject-digest: {% raw %}${{ steps.build.outputs.digest }}{% endraw %}
          push-to-registry: true
{%- endif %}
