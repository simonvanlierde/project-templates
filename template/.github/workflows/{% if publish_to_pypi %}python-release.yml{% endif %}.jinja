{% from 'includes/create-release.jinja' import create_release -%}
name: python release

# Trusted publishing: no API token. Configure the publisher once at
# https://pypi.org/manage/account/publishing/ for repo {{ github_user }}/{{ slug }},
# workflow `python-release.yml`, environment `pypi`.
#
# In the repo's Settings > Environments, limit `pypi` to tags matching `v*` and add
# yourself as a required reviewer. Otherwise anyone who can push a branch can
# dispatch an edited copy of this workflow and publish from it.
#
# The build job builds the distributions and installs nothing but uv, so no test
# dependency runs where dist/ is made. The test job re-runs the full suite, since a
# release tag can point at a commit that never went green, then runs it against the
# built wheel, the only place packaging faults such as a wrong module name show up.
#
# `id-token: write` exposes an OpenID Connect (OIDC) request token to every step
# in its job, so publish is a separate job that runs no project code.
#
# After PyPI, the release job checks every attestation, attaches distributions, a
# CycloneDX SBOM and their provenance to a draft, then publishes the draft. Immutable
# releases accept no assets after publication. Each asset carries its bundle as
# `<asset>.intoto.jsonl`, the name Scorecard's Signed-Releases check scores highest.

# No workflow_dispatch: a manual run can target any branch, and neither trusted
# publishing nor the environment checks which ref it publishes.
on:
  push:
    tags: ["v[0-9]+.[0-9]+.[0-9]+"]

permissions:
  contents: read

# One group per release tag: a second run for the same tag waits, and no release
# cancels or replaces another.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: false

env:
  # As in python.yml: uv checks every package against OSV's malware advisories before
  # its code runs. The preview flag only silences the "experimental" warning.
  UV_MALWARE_CHECK: "1"
  UV_PREVIEW_FEATURES: malware-check,sbom-export

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    outputs:
      digest: {% raw %}${{ steps.digest.outputs.value }}{% endraw %}
{%- if python_dir != '.' %}
    defaults:
      run:
        working-directory: {{ python_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # Publish only a tag signed with a key in .github/allowed_signers on the default
      # branch: .github/scripts/verify-tag.sh says why.
      - name: refuse a tag not signed with an allowed key
        env:
          TAG: {% raw %}${{ github.ref_name }}{% endraw %}
          DEFAULT_BRANCH: {% raw %}${{ github.event.repository.default_branch }}{% endraw %}
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: bash "$GITHUB_WORKSPACE/.github/scripts/verify-tag.sh" --fetch "$TAG" "origin/$DEFAULT_BRANCH"

      # No cache: an entry written from any branch is restorable here, which
      # would put attacker-controlled bytes into the wheel this workflow signs.
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          enable-cache: false
          version: "{{ uv_version }}"

      # The wheel takes its version from pyproject.toml, not the tag: refuse a mismatch.
      - run: test "$(uv version --short)" = "${GITHUB_REF_NAME#v}"
{%- if web_app %}

      # The app shows package.json's version, so the tag must name the same one.
      - name: refuse a tag that differs from package.json
        run: |
          app=$(node -p 'require(process.env.GITHUB_WORKSPACE + "/{{ ts_dir }}/package.json").version')
          [ "$app" = "${GITHUB_REF_NAME#v}" ] || { echo "::error::{{ ts_dir ~ '/' if ts_dir != '.' else '' }}package.json is at $app, not ${GITHUB_REF_NAME#v}"; exit 1; }
{%- endif %}

      # Validate and save the notes before PyPI publishes anything.
      - run: '"$GITHUB_WORKSPACE/.github/scripts/release-notes.sh" "$GITHUB_REF_NAME" "$GITHUB_WORKSPACE/CHANGELOG.md" >"$RUNNER_TEMP/notes.md"'

      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: release-notes
          path: {% raw %}${{ runner.temp }}{% endraw %}/notes.md

      - run: uv build

      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: dist
          path: {{ python_dir }}/dist/

      # The SBOM lists the locked runtime dependencies, extras included, so the versions we
      # tested with, not what a user will resolve. The wheel is pure Python and carries none
      # of its own.
      - name: export and check the release SBOM
        run: |
          set -euo pipefail
          mkdir sbom
          sbom="sbom/$(basename dist/*.tar.gz).cdx.json"
          uv export --locked --no-default-groups --all-extras --format cyclonedx1.5 -o "$sbom"
          count=$(jq -ers '
            if length == 1 and (.[0] |
              .bomFormat == "CycloneDX" and .specVersion == "1.5" and
              (.metadata.component.name | type == "string" and length > 0) and
              (.components | type == "array" and all(.[]; (.name | type == "string" and length > 0))))
            then .[0].components | length
            else error("invalid CycloneDX SBOM")
            end
          ' "$sbom")
          # uv puts the project in metadata.component, so a project with no dependencies has no components.
          if [ "$count" -eq 0 ]; then
            requirements=$(uv export --locked --no-default-groups --all-extras --no-hashes --no-annotate --no-header --no-emit-project -q)
            if [ -n "$requirements" ]; then
              echo "::error::The release SBOM has no components but the lockfile exports dependencies"
              exit 1
            fi
          fi

      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: sbom
          path: {{ python_dir }}/sbom/
{%- if python_release_asset_dirs %}

      - name: collect extra release assets
        run: |
          set -euo pipefail
          script="$GITHUB_WORKSPACE/.github/scripts/build-release-assets.sh"
          if [[ -f "$script" ]]; then bash "$script"; fi
          export LC_ALL=C
          shopt -s nullglob dotglob
          declare -A seen=()
          payload_count=0
          for file in dist/* sbom/*; do
            name=${file##*/}
            seen["${name,,}"]=1
            # An extra named <sdist>.sbom would share the sdist's SBOM bundle name.
            if [[ "$file" == dist/*.tar.gz ]]; then seen["${name,,}.sbom"]=1; fi
            (( ++payload_count ))
          done
          for dir in {{ python_release_asset_dirs | join(' ') }}; do
            if [[ "$(realpath -e -- "$dir")" != "$PWD/$dir" ]]; then
              printf '::error::Extra release asset directory %s is missing or a symlink\n' "$dir"
              exit 1
            fi
            files=("$dir"/*)
            if (( {% raw %}${#files[@]}{% endraw %} == 0 )); then
              printf '::error::Extra release asset directory %s is empty\n' "$dir"
              exit 1
            fi
            # GitHub allows 1000 assets. Each payload has a bundle, and the sdist has one more.
            (( payload_count += {% raw %}${#files[@]}{% endraw %} ))
            if (( payload_count > 499 )); then
              echo "::error::A release with attestations can carry at most 499 payload files"
              exit 1
            fi
            for file in "${files[@]}"; do
              name=${file##*/}
              key=${name,,}
              if [[ ! -f "$file" || -L "$file" || ! "$name" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ || "$name" == *. || "$key" == *.intoto.jsonl ]]; then
                printf '::error::Invalid extra release asset %s\n' "$file"
                exit 1
              fi
              # Appending .intoto.jsonl must fit within Linux's 255-byte filename limit.
              if (( {% raw %}${#name}{% endraw %} > 242 )); then
                printf '::error::Extra release asset name %s must be at most 242 bytes\n' "$name"
                exit 1
              fi
              size=$(wc -c < "$file")
              if (( size >= 2147483648 )); then
                printf '::error::Extra release asset %s must be under 2 GiB\n' "$file"
                exit 1
              fi
              if [[ ${seen[$key]+yes} ]]; then
                printf '::error::Duplicate release asset name %s\n' "$name"
                exit 1
              fi
              seen["$key"]=1
            done
          done
{%- for dir in python_release_asset_dirs %}
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: release-extra-{{ loop.index }}
          path: {{ python_dir }}/{{ dir }}/
          if-no-files-found: error
{%- endfor %}
{%- endif %}

      # What publish signs and uploads must be what was built here, whatever the test job ran.
      - id: digest
        run: |
          set -euo pipefail
          value=$(sha256sum dist/* sbom/*{% for dir in python_release_asset_dirs %} {{ dir }}/*{% endfor %} | sha256sum | cut -d' ' -f1)
          echo "value=$value" >>"$GITHUB_OUTPUT"

  # Publish only what passes, on the exact commit being released. The dev group runs
  # here after the build has uploaded the files publish will check.
  test:
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 15
{%- if python_dir != '.' %}
    defaults:
      run:
        working-directory: {{ python_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          enable-cache: false
          version: "{{ uv_version }}"
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: dist
          path: {% if python_dir != '.' %}{{ python_dir }}/{% endif %}dist/
      - run: uv sync --locked
      - run: uv run ruff check
      - run: uv run ruff format --check
      - run: uv run ty check
      - run: uv run pytest

      # The suite again, against the wheel instead of src/. --no-project stops uv
      # resolving the local tree, so the import can only come from dist/. The test
      # tools come from uv.lock, with their hashes, not from whatever PyPI serves now.
      - run: |
          uv export --locked --only-group dev --no-emit-project >"$RUNNER_TEMP/dev.txt"
          uv run --isolated --no-project --with dist/*.whl --with-requirements "$RUNNER_TEMP/dev.txt" pytest tests

  publish:
    needs: [build, test]
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment: pypi
    # Job-level permissions replace the workflow-level grant, so restate contents.
    permissions:
      contents: read
      id-token: write # required for trusted publishing, and to sign the attestation
      attestations: write
      artifact-metadata: write # asked for by actions/attest; used only when it pushes to a registry
    steps:
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: dist
          # No checkout here: dist/ at the root, where the publish action looks.
          path: dist/
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: sbom
          path: sbom/
{%- for dir in python_release_asset_dirs %}
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: release-extra-{{ loop.index }}
          path: {{ dir }}/
{%- endfor %}
      - name: refuse artifacts that changed after the build
        env:
          EXPECTED: {% raw %}${{ needs.build.outputs.digest }}{% endraw %}
        run: |
          set -euo pipefail
          actual=$(sha256sum dist/* sbom/*{% for dir in python_release_asset_dirs %} {{ dir }}/*{% endfor %} | sha256sum | cut -d' ' -f1)
          test "$actual" = "$EXPECTED"
      # A signed build-provenance attestation per file, so anyone can check where a wheel
      # was built: `gh attestation verify <file> --repo <owner>/<repo>`. This job runs no
      # project code, so the token that signs it never reaches the test suite.
      - uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
        id: attest
        with:
          subject-path: |
            dist/*
            sbom/*
{%- for dir in python_release_asset_dirs %}
            {{ dir }}/*
{%- endfor %}
      # sbom-path takes one literal path, not a glob as subject-path does.
      - id: sbom
        run: echo "path=$(echo sbom/*.cdx.json)" >>"$GITHUB_OUTPUT"
      # The SBOM, attested against the sdist it was exported alongside.
      - uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
        id: attest-sbom
        with:
          subject-path: dist/*.tar.gz
          sbom-path: {% raw %}${{ steps.sbom.outputs.path }}{% endraw %}
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: provenance
          overwrite: true # a re-run of this job uploads it again
          path: {% raw %}${{ steps.attest.outputs.bundle-path }}{% endraw %}
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: sbom-attestation
          overwrite: true # a re-run of this job uploads it again
          path: {% raw %}${{ steps.attest-sbom.outputs.bundle-path }}{% endraw %}
      # A file PyPI already has must be this build's: skip-existing below would pass over a
      # different one. Re-run only the failed job, since a new build of the same tag can differ.
      - name: refuse a file PyPI has with other content
        env:
          TAG: {% raw %}${{ github.ref_name }}{% endraw %}
        run: |-
          set -euo pipefail
          code=$(curl -sS -A "{{ slug }} release workflow" -o "$RUNNER_TEMP/pypi.json" -w '%{http_code}' "https://pypi.org/pypi/{{ slug }}/${TAG#v}/json")
          case $code in
            404) exit 0 ;;
            200) ;;
            *) echo "::error::PyPI answered $code"; exit 1 ;;
          esac
          for f in dist/*; do
            remote=$(jq -r --arg n "$(basename "$f")" '.urls[] | select(.filename == $n) | .digests.sha256' "$RUNNER_TEMP/pypi.json")
            [ -z "$remote" ] && continue
            [ "$remote" = "$(sha256sum "$f" | cut -d' ' -f1)" ] || { echo "::error::$f is on PyPI with other content than this build"; exit 1; }
          done
      # skip-existing: a re-run after PyPI took the wheel but not the sdist uploads only the rest.
      - uses: pypa/gh-action-pypi-publish@7245906fb61fa33a13554f9d5fb856fe61758086 # v1.14.3
        with:
          skip-existing: true

  # PyPI already has this version if this job fails: re-run only this job.
  # A leftover draft is deleted first; a published immutable release needs a new version.
  release:
    needs: publish
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: dist
          path: assets/
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: sbom
          path: assets/
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: provenance
          path: provenance/
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: sbom-attestation
          path: sbom-attestation/
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: release-notes
          path: notes/
{%- for dir in python_release_asset_dirs %}
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: release-extra-{{ loop.index }}
          path: {% raw %}${{ runner.temp }}{% endraw %}/release-extra-{{ loop.index }}/
{%- endfor %}
      # No checkout or project code runs with the write token.
      - name: publish the GitHub release
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          GH_REPO: {% raw %}${{ github.repository }}{% endraw %}
          TAG: {% raw %}${{ github.ref_name }}{% endraw %}
        run: |-
          set -euo pipefail
          cd assets
          sdist=$(echo *.tar.gz)
{%- for dir in python_release_asset_dirs %}
          mv -- "$RUNNER_TEMP/release-extra-{{ loop.index }}/"* .
{%- endfor %}
          # One provenance bundle covers every asset; each gets a copy under its own name.
          # The glob also checks that each attest step produced exactly one bundle.
          for f in *; do cp ../provenance/*.json "$f.intoto.jsonl"; done
          cp ../sbom-attestation/*.json "$sdist.sbom.intoto.jsonl"
          # Immutable once published: check every attestation before anything is uploaded.
          for f in *; do
            case $f in *.intoto.jsonl) continue ;; esac
            # The attestation can lag the attest step by a moment.
            for attempt in 1 2 3; do
              gh attestation verify "$f" --repo "$GH_REPO" --bundle "$f.intoto.jsonl" --signer-workflow "$GH_REPO/.github/workflows/python-release.yml" && break
              [ "$attempt" -lt 3 ] && sleep 10 || exit 1
            done
          done
          gh attestation verify "$sdist" --repo "$GH_REPO" --bundle "$sdist.sbom.intoto.jsonl" \
            --predicate-type https://cyclonedx.org/bom --signer-workflow "$GH_REPO/.github/workflows/python-release.yml"
          printf '\nThe SBOM lists the dependency versions this release was tested with, not what an install will resolve.\n' >>../notes/notes.md
          {{ create_release('../notes/notes.md', ' ./*') | indent(10) }}
