name: rust release

# Trusted publishing: no CARGO_REGISTRY_TOKEN. Configure the publisher once at
# https://crates.io/crates/{{ crate_name }}/settings for repo {{ github_user }}/{{ slug }},
# workflow `rust-release.yml`, environment `crates`.
#
# Trusted publishing cannot create a crate: publish 0.1.0 by hand first
# (`cargo publish` with a short-lived API token), then add the publisher.
#
# In the repo's Settings > Environments, limit `crates` to tags matching `v*` and add
# yourself as a required reviewer. Otherwise anyone who can push a branch can
# dispatch an edited copy of this workflow and publish from it.
#
# The build job re-runs the checks, since a release tag can point at a commit that never
# went green, and packages the crate once with `cargo package --locked`.
#
# `id-token: write` exposes an OpenID Connect (OIDC) request token to every step in its
# job. The publish job therefore runs `cargo publish --no-verify`: it compiles nothing,
# so no dependency's build script runs where the token exists.
{%- if rust_kind == 'binary' %}
#
# `binaries` builds an archive per platform, named as `cargo binstall` looks for it
# (see [package.metadata.binstall] in Cargo.toml). publish attests them, then the
# release job checks every attestation, attaches the archives with their bundles as
# `<asset>.intoto.jsonl` (the name Scorecard's Signed-Releases check scores highest) to a
# draft, and publishes the draft. Immutable releases accept no assets after publication.
{%- else %}
#
# A library has no release assets: the release job only publishes the notes.
{%- endif %}

# No workflow_dispatch: a manual run can target any branch, and neither trusted
# publishing nor the environment checks which ref it publishes.
on:
  push:
    tags: ["v[0-9]+.[0-9]+.[0-9]+"]

permissions:
  contents: read

# One group per release tag: a second run for the same tag waits, and no release
# cancels or replaces another.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 20
{%- if rust_dir != '.' %}
    defaults:
      run:
        working-directory: {{ rust_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # Publish only a tag signed with a key in .github/allowed_signers on the default
      # branch: .github/scripts/verify-tag.sh says why.
      - name: refuse a tag not signed with an allowed key
        env:
          TAG: {% raw %}${{ github.ref_name }}{% endraw %}
          DEFAULT_BRANCH: {% raw %}${{ github.event.repository.default_branch }}{% endraw %}
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: bash "$GITHUB_WORKSPACE/.github/scripts/verify-tag.sh" --fetch "$TAG" "origin/$DEFAULT_BRANCH"

      # The crate takes its version from Cargo.toml, not the tag: refuse a mismatch.
      - run: test "$(cargo metadata --no-deps --format-version 1 | jq -r --arg n {{ crate_name }} '.packages[] | select(.name == $n) | .version')" = "${GITHUB_REF_NAME#v}"
{%- if web_app %}

      # The app shows package.json's version, so the tag must name the same one.
      - name: refuse a tag that differs from package.json
        run: |
          app=$(node -p 'require(process.env.GITHUB_WORKSPACE + "/{{ ts_dir }}/package.json").version')
          [ "$app" = "${GITHUB_REF_NAME#v}" ] || { echo "::error::{{ ts_dir ~ '/' if ts_dir != '.' else '' }}package.json is at $app, not ${GITHUB_REF_NAME#v}"; exit 1; }
{%- endif %}

      # Validate and save the notes before crates.io publishes anything.
      - run: '"$GITHUB_WORKSPACE/.github/scripts/release-notes.sh" "$GITHUB_REF_NAME" "$GITHUB_WORKSPACE/CHANGELOG.md" >"$RUNNER_TEMP/notes.md"'

      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: release-notes
          path: {% raw %}${{ runner.temp }}{% endraw %}/notes.md

      # No cache: an entry written from any branch is restorable here, which
      # would put attacker-controlled bytes into what this workflow signs.
      - uses: dtolnay/rust-toolchain@683b588c487a69d01f6c6ddf40f036ff682cc2c8 # v1
        with:
          toolchain: stable
          components: clippy, rustfmt

      - run: cargo fmt --check
      - run: cargo clippy --locked --all-targets --all-features -- -D warnings
      - run: cargo test --locked --all-features

      # Builds the crate from its packaged files, as crates.io users get it, and refuses
      # missing metadata or a dirty tree.
      - run: cargo package --locked
{%- if rust_kind == 'binary' %}

  binaries:
    needs: build
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    timeout-minutes: 20
    strategy:
      fail-fast: true
      matrix:
        include:
          - {os: ubuntu-latest, target: x86_64-unknown-linux-gnu}
          - {os: ubuntu-24.04-arm, target: aarch64-unknown-linux-gnu}
          - {os: macos-latest, target: aarch64-apple-darwin}
          - {os: windows-latest, target: x86_64-pc-windows-msvc}
    defaults:
      run:
        shell: bash
{%- if rust_dir != '.' %}
        working-directory: {{ rust_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: dtolnay/rust-toolchain@683b588c487a69d01f6c6ddf40f036ff682cc2c8 # v1
        with:
          toolchain: stable
          targets: {% raw %}${{ matrix.target }}{% endraw %}

      - name: build and archive
        env:
          TARGET: {% raw %}${{ matrix.target }}{% endraw %}
        run: |-
          set -euo pipefail
          cargo build --release --locked --target "$TARGET"
          mkdir dist
          name={{ crate_name }}
          case $TARGET in
            *windows*) (cd "target/$TARGET/release" && 7z a -tzip "$OLDPWD/dist/$name-$TARGET.zip" "$name.exe") ;;
            *) tar -czf "dist/$name-$TARGET.tar.gz" -C "target/$TARGET/release" "$name" ;;
          esac

      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: dist-{% raw %}${{ matrix.target }}{% endraw %}
          path: {{ rust_dir ~ '/' if rust_dir != '.' }}dist/*
{%- endif %}

  # crates.io has this version once this job passes, and cannot take it back: every
  # check that can fail runs before it.
  publish:
    needs: {{ '[build, binaries]' if rust_kind == 'binary' else 'build' }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment: crates
    # Job-level permissions replace the workflow-level grant, so restate contents.
    permissions:
      contents: read
      id-token: write # required for trusted publishing{{ ', and to sign the attestation' if rust_kind == 'binary' }}
{%- if rust_kind == 'binary' %}
      attestations: write
      artifact-metadata: write # asked for by actions/attest; used only when it pushes to a registry
{%- endif %}
    steps:
{%- if rust_kind == 'binary' %}
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          pattern: dist-*
          merge-multiple: true
          path: dist/
      # Only the four archives of this build: another dist-* artifact in the run would be signed too.
      - run: test "$(export LC_ALL=C; cd dist && printf '%s ' *)" = "{{ crate_name }}-aarch64-apple-darwin.tar.gz {{ crate_name }}-aarch64-unknown-linux-gnu.tar.gz {{ crate_name }}-x86_64-pc-windows-msvc.zip {{ crate_name }}-x86_64-unknown-linux-gnu.tar.gz "
      # A signed build-provenance attestation per archive, so anyone can check where a
      # binary was built: `gh attestation verify <file> --repo <owner>/<repo>`.
      - uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
        id: attest
        with:
          subject-path: dist/*
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: provenance
          overwrite: true # a re-run of this job uploads it again
          path: {% raw %}${{ steps.attest.outputs.bundle-path }}{% endraw %}
{%- endif %}
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: dtolnay/rust-toolchain@683b588c487a69d01f6c6ddf40f036ff682cc2c8 # v1
        with:
          toolchain: stable
      - uses: rust-lang/crates-io-auth-action@3268eb413133e2960fa4ae0e963ca76380c54cd9 # v1.0.6
        id: auth
      # --no-verify: the build job already built the packaged crate. A re-run after crates.io took
      # the upload but this job still failed finds the version and goes on to the release job.
      - name: publish to crates.io
        env:
          CARGO_REGISTRY_TOKEN: {% raw %}${{ steps.auth.outputs.token }}{% endraw %}
        run: |-
          version=${GITHUB_REF_NAME#v}
          if curl -fsS -A "{{ slug }} release workflow" -o /dev/null "https://crates.io/api/v1/crates/{{ crate_name }}/$version"; then
            echo "{{ crate_name }} $version is already on crates.io; leaving it"
          else
            cargo publish --locked --no-verify{{ ' --manifest-path ' ~ rust_dir ~ '/Cargo.toml' if rust_dir != '.' }}
          fi

  # crates.io already has this version if this job fails: re-run only this job.
  # A leftover draft is deleted first; a published immutable release needs a new version.
  release:
    needs: publish
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
    steps:
{%- if rust_kind == 'binary' %}
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          pattern: dist-*
          merge-multiple: true
          path: assets/
      - run: test "$(export LC_ALL=C; cd assets && printf '%s ' *)" = "{{ crate_name }}-aarch64-apple-darwin.tar.gz {{ crate_name }}-aarch64-unknown-linux-gnu.tar.gz {{ crate_name }}-x86_64-pc-windows-msvc.zip {{ crate_name }}-x86_64-unknown-linux-gnu.tar.gz "
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: provenance
          path: provenance/
{%- endif %}
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: release-notes
          path: notes/
      # No checkout or project code runs with the write token.
      - name: publish the GitHub release
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          GH_REPO: {% raw %}${{ github.repository }}{% endraw %}
          TAG: {% raw %}${{ github.ref_name }}{% endraw %}
        run: |-
          set -euo pipefail
{%- if rust_kind == 'binary' %}
          cd assets
          # One provenance bundle covers every asset; each gets a copy under its own name.
          # The glob also checks that the attest step produced exactly one bundle.
          for f in *; do cp ../provenance/*.json "$f.intoto.jsonl"; done
          # Immutable once published: check every attestation before anything is uploaded.
          for f in *; do
            case $f in *.intoto.jsonl) continue ;; esac
            # The attestation can lag the attest step by a moment.
            for attempt in 1 2 3; do
              gh attestation verify "$f" --repo "$GH_REPO" --bundle "$f.intoto.jsonl" && break
              [ "$attempt" -lt 3 ] && sleep 10 || exit 1
            done
          done
          if [ "$(gh release view "$TAG" --json isDraft --jq .isDraft 2>/dev/null)" = true ]; then gh release delete "$TAG" --yes; fi
          gh release create "$TAG" --draft --verify-tag --title "$TAG" --notes-file ../notes/notes.md ./*
{%- else %}
          if [ "$(gh release view "$TAG" --json isDraft --jq .isDraft 2>/dev/null)" = true ]; then gh release delete "$TAG" --yes; fi
          gh release create "$TAG" --draft --verify-tag --title "$TAG" --notes-file notes/notes.md
{%- endif %}
          gh release edit "$TAG" --draft=false
