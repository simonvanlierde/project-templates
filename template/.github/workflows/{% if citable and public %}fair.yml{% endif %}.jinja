name: fair

# fair-software.eu: howfairis scores the public repository on five recommendations (public
# repository, license, registry, citation, checklist) and prints which checks pass. A new
# repo misses the registry and checklist checks until you list it in a registry and earn the
# OpenSSF Best Practices badge, so a score below five does not fail the run. howfairis reads
# GitHub's API without a token, so it runs weekly, not on every pull request.
on:
  schedule:
    - cron: "17 6 * * 3" # Wednesdays, 06:17 UTC
  workflow_dispatch:

permissions:
  contents: read

jobs:
  howfairis:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
        with:
          version: "{{ uv_version }}"
      # howfairis exits 1 below five checks.
      - run: uvx howfairis@0.14.2 https://github.com/{{ github_user }}/{{ slug }}
        continue-on-error: true
