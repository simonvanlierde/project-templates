name: release

# A pushed version tag becomes a GitHub release whose notes are that version's
# CHANGELOG.md section. Releases are immutable, so the notes must be right the first
# time: a tag with no section fails before anything is published. Make the section
# before you tag. If notes validation fails before publication, fix CHANGELOG.md,
# delete the tag (a tags-ruleset bypass is needed) with
# `git tag -d vX.Y.Z && git push origin :refs/tags/vX.Y.Z`, and tag again. After
# publication, release a new patch version.
on:
  push:
    tags: ["v[0-9]+.[0-9]+.[0-9]+"]

permissions:
  contents: read

# One group per tag: a re-pushed tag waits for its running release.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: false

jobs:
  release:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: write # create the release
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # Publish only a tag signed with a key in .github/allowed_signers on the default
      # branch: .github/scripts/verify-tag.sh says why.
      - name: refuse a tag not signed with an allowed key
        env:
          TAG: {% raw %}${{ github.ref_name }}{% endraw %}
          DEFAULT_BRANCH: {% raw %}${{ github.event.repository.default_branch }}{% endraw %}
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          set -euo pipefail
          # checkout fetches the tagged commit, not the annotated tag object that holds the
          # signature. gh lends its token to this fetch alone, which a private repo needs.
          git -c credential.helper= -c 'credential.helper=!gh auth git-credential' fetch --quiet --no-tags --depth=1 --force origin \
            "refs/tags/$TAG:refs/tags/$TAG" "refs/heads/$DEFAULT_BRANCH:refs/remotes/origin/$DEFAULT_BRANCH"
          "$GITHUB_WORKSPACE/.github/scripts/verify-tag.sh" "$TAG" "origin/$DEFAULT_BRANCH"
{%- if web_app %}

      # The app shows package.json's version, so the tag must name the same one.
      - name: refuse a tag that differs from package.json
        env:
          TAG: {% raw %}${{ github.ref_name }}{% endraw %}
        run: |
          app=$(node -p 'require("./{{ ts_dir }}/package.json").version')
          [ "$app" = "${TAG#v}" ] || { echo "::error::{{ ts_dir ~ '/' if ts_dir != '.' else '' }}package.json is at $app, not ${TAG#v}"; exit 1; }
{%- endif %}

      - name: create the release
        env:
          TAG: {% raw %}${{ github.ref_name }}{% endraw %}
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |-
          set -euo pipefail
          .github/scripts/release-notes.sh "$TAG" >"$RUNNER_TEMP/notes.md"
          # A release made by hand before this run is left as it is: immutable releases can't be edited.
          if gh release view "$TAG" >/dev/null 2>&1; then
            echo "release $TAG already exists; leaving it"
            exit 0
          fi
          gh release create "$TAG" --verify-tag --title "$TAG" --notes-file "$RUNNER_TEMP/notes.md"
