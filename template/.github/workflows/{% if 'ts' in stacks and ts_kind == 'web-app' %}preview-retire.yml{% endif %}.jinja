name: Retire preview

# Each pull request previews on its own Worker, {{ slug | replace('.', '-') | replace('_', '-') }}-pr-<number>. A pull request that
# closes or turns draft has that Worker deleted, then the address is fetched to check
# that it no longer serves the build. A daily run deletes the Worker of any pull request
# that is no longer open and ready, in case an event was missed. Run it by hand with a
# list of pull request numbers to retire older previews.
on:
  pull_request:
    types: [closed, converted_to_draft]
  schedule:
    - cron: "17 4 * * *"
  workflow_dispatch:
    inputs:
      prs:
        description: PR numbers to retire, separated by spaces
        required: true

permissions:
  contents: read

concurrency:
  group: preview-{% raw %}${{ github.event.pull_request.number || github.run_id }}{% endraw %}

jobs:
  retire:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
      pull-requests: read
    environment: preview
{%- if ts_dir != '.' %}
    defaults:
      run:
        working-directory: {{ ts_dir }}
{%- endif %}
    steps:
      - name: Work out which pull requests to retire
        id: list
{%- if ts_dir != '.' %}
        # Runs before checkout, when {{ ts_dir }}/ does not exist yet.
        working-directory: .
{%- endif %}
        env:
          CLOUDFLARE_API_TOKEN: {% raw %}${{ secrets.CLOUDFLARE_API_TOKEN }}{% endraw %}
          CLOUDFLARE_ACCOUNT_ID: {% raw %}${{ secrets.CLOUDFLARE_ACCOUNT_ID }}{% endraw %}
          EVENT: {% raw %}${{ github.event_name }}{% endraw %}
          PRS: {% raw %}${{ github.event.pull_request.number || inputs.prs }}{% endraw %}
        run: |
          set -o pipefail
          if [ -z "$CLOUDFLARE_API_TOKEN" ]; then
            echo "::notice::Nothing to retire: CLOUDFLARE_API_TOKEN is not set."
            PRS=
          elif [ "$EVENT" = "schedule" ]; then
            # Backstop for a missed event: every preview Worker in the account. The
            # delete step keeps the ones whose pull request is still open and ready.
            PRS=$(curl -fsS -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
              "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/workers/scripts" \
              | jq -r '.result[].id | select(test("^{{ slug | replace('.', '-') | replace('_', '-') }}-pr-[0-9]+$")) | sub("^.*-pr-"; "")' | sort -un | tr '\n' ' ')
          fi
          echo "prs=$PRS" >> "$GITHUB_OUTPUT"

      - if: steps.list.outputs.prs != ''
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - if: steps.list.outputs.prs != ''
        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
{%- if ts_dir != '.' %}
        with:
          package_json_file: {{ ts_dir }}/package.json
{%- endif %}

      - if: steps.list.outputs.prs != ''
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{ node_version }}"

      - name: Delete each preview Worker
        if: steps.list.outputs.prs != ''
        env:
          CLOUDFLARE_API_TOKEN: {% raw %}${{ secrets.CLOUDFLARE_API_TOKEN }}{% endraw %}
          CLOUDFLARE_ACCOUNT_ID: {% raw %}${{ secrets.CLOUDFLARE_ACCOUNT_ID }}{% endraw %}
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
          EVENT: {% raw %}${{ github.event_name }}{% endraw %}
          PRS: {% raw %}${{ steps.list.outputs.prs }}{% endraw %}
        # pipefail: the default shell takes the pipe's status from tee.
        run: |
          set -o pipefail
          api=https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID
          sub=$(curl -fsS -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" "$api/workers/subdomain" | jq -r '.result.subdomain')
          failed=0
          for pr in $PRS; do
            case "$pr" in *[!0-9]*|'') echo "::error::Not a PR number: $pr"; exit 1 ;; esac
            if [ "$EVENT" = "schedule" ]; then
              # Read the pull request again right before deleting, so a pull request
              # that was reopened since the list was made keeps its preview.
              state=$(gh api "repos/$REPO/pulls/$pr" --jq '.state, .draft' | tr '\n' ' ')
              if [ "$state" = "open false " ]; then
                echo "pr-$pr is open and ready, so its preview stays."
                continue
              fi
            fi
            name="{{ slug | replace('.', '-') | replace('_', '-') }}-pr-$pr"
            # A pull request that never had a preview has no Worker to delete.
            if ! pnpm dlx wrangler@{{ wrangler_version }} delete "$name" --config wrangler.preview.jsonc --force 2>&1 | tee delete.log; then
              grep -Eqi 'not found|does not exist|10007' delete.log || exit 1
              echo "::notice::No Worker $name, so there is no preview to delete."
            fi
            # Check the takedown: the address must stop serving the build.
            url="https://$name.$sub.workers.dev"
            ok=0
            for wait in 2 5 10 20 30; do
              code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$url" || true)
              if [ "$code" != 200 ]; then
                ok=1
                break
              fi
              sleep "$wait"
            done
            if [ "$ok" != 1 ]; then
              echo "::error::$url still serves the preview after the Worker was deleted."
              failed=1
              continue
            fi
            echo "Deleted $name (verified: $url answers $code)" >> "$GITHUB_STEP_SUMMARY"
          done
          exit "$failed"
