{%- set worker = slug | replace('.', '-') | replace('_', '-') ~ '-site' -%}
name: site

# The static page in site/, which `just site` builds into {{ site_out }}/. Every pull request
# and push builds it. A push to main deploys that build to GitHub Pages, and an open, ready
# pull request gets a preview Worker that preview-retire.yml takes down again.
on:
  push:
    branches: [main]
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  # Pull requests only: a newer push to main must not cancel a deploy in flight.
  cancel-in-progress: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}

jobs:
  build:
    name: "site: build"
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: taiki-e/install-action@5488ac5a951645ce95062214902ac4b6bc1a1037 # v2.87.32
        with:
          tool: just@{{ just_version }}

{%- if site == 'astro' %}

      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
        with:
          package_json_file: site/package.json

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{ node_version }}"
{%- else %}

      # Set up here whatever your own `just site` needs (uv, Rust, Node) before it runs.
{%- endif %}
      - run: just site

      # The deploy and preview jobs both ship this one build.
      - uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5.0.0
        with:
          path: {{ site_out }}

  deploy:
    name: "site: deploy"
    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'
    needs: build
    # Never cancelled halfway, so a deploy in flight finishes before the next starts.
    concurrency:
      group: pages
      cancel-in-progress: false
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      pages: write # to deploy to GitHub Pages
      id-token: write # to prove the deployment comes from this workflow
    environment:
      name: github-pages
      url: {% raw %}${{ steps.deploy.outputs.page_url }}{% endraw %}
    steps:
      # The first push to main can come before `just repo-settings` turns Pages on.
      - id: gate
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
        run: |
          if build=$(gh api "repos/$REPO/pages" --jq .build_type 2>gh.err); then
            if [ "$build" = workflow ]; then
              echo "run=true" >> "$GITHUB_OUTPUT"
              exit 0
            fi
          elif ! grep -q 'HTTP 404' gh.err; then
            cat gh.err >&2
            exit 1
          fi
          echo "::notice::GitHub Pages is off or does not deploy from Actions: run just repo-settings."
          echo "run=false" >> "$GITHUB_OUTPUT"

      - if: steps.gate.outputs.run == 'true'
        id: deploy
        uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346 # v5.0.1

  # The same lifecycle as a web app's previews: docs/usage.md#static-site in the template.
  # Fork pull requests never get the token, so they skip with a notice, as does a repo
  # without the secret.
  preview:
    name: "site: preview"
    # Bot pull requests (Renovate, Dependabot) get no preview, so their code never sees the token.
    if: github.event_name == 'pull_request' && !github.event.pull_request.draft && !endsWith(github.event.pull_request.user.login, '[bot]')
    # Shares the site job of preview-retire.yml, so a retire waits for a deploy in flight.
    concurrency:
      group: preview-site-{% raw %}${{ github.event.pull_request.number }}{% endraw %}
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      pull-requests: read
    environment:
      name: preview
      url: {% raw %}${{ steps.upload.outputs.url }}{% endraw %}
    steps:
      - id: gate
        env:
          TOKEN: {% raw %}${{ secrets.CLOUDFLARE_API_TOKEN }}{% endraw %}
          FORK: {% raw %}${{ github.event.pull_request.head.repo.full_name != github.repository }}{% endraw %}
        run: |
          if [ "$FORK" = "true" ] || [ -z "$TOKEN" ]; then
            echo "::notice::Preview skipped: fork PR or CLOUDFLARE_API_TOKEN not set."
            echo "run=false" >> "$GITHUB_OUTPUT"
          else
            echo "run=true" >> "$GITHUB_OUTPUT"
          fi

      # For deploy-worker.sh and wrangler.site.jsonc. The page itself comes from the build job.
      - if: steps.gate.outputs.run == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - if: steps.gate.outputs.run == 'true'
        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
        with:
{%- if 'ts' in stacks %}
          package_json_file: {{ '' if ts_dir == '.' else ts_dir ~ '/' }}package.json
{%- else %}
          version: "{{ pnpm_version }}"
{%- endif %}

      - if: steps.gate.outputs.run == 'true'
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{ node_version }}"

      - if: steps.gate.outputs.run == 'true'
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: github-pages
          path: {% raw %}${{ runner.temp }}{% endraw %}/pages

      # GitHub Pages serves the site under /{{ slug }}/, so the preview does too, and its
      # root redirects there. Search engines should index the production site, not the
      # preview copies.
      - if: steps.gate.outputs.run == 'true'
        run: |
          mkdir -p {{ site_out }}/{{ slug }}
          tar -xf "$RUNNER_TEMP/pages/artifact.tar" -C {{ site_out }}/{{ slug }}
          printf '/ /{{ slug }}/ 302\n' > {{ site_out }}/_redirects
          printf '/*\n  X-Robots-Tag: noindex\n' > {{ site_out }}/_headers

      - if: steps.gate.outputs.run == 'true'
        id: upload
        env:
          CLOUDFLARE_API_TOKEN: {% raw %}${{ secrets.CLOUDFLARE_API_TOKEN }}{% endraw %}
          CLOUDFLARE_ACCOUNT_ID: {% raw %}${{ secrets.CLOUDFLARE_ACCOUNT_ID }}{% endraw %}
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
          PR: {% raw %}${{ github.event.pull_request.number }}{% endraw %}
          # The same week's wait as a package's own installs: dlx resolves wrangler's
          # dependencies without a lockfile, here with the token in reach.
          WRANGLER: pnpm --config.minimum-release-age=10080 dlx wrangler@{{ wrangler_version }}
        run: |-
          # This job may have queued behind a close or a draft switch: a retire that
          # ran first must not be undone by a deploy.
          state=$(gh api "repos/$REPO/pulls/$PR" --jq '.state + " " + (.draft|tostring)')
          if [ "$state" != "open false" ]; then
            echo "::notice::Preview skipped: pull request $PR is no longer open and ready ($state)."
            exit 0
          fi
          "$GITHUB_WORKSPACE/.github/scripts/deploy-worker.sh" Preview "{{ worker }}-pr-$PR" --config wrangler.site.jsonc
