{#- The build and push jobs share one smoke test. #}
{%- macro smoke_test() %}
      - name: smoke test
        env:
          TAG: {{ slug }}:ci
        run: |-
          docker run -d --name ci -p {{ app_port }}:{{ app_port }} "$TAG"
          ok=""
          for _ in $(seq 1 30); do
            if curl -fsS "http://127.0.0.1:{{ app_port }}/health"; then ok=1; break; fi
            sleep 1
          done
          docker logs ci
          docker rm -f ci
          test -n "$ok" || { echo "::error::/health never answered"; exit 1; }
{%- endmacro %}
{%- macro scan() %}

      # Lists HIGH and CRITICAL vulnerabilities that already have a fix. Only the weekly
      # run fails on them: a fix often waits days on a rebuilt base image, and a gate
      # that is red on every pull request in the meantime stops being read.
      # trivy-action saves its database cache on every event, with no switch for that
      # alone. A cache a pull request saves is readable by that pull request alone, so a
      # pull request restores the newest database here and turns the action's cache off.
      # The path and key prefix are trivy-action's defaults.
      - if: github.event_name == 'pull_request'
        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: {% raw %}${{ github.workspace }}{% endraw %}/.cache/trivy
          key: cache-trivy-
          restore-keys: cache-trivy-
      - name: scan image
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          image-ref: {{ slug }}:ci
          cache: {% raw %}${{ github.event_name != 'pull_request' }}{% endraw %}
          ignore-unfixed: true
          severity: HIGH,CRITICAL
          exit-code: {% raw %}${{ github.event_name == 'schedule' && '1' || '0' }}{% endraw %}
{%- endmacro -%}
{#- Filtered by path, as python.yml and ts.yml are, only when the image builds from a
    subdirectory: a root context is the whole repo. -#}
{%- macro paths() %}
{%- if python_dir != '.' %}
    paths: ["{{ python_dir }}/**", ".github/workflows/docker.yml"]
{%- endif %}
{%- endmacro -%}
name: docker

{% if python_dir != '.' -%}
# A pull request that touches no build context skips this workflow, so a branch rule
# that requires its build check leaves that pull request pending. A tag push ignores
# the paths and always runs.
{% endif -%}
on:
  push:
    branches: [main]
{%- if publish_to_ghcr %}
    tags: ["v*"]
{%- endif %}
{{- paths() }}
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
{{- paths() }}
  # Weekly, so the image is rebuilt on the newest base image and scanned against new
  # advisories even when the code has not changed. It builds and scans, never pushes.
  schedule:
    - cron: "0 5 * * 1"
  workflow_dispatch:

permissions:
  contents: read

# A newer push cancels a pull request's run, never a push to main or a tag: that run
# may be halfway through pushing an image. The event is in the group because a queued
# run replaces a pending one in its group whatever cancel-in-progress says, so the
# weekly run and a push to main must not wait in the same group.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}-${{ github.event_name }}{% endraw %}
  cancel-in-progress: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}

jobs:
  build:
    name: build
{%- if publish_to_ghcr %}
    # Builds and runs the image with no write scopes. `permissions` takes no expression,
    # so only a separate push job keeps packages: write and id-token: write away from a
    # pull request's Dockerfile steps and the dependencies they install. It is also the
    # weekly rebuild, which has nothing to push.
    if: (github.event_name == 'pull_request' && !github.event.pull_request.draft) || github.event_name == 'schedule'
{%- else %}
    # Build-only. To push, set publish_to_ghcr and re-run copier update.
    if: github.event_name != 'pull_request' || !github.event.pull_request.draft
{%- endif %}
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1

      - uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: {{ python_dir }}
          cache-from: {% raw %}type=gha,scope=python{% endraw %}
{%- if publish_to_ghcr %}
          # No cache-to: this job runs on pull requests and the weekly rebuild, and a cache
          # saved from a pull request is dropped on merge. The push job below fills the
          # shared scope.
{%- else %}
          # Export only on push. A cache saved from a pull request is readable by that PR
          # alone and dropped on merge. mode=max there would upload hundreds of MB that
          # nothing reads, evicting main's cache.
          cache-to: {% raw %}${{ github.event_name == 'push' && 'type=gha,mode=max,scope=python' || '' }}{% endraw %}
{%- endif %}
          push: false
          load: true # so the smoke test below can run it
          tags: {{ slug }}:ci
          # No provenance/sbom: the docker exporter cannot load attestations, and they only
          # matter once the image reaches a registry.

      # An image that cannot start is not a passing build.
{{- smoke_test() }}
{{- scan() }}
{%- if publish_to_ghcr %}

  push:
    # The write half: builds and smoke-tests again, then pushes from the tested build's
    # cache, so only an image that answered /health reaches the registry.
    name: push
    if: github.event_name != 'pull_request' && github.event_name != 'schedule'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    # In Settings > Environments, limit `ghcr` to main and tags matching `v*`, and add a
    # required reviewer. Without that, anyone who can push a branch or a tag can publish.
    environment: ghcr
    # Job-level permissions replace the workflow-level grant, so restate contents.
    permissions:
      contents: read
      packages: write
      id-token: write # keyless signing for the provenance attestation
      attestations: write
      artifact-metadata: write # the attestation's storage record
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # Publish only a tag signed with a key in .github/allowed_signers on the default
      # branch: .github/scripts/verify-tag.sh says why.
      - name: refuse a tag not signed with an allowed key
        if: startsWith(github.ref, 'refs/tags/')
        env:
          TAG: {% raw %}${{ github.ref_name }}{% endraw %}
          DEFAULT_BRANCH: {% raw %}${{ github.event.repository.default_branch }}{% endraw %}
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: bash "$GITHUB_WORKSPACE/.github/scripts/verify-tag.sh" --fetch "$TAG" "origin/$DEFAULT_BRANCH"

      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1

      # Build to the local store and prove the image starts before the registry login puts
      # a credential on this runner. This job runs on push only, so it fills the
      # cache. A tag build reads no cache: a poisoned entry would ship in the release image.
      - uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: {{ python_dir }}
          cache-from: {% raw %}${{ !startsWith(github.ref, 'refs/tags/') && 'type=gha,scope=python' || '' }}{% endraw %}
          cache-to: {% raw %}type=gha,mode=max,scope=python{% endraw %}
          push: false
          load: true # so the smoke test below can run it
          tags: {{ slug }}:ci
{{ smoke_test() }}

      # No image scan here: trivy-action restores its database from the Actions cache,
      # which this job must not read on a tag. The build job and the weekly run scan.

      - uses: docker/login-action@81c6f93d4bc991e510b342a00b419b3bb4efc5c6 # v4.7.0
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      # No type=ref,event=pr: this job never runs on a pull request.
      - id: meta
        uses: docker/metadata-action@dc802804100637a589fabce1cb79ff13a1411302 # v6.2.0
        with:
          images: {% raw %}ghcr.io/${{ github.repository }}{% endraw %}
          tags: |
            type=ref,event=branch
            type=semver,pattern={% raw %}{{version}}{% endraw %}
            type=semver,pattern={% raw %}{{major}}.{{minor}}{% endraw %}
            type=sha

      # Repeats the build above on the same builder, so every layer resolves
      # from its cache: the pushed image is the smoke-tested one, plus the
      # attestation manifests only a registry can hold.
      - id: build
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: {{ python_dir }}
          cache-from: {% raw %}${{ !startsWith(github.ref, 'refs/tags/') && 'type=gha,scope=python' || '' }}{% endraw %}
          push: true
          tags: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}
          labels: {% raw %}${{ steps.meta.outputs.labels }}{% endraw %}
          provenance: mode=max
          sbom: true

      - uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
        with:
          subject-name: {% raw %}ghcr.io/${{ github.repository }}{% endraw %}
          subject-digest: {% raw %}${{ steps.build.outputs.digest }}{% endraw %}
          push-to-registry: true
{%- endif %}
