name: copier update

# Dependabot can't update a Copier template, so this opens the update PR. It runs
# weekly, finds each template's newest tag, and does nothing when `_commit` in every
# .copier-answers*.yml already is that tag. The PR lives on one fixed branch.
# GITHUB_TOKEN can't push a change to .github/workflows/, which most template releases
# make, and its PR starts no CI. A token from your own GitHub App fixes both; without one,
# an update that touches a workflow opens an issue instead. See "The update App"
# in the template's docs/usage.md.

on:
  schedule:
    - cron: "17 5 * * 1"
  workflow_dispatch:

permissions: {}

concurrency:
  group: {% raw %}${{ github.workflow }}{% endraw %}
  cancel-in-progress: false

env:
  # Dependabot cannot read this pin; template updates refresh it.
  COPIER_VERSION: {{ copier_version }}

jobs:
  update:
    name: copier update
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
    outputs:
      latest: {% raw %}${{ steps.copier.outputs.latest }}{% endraw %}
      workflows: {% raw %}${{ steps.copier.outputs.workflows }}{% endraw %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          enable-cache: false
          version: "{{ uv_version }}"

      # The template runs no Copier tasks, so there is no --trust.
{%- raw %}
      - name: Update from the newest template tag
        shell: bash
        run: |-
          # Each answers file is one template: this one, plus any layered over it
          # (`.copier-answers.<name>.yml`). Copier refuses to update a dirty tree, so each
          # layer's update is committed here; the patch is everything since the checkout.
          base=$(git rev-parse HEAD)
          titles=()
          lines=()
          for answers in .copier-answers.yml .copier-answers.*.yml; do
            [ -f "$answers" ] || continue
            src=$(sed -n "s/^_src_path: *['\"]\{0,1\}\([^'\"]*\)['\"]\{0,1\}$/\1/p" "$answers")
            url=${src/#gh:/https://github.com/}
            latest=$(git ls-remote --tags --refs --sort=-v:refname "$url" 'v*' | sed 's|.*refs/tags/||' | sed -n '/-/!{p;q;}')
            current=$(sed -n "s/^_commit: *['\"]\{0,1\}\([^'\"]*\)['\"]\{0,1\}$/\1/p" "$answers")
            if [ -z "$latest" ]; then
              echo "::error::no stable v* tag found at $url (_src_path: $src in $answers)"
              exit 1
            fi
            if [ "$current" = "$latest" ]; then
              echo "$answers: already on $latest."
              continue
            fi
            uvx "copier@$COPIER_VERSION" update --answers-file "$answers" --defaults --vcs-ref "$latest"
            git add -A
            git -c core.hooksPath=/dev/null -c user.name=copier-update -c user.email=copier-update@localhost \
              commit -q --allow-empty -m "$answers $latest"
            layer=${answers#.copier-answers.}
            layer=${layer%yml}
            layer=${layer%.}
            titles+=("${layer:+$layer }$latest")
            lines+=("- ${layer:-This template}: \`$current\` to \`$latest\`")
          done
          if [ ${#titles[@]} -eq 0 ]; then
            exit 0
          fi
          summary=$(printf '%s, ' "${titles[@]}")
          summary=${summary%, }

          # Copier exits 0 on conflicts: inline markers, or .rej files.
          { git grep -l -e '^<<<<<<< ' HEAD -- . | sed 's/^HEAD://' || true; git ls-files '*.rej'; } | sort -u >conflicts.txt
          {
            echo "Updates this project from its templates:"
            echo
            printf '%s\n' "${lines[@]}"
            echo
            {% endraw %}{% set refresh = [('\\`uv lock\\`', 'python' in stacks), ('\\`pnpm install\\`', 'ts' in stacks), ('\\`just go-sync\\`', 'go' in stacks), ('\\`just site-sync\\`', site == 'astro')] | selectattr('1') | map(attribute='0') | list %}{% if refresh %}echo "Read the diff before merging, then refresh the lockfiles ({{ refresh | join(', ') }})."{% else %}echo "Read the diff before merging."{% endif %}{% raw %}
            if [ -s conflicts.txt ]; then
              echo
              echo "These files have merge conflicts. Their markers are committed as they are:"
              echo
              sed "s/.*/- \`&\`/" conflicts.txt
            fi
          } >body.md
          mkdir -p "$RUNNER_TEMP/copier-update"
          mv body.md "$RUNNER_TEMP/copier-update/body.md"
          git diff --binary "$base" HEAD >"$RUNNER_TEMP/copier-update/update.patch"

          if git diff --name-only --no-renames "$base" HEAD | grep -q '^\.github/workflows/'; then
            echo "workflows=true" >>"$GITHUB_OUTPUT"
          fi
          echo "latest=$summary" >>"$GITHUB_OUTPUT"
        id: copier

      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        if: steps.copier.outputs.latest != ''
        with:
          name: copier-update
          path: ${{ runner.temp }}/copier-update/
          retention-days: 1
          if-no-files-found: error

  push:
    name: publish copier update
    needs: update
    if: needs.update.outputs.latest != ''
    runs-on: ubuntu-latest
    timeout-minutes: 5
    # The App's private key is a secret of this environment, which `just repo-settings`
    # limits to main, so a workflow on another branch can't read it.
    environment: copier-update
    permissions:
      contents: write # without the App, GITHUB_TOKEN pushes the update branch
      pull-requests: write # and opens or edits its PR
      issues: write # to ask for a local update when it can't push one
    steps:
      # A fresh runner keeps Copier's dependencies away from the push token.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: copier-update
          path: ${{ runner.temp }}/copier-update/

      # Apply data only: never import Git configuration or run files from the update.
      - name: Apply the update patch
        env:
          LATEST: ${{ needs.update.outputs.latest }}
        shell: bash
        run: |-
          artifact="$RUNNER_TEMP/copier-update"
          for file in update.patch body.md; do
            test -f "$artifact/$file" && test ! -L "$artifact/$file"
          done
          git switch -C chore/copier-update
          git apply --index "$artifact/update.patch"
          git -c core.hooksPath=/dev/null -c user.name=github-actions[bot] \
            -c user.email=41898282+github-actions[bot]@users.noreply.github.com \
            commit -q -s -m "chore: update from template $LATEST"

      # The App's token lasts an hour, reaches this repo only, and is revoked when the job ends.
      - name: Get a token from the update App
        id: app
        if: vars.COPIER_UPDATE_CLIENT_ID != ''
        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0
        with:
          client-id: ${{ vars.COPIER_UPDATE_CLIENT_ID }}
          private-key: ${{ secrets.COPIER_UPDATE_PRIVATE_KEY }}
          permission-contents: write
          permission-pull-requests: write
          permission-workflows: write

      - name: Push the update and open the PR
        env:
          GH_TOKEN: ${{ steps.app.outputs.token || github.token }}
          HAS_TOKEN: ${{ steps.app.outputs.token != '' }}
          REPO: ${{ github.repository }}
          BASE: ${{ github.event.repository.default_branch }}
          LATEST: ${{ needs.update.outputs.latest }}
          WORKFLOWS: ${{ needs.update.outputs.workflows }}
        shell: bash
        run: |-
          branch=chore/copier-update
          if [ "$HAS_TOKEN" != true ] && [ "$WORKFLOWS" = true ]; then
            title="Update from template $LATEST by hand"
            {
              echo "Template \`$LATEST\` changes files in \`.github/workflows/\`, and \`GITHUB_TOKEN\` can't push those."
              echo "Run \`copier update --answers-file <file> --vcs-ref <tag>\` locally for each template in it, and open the PR yourself, or set up the update App (see the template's docs/usage.md) so this workflow can."
            } >issue.md
            # A closed issue counts too, so closing it stops the weekly reminder for this tag.
            if [ -z "$(gh issue list --state all --search "\"$title\" in:title" --json number --jq '.[0].number')" ]; then
              gh issue create --title "$title" --body-file issue.md
            fi
            # An open PR from an older tag would now disagree with the issue.
            stale=$(gh pr list --head "$branch" --state open --json number --jq '.[0].number')
            if [ -n "$stale" ]; then
              gh pr close "$stale" --delete-branch --comment "Superseded by template \`$LATEST\`, which needs a local update: see the issue \"$title\"."
            fi
            echo "::warning::$title: GITHUB_TOKEN can't push workflow changes"
            exit 0
          fi

          if [ "$HAS_TOKEN" != true ]; then
            printf '\n%s\n' "This PR was opened without the update App, so its checks do not start: close it and reopen it to run them." >>"$RUNNER_TEMP/copier-update/body.md"
          fi

          # git reads the token from gh's credential helper, so it stays out of the process list.
          gh auth setup-git
          git -c core.hooksPath=/dev/null push --force "https://github.com/${REPO}.git" "$branch"

          if [ -n "$(gh pr list --head "$branch" --state open --json number --jq '.[0].number')" ]; then
            gh pr edit "$branch" --title "chore: update from template $LATEST" --body-file "$RUNNER_TEMP/copier-update/body.md"
          else
            gh pr create --head "$branch" --base "$BASE" --title "chore: update from template $LATEST" --body-file "$RUNNER_TEMP/copier-update/body.md"
          fi
{%- endraw %}
