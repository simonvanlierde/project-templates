name: copier update

# Dependabot can't update a Copier template, so this opens the update PR. It runs
# weekly, finds each template's newest tag, and does nothing when `_commit` in every
# .copier-answers*.yml already is that tag. The PR lives on one fixed branch.
# GITHUB_TOKEN can't push a change to .github/workflows/, which most template releases
# make, and its PR starts no CI. A token from your own GitHub App fixes both; without one,
# an update that touches a workflow opens an issue instead. See "The update App"
# in the template's docs/updates.md.

on:
  schedule:
    - cron: "17 5 * * 1"
  workflow_dispatch:

permissions: {}

concurrency:
  group: {% raw %}${{ github.workflow }}{% endraw %}
  cancel-in-progress: false

env:
  # Dependabot cannot read this pin; template updates refresh it.
  COPIER_VERSION: {{ copier_version }}

jobs:
  update:
    name: copier update
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
    env:
      # As in python.yml: uv checks every package against OSV's malware advisories before
      # its code runs. The preview flag only silences the "experimental" warning.
      UV_MALWARE_CHECK: "1"
      UV_PREVIEW_FEATURES: malware-check
    outputs:
      latest: {% raw %}${{ steps.copier.outputs.latest }}{% endraw %}
      workflows: {% raw %}${{ steps.copier.outputs.workflows }}{% endraw %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          enable-cache: false
          version: "{{ uv_version }}"

      # The template runs no Copier tasks, so there is no --trust.
{%- raw %}
      - name: Update from the newest template tag
        shell: bash
        run: |-
          # Each answers file is one template: this one, plus any layered over it
          # (`.copier-answers.<name>.yml`). Copier refuses to update a dirty tree, so each
          # layer's update is committed here; the patch is everything since the checkout.
          base=$(git rev-parse HEAD)
          # A merge conflict must not put markers into a file: a workflow with markers does not run, and
          # neither does the package. A hunk that differs only in a pinned SHA and its version takes the
          # newer pin, as the dependency bot may have bumped it in the project and the template in its
          # release. Any other conflict leaves the project's file as it was and writes the merge, markers
          # in it, to `<file>.rej`: the hooks refuse a pull request that still has one.
          resolve=$(cat <<'PY'
          import re, subprocess, sys
          before = sys.argv[1]
          sha, ver = re.compile(r"\b[0-9a-f]{40}\b"), re.compile(r"\d+(?:\.\d+)+")
          mask = lambda line: ver.sub("V", sha.sub("SHA", line))
          version = lambda line: [tuple(map(int, v.split("."))) for v in ver.findall(line.partition("#")[2])]
          block = re.compile(r"^<<<<<<< before updating\n(.*?)^=======\n(.*?)^>>>>>>> after updating\n", re.M | re.S)
          def pick(m):
              mine, theirs = m[1].splitlines(), m[2].splitlines()
              if not mine or len(mine) != len(theirs) or not all(sha.search(a) and sha.search(b) for a, b in zip(mine, theirs)):
                  return m[0]
              if any(mask(a) != mask(b) for a, b in zip(mine, theirs)):
                  return m[0]
              return m[2] if [version(b) for b in theirs] > [version(a) for a in mine] else m[1]
          files = subprocess.run(["git", "grep", "-lI", "-e", "^<<<<<<< before updating"], capture_output=True, text=True).stdout.split("\n")
          for name in filter(None, files):
              text = open(name, encoding="utf-8", errors="surrogateescape").read()
              merged = block.sub(pick, text)
              if "<<<<<<< before updating" not in merged:
                  open(name, "w", encoding="utf-8", errors="surrogateescape").write(merged)
                  continue
              kept = subprocess.run(["git", "show", f"{before}:{name}"], capture_output=True)
              if kept.returncode:
                  continue
              open(name + ".rej", "w", encoding="utf-8", errors="surrogateescape").write(merged)
              open(name, "wb").write(kept.stdout)
          PY
          )
          titles=()
          lines=()
          for answers in .copier-answers.yml .copier-answers.*.yml; do
            [ -f "$answers" ] || continue
            src=$(sed -n "s/^_src_path: *['\"]\{0,1\}\([^'\"]*\)['\"]\{0,1\}$/\1/p" "$answers")
            url=${src/#gh:/https://github.com/}
            tags=$(git ls-remote --tags --refs --sort=-v:refname "$url" 'v*' | sed 's|.*refs/tags/||' | sed -n '/-/!p')
            current=$(sed -n "s/^_commit: *['\"]\{0,1\}\([^'\"]*\)['\"]\{0,1\}$/\1/p" "$answers")
            if [ -z "$tags" ]; then
              echo "::error::no stable v* tag found at $url (_src_path: $src in $answers)"
              exit 1
            fi
            # The newest stable tag that is a week old. A younger tag waits, as `--exclude-newer` makes
            # Copier's own dependencies wait: a template tag pushed with stolen credentials gets a week
            # to be noticed before this workflow's token pushes it. The tagger date is the tagger's own
            # claim, so this stops a careless tag, not a forged one. Templates under simonvanlierde/ are
            # exempt, as his packages are from the release cooldown.
            latest='' waiting=''
            for tag in $tags; do
              [ "$tag" = "$current" ] && break
              if [[ $src == gh:simonvanlierde/* || $src == https://github.com/simonvanlierde/* ]]; then
                latest=$tag
                break
              fi
              tag_repo="$RUNNER_TEMP/tag-age"
              rm -rf "$tag_repo"
              git init -q "$tag_repo"
              git -C "$tag_repo" fetch -q --depth=1 "$url" "refs/tags/$tag:refs/tags/$tag"
              tagged=$(git -C "$tag_repo" for-each-ref --format='%(creatordate:unix)' "refs/tags/$tag")
              if [ $(( $(date +%s) - tagged )) -ge 604800 ]; then
                latest=$tag
                break
              fi
              waiting=${waiting:-$tag}
            done
            if [ -z "$latest" ]; then
              if [ -n "$waiting" ]; then
                echo "::notice::$answers: $waiting is under a week old; leaving it for a later run."
                echo "- \`$answers\`: \`$waiting\` is under a week old, so it waits." >>"$GITHUB_STEP_SUMMARY"
              else
                echo "$answers: already on $current."
              fi
              continue
            fi
            before=$(git rev-parse HEAD)
            uvx --exclude-newer "1 week" "copier@$COPIER_VERSION" update --answers-file "$answers" --defaults --vcs-ref "$latest"
            python3 -c "$resolve" "$before"
            git add -A
            git -c core.hooksPath=/dev/null -c user.name=copier-update -c user.email=copier-update@localhost \
              commit -q --allow-empty -m "$answers $latest"
            layer=${answers#.copier-answers.}
            layer=${layer%yml}
            layer=${layer%.}
            titles+=("${layer:+$layer }$latest")
            lines+=("- ${layer:-This template}: \`$current\` to \`$latest\`")
          done
          if [ ${#titles[@]} -eq 0 ]; then
            exit 0
          fi
          summary=$(printf '%s, ' "${titles[@]}")
          summary=${summary%, }

          # Copier exits 0 on conflicts; the step above turned them into .rej files.
          git ls-files '*.rej' | sort -u >conflicts.txt
          {
            echo "Updates this project from its templates:"
            echo
            printf '%s\n' "${lines[@]}"
            echo
            {% endraw %}{% set refresh = [('\\`uv lock\\`', 'python' in stacks), ('\\`pnpm install\\`', 'ts' in stacks), ('\\`just go-sync\\`', 'go' in stacks), ('\\`just site-sync\\`', site == 'astro'), ('\\`just docs-sync\\`, \\`just docs-hashes\\`', docs_starlight)] | selectattr('1') | map(attribute='0') | list %}{% if refresh %}echo "Read the diff before merging, then refresh the lockfiles ({{ refresh | join(', ') }})."{% else %}echo "Read the diff before merging."{% endif %}{% raw %}
            if [ -s conflicts.txt ]; then
              echo
              echo "These changes did not merge. Each file keeps the project's version, and the template's, with the conflicts marked, is in the \`.rej\` file next to it. Copy what you need into the file, then delete the \`.rej\` file: the hooks fail while one is left."
              echo
              sed "s/.*/- \`&\`/" conflicts.txt
            fi
          } >body.md
          mkdir -p "$RUNNER_TEMP/copier-update"
          mv body.md "$RUNNER_TEMP/copier-update/body.md"
          git diff --binary "$base" HEAD >"$RUNNER_TEMP/copier-update/update.patch"

          if git diff --name-only --no-renames "$base" HEAD | grep -q '^\.github/workflows/'; then
            echo "workflows=true" >>"$GITHUB_OUTPUT"
          fi
          echo "latest=$summary" >>"$GITHUB_OUTPUT"
        id: copier

      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        if: steps.copier.outputs.latest != ''
        with:
          name: copier-update
          path: ${{ runner.temp }}/copier-update/
          retention-days: 1
          if-no-files-found: error

  push:
    name: publish copier update
    needs: update
    if: needs.update.outputs.latest != ''
    runs-on: ubuntu-latest
    timeout-minutes: 5
    # The App's private key is a secret of this environment, which `just repo-settings`
    # limits to main, so a workflow on another branch can't read it.
    environment: copier-update
    permissions:
      contents: write # without the App, GITHUB_TOKEN pushes the update branch
      pull-requests: write # and opens or edits its PR
      issues: write # to ask for a local update when it can't push one
    steps:
      # A fresh runner keeps Copier's dependencies away from the push token.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: copier-update
          path: ${{ runner.temp }}/copier-update/

      # Apply data only: never import Git configuration or run files from the update.
      - name: Apply the update patch
        env:
          LATEST: ${{ needs.update.outputs.latest }}
        shell: bash
        run: |-
          artifact="$RUNNER_TEMP/copier-update"
          for file in update.patch body.md; do
            test -f "$artifact/$file" && test ! -L "$artifact/$file"
          done
          git switch -C chore/copier-update
          git apply --index "$artifact/update.patch"
          git -c core.hooksPath=/dev/null -c user.name=github-actions[bot] \
            -c user.email=41898282+github-actions[bot]@users.noreply.github.com \
            commit -q -s -m "chore: update from template $LATEST"

      # The App's token lasts an hour, reaches this repo only, and is revoked when the job ends.
      - name: Get a token from the update App
        id: app
        if: vars.COPIER_UPDATE_CLIENT_ID != ''
        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0
        with:
          client-id: ${{ vars.COPIER_UPDATE_CLIENT_ID }}
          private-key: ${{ secrets.COPIER_UPDATE_PRIVATE_KEY }}
          permission-contents: write
          permission-pull-requests: write
          permission-workflows: write

      - name: Push the update and open the PR
        env:
          GH_TOKEN: ${{ steps.app.outputs.token || github.token }}
          HAS_TOKEN: ${{ steps.app.outputs.token != '' }}
          REPO: ${{ github.repository }}
          BASE: ${{ github.event.repository.default_branch }}
          LATEST: ${{ needs.update.outputs.latest }}
          WORKFLOWS: ${{ needs.update.outputs.workflows }}
        shell: bash
        run: |-
          branch=chore/copier-update
          # `--head` matches a fork's branch of the same name too: only this repo's PRs count.
          own='map(select(.isCrossRepository == false))'
          # Closing an update unmerged declines that tag; a later tag can open a new PR.
          declined=$(gh pr list --head "$branch" --base "$BASE" --state closed --json title,mergedAt,isCrossRepository |
            jq --arg title "chore: update from template $LATEST" "$own"' | any(.[]; .title == $title and .mergedAt == null)')
          if [ "$declined" = true ]; then
            echo "::notice::Template $LATEST was declined; skipping this tag"
            exit 0
          fi
          if [ "$HAS_TOKEN" != true ] && [ "$WORKFLOWS" = true ]; then
            title="Update from template $LATEST by hand"
            {
              echo "Template \`$LATEST\` changes files in \`.github/workflows/\`, and \`GITHUB_TOKEN\` can't push those."
              echo "Run \`copier update --answers-file <file> --vcs-ref <tag>\` locally for each template in it, and open the PR yourself, or set up the update App (see the template's docs/updates.md) so this workflow can."
            } >issue.md
            # A closed issue counts too, so closing it stops the weekly reminder for this tag.
            # Only the issue this step opened with GITHUB_TOKEN counts, not one anyone titled so.
            if [ -z "$(gh issue list --state all --author app/github-actions --search "\"$title\" in:title" --json number --jq '.[0].number')" ]; then
              gh issue create --title "$title" --body-file issue.md
            fi
            # An open PR from an older tag would now disagree with the issue.
            stale=$(gh pr list --head "$branch" --state open --json number,isCrossRepository --jq "$own | .[0].number")
            if [ -n "$stale" ]; then
              gh pr close "$stale" --delete-branch --comment "Superseded by template \`$LATEST\`, which needs a local update: see the issue \"$title\"."
            fi
            echo "::warning::$title: GITHUB_TOKEN can't push workflow changes"
            exit 0
          fi

          if [ "$HAS_TOKEN" != true ]; then
            printf '\n%s\n' "This PR was opened without the update App, so its checks do not start: close it and reopen it to run them." >>"$RUNNER_TEMP/copier-update/body.md"
          fi

          # git reads the token from gh's credential helper, so it stays out of the process list.
          gh auth setup-git
          git -c core.hooksPath=/dev/null push --force "https://github.com/${REPO}.git" "$branch"

          open=$(gh pr list --head "$branch" --state open --json number,isCrossRepository --jq "$own | .[0].number")
          if [ -n "$open" ]; then
            gh pr edit "$open" --title "chore: update from template $LATEST" --body-file "$RUNNER_TEMP/copier-update/body.md"
          else
            gh pr create --head "$branch" --base "$BASE" --title "chore: update from template $LATEST" --body-file "$RUNNER_TEMP/copier-update/body.md"
          fi
{%- endraw %}

  notify:
    # Scheduled runs only: without it, a project stops getting template releases unseen.
    # The only job that may write issues.
    name: "copier update: report failure"
    needs: [update, push]
    # A job that runs past timeout-minutes ends cancelled, not failed.
    if: always() && github.event_name == 'schedule' && (contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled'))
    permissions:
      issues: write # opens or comments on the failure issue
    uses: $/.github/workflows/report-failure.yml
    with:
      title: Weekly template update failed
