{%- set py = 'python' in stacks and kind == 'library' -%}
{%- set ts = 'ts' in stacks and ts_kind == 'library' -%}
{%- set rs = 'rust' in stacks and rust_kind == 'library' -%}
{%- set go = 'go' in stacks and go_kind == 'library' -%}
{%- set stack_jobs = (['python'] if py else []) + (['ts'] if ts else []) + (['rust'] if rs else []) + (['go'] if go else []) -%}
name: mutation

# Mutation testing once a week, with the same `just <stack>-mutation` recipes you run by
# hand. Never on a pull request: a run takes minutes to hours. Run it from the Actions
# tab with "Run workflow" after you change the tests.
{%- if py %}
# The Python job fails on a surviving mutant that is not in tests/mutation-baseline.txt,
# and on a listed one that no longer survives.
{%- endif %}
{%- if rs %}
# The Rust job fails when a mutant survives. List one that changes nothing a test could
# see in .cargo/mutants.toml (`exclude_re`).
{%- endif %}
{%- if ts or go %}
# The {{ 'ts and go jobs print' if ts and go else ('ts job prints' if ts else 'go job prints') }} survivors and pass: {{ 'their tools exit' if ts and go else 'its tool exits' }} 0 when a mutant survives.
{%- endif %}
# A failed scheduled run opens one issue (or comments on the open one). GitHub pauses
# schedules after 60 days without repository activity: re-enable from the Actions tab.
on:
  schedule:
    - cron: "17 5 * * 1"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: false

jobs:
{%- if py %}
  python:
    name: "mutation: python"
    runs-on: ubuntu-latest
    timeout-minutes: 60
{%- if python_dir != '.' %}
    # Only `run:` steps take this. just finds the root justfile from here.
    defaults:
      run:
        working-directory: {{ python_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: astral-sh/setup-uv@07a047e608db84b3d8c06cd9a7c7dcc9c355c18e # v10.3.2
        with:
          enable-cache: true
          version: "{{ uv_version }}"

      - uses: taiki-e/install-action@86f7a0ffb25f40114606501a311ebcfaf882ea32 # v2.88.0
        with:
          tool: just@{{ just_version }}
          fallback: none

      - run: uv sync --locked
      - run: just py-mutation
{%- endif %}
{%- if ts %}
  ts:
    name: "mutation: ts"
    runs-on: ubuntu-latest
    timeout-minutes: 60
{%- if ts_dir != '.' %}
    # Only `run:` steps take this. Point the setup actions at the package separately.
    defaults:
      run:
        working-directory: {{ ts_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
{%- if ts_dir != '.' %}
        with:
          package_json_file: {{ ts_dir }}/package.json
{%- endif %}

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{ node_version }}"
          cache: pnpm
{%- if ts_dir != '.' %}
          cache-dependency-path: {{ ts_dir }}/pnpm-lock.yaml
{%- endif %}

      - run: pnpm install --frozen-lockfile

      - uses: taiki-e/install-action@86f7a0ffb25f40114606501a311ebcfaf882ea32 # v2.88.0
        with:
          tool: just@{{ just_version }}
          fallback: none

      - run: just ts-mutation
{%- endif %}
{%- if rs %}
  rust:
    name: "mutation: rust"
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: dtolnay/rust-toolchain@683b588c487a69d01f6c6ddf40f036ff682cc2c8 # v1
        with:
          toolchain: stable

      - uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2.9.3
{%- if rust_dir != '.' %}
        with:
          workspaces: {{ rust_dir }}
{%- endif %}

      - uses: taiki-e/install-action@86f7a0ffb25f40114606501a311ebcfaf882ea32 # v2.88.0
        with:
          tool: just@{{ just_version }},cargo-mutants@{{ cargo_mutants_version }}
          fallback: none

      # Exit 3 means some mutants hung until the timeout, which counts as caught. A missed
      # one gives 2, unless a timeout came too, so check the list as well.
      - run: |
          just rs-mutation || [ $? -eq 3 ]
          test ! -s {{ '' if rust_dir == '.' else rust_dir ~ '/' }}mutants.out/missed.txt
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        if: {% raw %}${{ !cancelled() }}{% endraw %}
        with:
          name: mutants.out
          path: {{ '' if rust_dir == '.' else rust_dir ~ '/' }}mutants.out/
{%- endif %}
{%- if go %}
  go:
    name: "mutation: go"
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: {{ go_dir ~ '/' if go_dir != '.' else '' }}go.mod
          cache-dependency-path: {{ go_dir ~ '/' if go_dir != '.' else '' }}go.sum

      - uses: taiki-e/install-action@86f7a0ffb25f40114606501a311ebcfaf882ea32 # v2.88.0
        with:
          tool: just@{{ just_version }}
          fallback: none

      - run: just go-mutation
{%- endif %}

  notify:
    # Weekly only. Opens one issue, or comments on the open one, when a job above fails.
    # The only job that may write issues.
    name: "mutation: report failure"
    needs: {{ stack_jobs }}
    # A job that runs past timeout-minutes ends cancelled, not failed.
    if: always() && github.event_name == 'schedule' && (contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled'))
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      issues: write
    steps:
      - name: open or update the issue
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          GH_REPO: {% raw %}${{ github.repository }}{% endraw %}
          RUN_URL: {% raw %}${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}{% endraw %}
        run: |-
          title="Weekly mutation run failed"
          body="The scheduled run failed: $RUN_URL"
          issue=$(gh issue list --state open --author app/github-actions --search "in:title \"$title\"" --json number -q '.[0].number')
          if [ -n "$issue" ]; then
            gh issue comment "$issue" --body "$body"
          else
            gh issue create --title "$title" --body "$body"
          fi
