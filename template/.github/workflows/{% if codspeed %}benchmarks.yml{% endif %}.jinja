name: benchmarks

# CodSpeed measures the benchmarks on each pull request that touches benchmarked code and
# compares them with main. Simulation mode counts CPU instructions, so a noisy runner does
# not move the result. Pushes to main run with no path filter, so the newest main commit,
# which CodSpeed compares a pull request with, has a result. No ruleset may require this check,
# since a filtered pull request never reports it. The upload signs in with the job's OIDC
# token, so there is no secret.
on:
  push:
    branches: [main]
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
    paths:
{%- if 'python' in stacks %}
{%- if python_dir == '.' %}
      - "{{ 'src' if python_layout == 'src' else module_name }}/**"
      - "tests/**"
      - "pyproject.toml"
      - "uv.lock"
      - ".python-version"
{%- else %}
      - "{{ python_dir }}/**"
{%- endif %}
{%- endif %}
{%- if 'rust' in stacks %}
{%- if rust_dir == '.' %}
      - "src/**"
      - "benches/**"
      - "Cargo.toml"
      - "Cargo.lock"
{%- else %}
      - "{{ rust_dir }}/**"
{%- endif %}
{%- endif %}
      - ".github/workflows/benchmarks.yml"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}
{%- if 'python' in stacks %}

jobs:
  python:
    name: "codspeed: python"
    if: github.event_name != 'pull_request' || !github.event.pull_request.draft
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      id-token: write # OpenID Connect sign-in to CodSpeed
    env:
      # As in python.yml: uv checks every package against OSV's malware advisories before
      # its code runs. The preview flag only silences the "experimental" warning.
      UV_MALWARE_CHECK: "1"
      UV_PREVIEW_FEATURES: malware-check
{%- if python_dir != '.' %}
    defaults:
      run:
        working-directory: {{ python_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          enable-cache: true
          # A cache saved on a pull request is readable by that pull request alone.
          save-cache: {% raw %}${{ github.event_name != 'pull_request' }}{% endraw %}
          version: "{{ uv_version }}"

      - run: uv sync --locked

      - uses: CodSpeedHQ/action@61efe07e57e55bedeab750c434504de272a56e8c # v5.6.1
        with:
          mode: simulation
{%- if python_dir != '.' %}
          working-directory: {{ python_dir }}
{%- endif %}
          run: uv run pytest tests/test_benchmarks.py --codspeed
{%- endif %}
{%- if 'rust' in stacks %}
{%- if 'python' not in stacks %}

jobs:
{%- endif %}
  rust:
    name: "codspeed: rust"
    if: github.event_name != 'pull_request' || !github.event.pull_request.draft
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
      id-token: write # OpenID Connect sign-in to CodSpeed
{%- if rust_dir != '.' %}
    # Only `run:` steps take this, so rust-cache is pointed at the crate separately.
    defaults:
      run:
        working-directory: {{ rust_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: dtolnay/rust-toolchain@683b588c487a69d01f6c6ddf40f036ff682cc2c8 # v1
        with:
          toolchain: stable

      - uses: Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0 # v2.9.3
        with:
          save-if: {% raw %}${{ github.event_name != 'pull_request' }}{% endraw %}
{%- if rust_dir != '.' %}
          workspaces: {{ rust_dir }}
{%- endif %}

      - uses: taiki-e/install-action@1919c4a95903d2c33e4a221102edca87309fc14b # v2.89.0
        with:
          tool: cargo-codspeed@{{ divan_version }}

      - run: cargo codspeed build -m simulation --locked

      - uses: CodSpeedHQ/action@61efe07e57e55bedeab750c434504de272a56e8c # v5.6.1
        with:
          mode: simulation
{%- if rust_dir != '.' %}
          working-directory: {{ rust_dir }}
{%- endif %}
          run: cargo codspeed run
{%- endif %}
