name: ts release

# Trusted publishing: no NPM_TOKEN. Configure the publisher once at
# https://www.npmjs.com/package/{{ slug }}/access for repo
# {{ github_user }}/{{ slug }}, workflow `ts-release.yml`, environment `npm`.
#
# The package must already exist on npm: trusted publishing cannot create it, so
# publish the first version manually (`pnpm publish`). npm adds the provenance
# attestation itself over OIDC — no --provenance flag.
#
# The build job re-runs the full suite: a release tag can point at any commit,
# including one that never went green.
#
# `id-token: write` reaches every step of its job, where any dependency script or
# test could mint a token and publish under this name. So the publish job runs no
# project code: it downloads the tarball `build` produced and uploads it.

on:
  release:
    types: [published]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 10
{%- if ts_dir != '.' %}
    defaults:
      run:
        working-directory: {{ ts_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: pnpm/action-setup@0ebf47130e4866e96fce0953f49152a61190b271 # v6.0.9
{%- if ts_dir != '.' %}
        with:
          package_json_file: {{ ts_dir }}/package.json
{%- endif %}

      # No cache: an entry written from any branch is restorable here, which
      # would put attacker-controlled bytes into the tarball this workflow signs.
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "{{ node_version }}"
          package-manager-cache: false

      - run: pnpm install --frozen-lockfile

      # Publish only what passes, on the exact commit being released.
      - run: pnpm run check
      - run: pnpm run typecheck
      - run: pnpm run test
      - run: pnpm run build

      - run: pnpm pack --pack-destination dist-pack

      # Lints the tarball rather than the source: exports map, types resolution,
      # and what `files` actually included. ts.yml cannot see any of that.
      - run: pnpm exec publint dist-pack/*.tgz

      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: package
          path: {{ ts_dir }}/dist-pack/*.tgz

  publish:
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment: npm
    # Job-level permissions replace the workflow-level grant, so restate contents
    # or setup-node resolves Node releases against the anonymous rate limit.
    permissions:
      contents: read
      id-token: write # required for trusted publishing
    steps:
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: package

      # setup-node's cache detection is on by default — exactly what zizmor's
      # cache-poisoning audit flags in a publishing job. Off explicitly.
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "{{ node_version }}"
          registry-url: "https://registry.npmjs.org"
          package-manager-cache: false

      # npm, not pnpm: a prebuilt tarball needs no checkout, install or lockfile,
      # and npm ships with Node with OIDC support since 11.5.1 (Node 24+).
      - run: npm publish --access public ./*.tgz
