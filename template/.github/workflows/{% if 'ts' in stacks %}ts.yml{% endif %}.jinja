name: ts

on:
  push:
    branches: [main]
{%- if ts_dir != '.' %}
    paths: ["{{ ts_dir }}/**", ".github/workflows/ts.yml"]
{%- endif %}
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
{%- if ts_dir != '.' %}
    paths: ["{{ ts_dir }}/**", ".github/workflows/ts.yml"]
{%- endif %}
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  check:
    name: lint, types, tests
    if: github.event_name != 'pull_request' || !github.event.pull_request.draft
    runs-on: ubuntu-latest
    timeout-minutes: 10
{%- if ts_kind == 'web-app' %}
    outputs:
      playwright: {% raw %}${{ steps.playwright.outputs.version }}{% endraw %}
{%- endif %}
{%- if ts_dir != '.' %}
    # Only `run:` steps take this. Point the setup actions at the package separately:
    # pnpm/action-setup reads `packageManager` from a package.json, and setup-node hashes
    # a lockfile to key its cache.
    defaults:
      run:
        working-directory: {{ ts_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
{%- if ts_dir != '.' %}
        with:
          package_json_file: {{ ts_dir }}/package.json
{%- endif %}

      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "{{ node_version }}"
          cache: pnpm
{%- if ts_dir != '.' %}
          cache-dependency-path: {{ ts_dir }}/pnpm-lock.yaml
{%- endif %}

      - run: pnpm install --frozen-lockfile
{%- if ts_kind == 'web-app' %}

      # The e2e container's tag must match the installed Playwright exactly, so it
      # is read from the package the lockfile resolved, not kept in sync by hand.
      - id: playwright
        run: echo "version=$(node -p "require('@playwright/test/package.json').version")" >> "$GITHUB_OUTPUT"
{%- endif %}

      - run: pnpm run check
      - run: pnpm run typecheck
{%- if codecov %}
      - run: pnpm run coverage --coverage.reporter=lcov

      # Dependabot pull requests get no secrets, so their upload fails without failing CI.
      - uses: codecov/codecov-action@303a32d7a59b442fa8d48b6a1cc6825c09c847a5 # v7.1.1
        with:
          token: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
          files: {% if ts_dir != '.' %}{{ ts_dir }}/{% endif %}coverage/lcov.info
{%- if 'python' in stacks %}
          flags: ts
{%- endif %}
{%- else %}
      - run: pnpm run test
{%- endif %}
      - run: pnpm run build
{%- if ts_kind == 'web-app' %}
      - run: pnpm run budget
{%- endif %}
      # Known advisories, moderate and up, in what ships: dependencies, not dev tooling.
      - run: pnpm audit --prod --audit-level=moderate
{%- if ts_kind == 'web-app' %}

  e2e:
    name: e2e (chromium)
    needs: check
    runs-on: ubuntu-latest
    timeout-minutes: 20
    # The browser and its system libraries come with the image, at the version the
    # check job read from the lockfile, so a Playwright bump needs no edit here.
    container:
      image: mcr.microsoft.com/playwright:v{% raw %}${{ needs.check.outputs.playwright }}{% endraw %}-noble
{%- if ts_dir != '.' %}
    defaults:
      run:
        working-directory: {{ ts_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # Without a Latin font, the image falls back to a CJK font whose narrow Latin
      # glyphs can hide text that overflows with the fonts real browsers use.
      - run: apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core

      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
{%- if ts_dir != '.' %}
        with:
          package_json_file: {{ ts_dir }}/package.json
{%- endif %}

      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "{{ node_version }}"
          cache: pnpm
{%- if ts_dir != '.' %}
          cache-dependency-path: {{ ts_dir }}/pnpm-lock.yaml
{%- endif %}

      - run: pnpm install --frozen-lockfile
      - run: pnpm run test:e2e

      - if: failure()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: playwright-report
          path: {% if ts_dir != '.' %}{{ ts_dir }}/{% endif %}playwright-report/
          retention-days: 7
{%- endif %}
