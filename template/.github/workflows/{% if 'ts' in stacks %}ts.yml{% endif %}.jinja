{% from 'includes/triggers.jinja' import push_and_pr -%}
{%- set lock = ('' if ts_dir == '.' else ts_dir ~ '/') ~ 'pnpm-lock.yaml' -%}
name: ts

on:
{{- push_and_pr(ts_dir, 'ts') }}
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  check:
    name: "ts: lint, types, tests"
    if: github.event_name != 'pull_request' || !github.event.pull_request.draft
    runs-on: ubuntu-latest
    timeout-minutes: 10
{%- if ts_kind == 'web-app' %}
    outputs:
      playwright: {% raw %}${{ steps.playwright.outputs.version }}{% endraw %}
{%- endif %}
{%- if ts_dir != '.' %}
    # Only `run:` steps take this. Point pnpm/action-setup at the package separately: it
    # reads `packageManager` from a package.json. The cache keys name the lockfile's path.
    defaults:
      run:
        working-directory: {{ ts_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
{%- if ts_dir != '.' %}
        with:
          package_json_file: {{ ts_dir }}/package.json
{%- endif %}

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{ node_version }}"

      # The pnpm store is cached by hand: setup-node's cache saves on every event and has
      # no switch to stop that. A cache a pull request saves is readable by that pull
      # request alone, and it pushes main's entries out of the 10 GB per-repo limit, so
      # pull requests only restore.
      - id: pnpm-store
        run: echo "path=$(pnpm store path --silent)" >> "$GITHUB_OUTPUT"
      - id: pnpm-cache
        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: pnpm-check-{% raw %}${{ runner.os }}-${{ hashFiles('{% endraw %}{{ lock }}{% raw %}') }}{% endraw %}
          restore-keys: pnpm-check-{% raw %}${{ runner.os }}-{% endraw %}

      - run: pnpm install --frozen-lockfile
      - if: github.event_name != 'pull_request' && steps.pnpm-cache.outputs.cache-hit != 'true'
        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: {% raw %}${{ steps.pnpm-cache.outputs.cache-primary-key }}{% endraw %}
{%- if ts_kind == 'web-app' %}

      # The e2e container's tag must match the installed Playwright exactly, so it
      # is read from the package the lockfile resolved, not kept in sync by hand.
      - id: playwright
        run: echo "version=$(node -p "require('@playwright/test/package.json').version")" >> "$GITHUB_OUTPUT"
{%- endif %}

      - run: pnpm run check
      - run: pnpm run typecheck
{%- if codecov %}
      - run: pnpm run coverage --coverage.reporter=lcov

      # Dependabot pull requests get no secrets, so their upload fails without failing CI.
      - uses: codecov/codecov-action@303a32d7a59b442fa8d48b6a1cc6825c09c847a5 # v7.1.1
        with:
          token: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
          files: {% if ts_dir != '.' %}{{ ts_dir }}/{% endif %}coverage/lcov.info
{%- if 'python' in stacks %}
          flags: ts
{%- endif %}
{%- else %}
      - run: pnpm run test
{%- endif %}
      - run: pnpm run build
{%- if publish_to_npm %}
      # Fails when the built types differ from the committed {{ slug }}.api.md, so a
      # removed or changed export shows in review. `just ts-api` updates the report.
      - run: pnpm run api
{%- endif %}
{%- if ts_kind == 'web-app' %}
      - run: pnpm run budget
{%- endif %}
      # Known advisories, moderate and up, in what ships: dependencies, not dev tooling.
      - run: pnpm audit --prod --audit-level=moderate
{%- if ts_kind == 'web-app' %}

  e2e:
    name: e2e (chromium)
    needs: check
    runs-on: ubuntu-latest
    timeout-minutes: 20
    # The browser and its system libraries come with the image, at the version the
    # check job read from the lockfile, so a Playwright bump needs no edit here. That
    # tag comes from the lockfile, so no digest can be pinned next to it.
    container:
      # jactionlint ignore=unpinned-images
      image: mcr.microsoft.com/playwright:v{% raw %}${{ needs.check.outputs.playwright }}{% endraw %}-noble
{%- if ts_dir != '.' %}
    defaults:
      run:
        working-directory: {{ ts_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # Without a Latin font, the image falls back to a CJK font whose narrow Latin
      # glyphs can hide text that overflows with the fonts real browsers use.
      - run: apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core

      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
{%- if ts_dir != '.' %}
        with:
          package_json_file: {{ ts_dir }}/package.json
{%- endif %}

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{ node_version }}"

      # Cached by hand, saved off pull requests only, as in the check job. The container's
      # store path differs from the runner's, so this is a cache of its own.
      - id: pnpm-store
        run: echo "path=$(pnpm store path --silent)" >> "$GITHUB_OUTPUT"
      - id: pnpm-cache
        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: pnpm-e2e-{% raw %}${{ runner.os }}-${{ hashFiles('{% endraw %}{{ lock }}{% raw %}') }}{% endraw %}
          restore-keys: pnpm-e2e-{% raw %}${{ runner.os }}-{% endraw %}

      - run: pnpm install --frozen-lockfile
      - if: github.event_name != 'pull_request' && steps.pnpm-cache.outputs.cache-hit != 'true'
        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: {% raw %}${{ steps.pnpm-cache.outputs.cache-primary-key }}{% endraw %}
      - run: pnpm run test:e2e

      - if: failure()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: playwright-report
          path: {% if ts_dir != '.' %}{{ ts_dir }}/{% endif %}playwright-report/
          retention-days: 7
{%- endif %}
