{% from 'includes/triggers.jinja' import push_and_pr -%}
{%- set lock = ('' if ts_dir == '.' else ts_dir ~ '/') ~ 'pnpm-lock.yaml' -%}
name: ts

on:
{{- push_and_pr(ts_dir, 'ts', ['deploy-worker.sh'] if ts_kind == 'web-app' else []) }}
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
{%- if ts_kind == 'web-app' %}
  # Pull requests only: a newer push to main must not cancel a production deploy in flight.
  cancel-in-progress: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}
{%- else %}
  cancel-in-progress: true
{%- endif %}

jobs:
  check:
    name: "ts: lint, types, tests"
    if: github.event_name != 'pull_request' || !github.event.pull_request.draft
    runs-on: ubuntu-latest
    timeout-minutes: 10
{%- if ts_dir != '.' %}
    # Only `run:` steps take this. Point pnpm/action-setup at the package separately: it
    # reads `packageManager` from a package.json. The cache keys name the lockfile's path.
    defaults:
      run:
        working-directory: {{ ts_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
{%- if ts_dir != '.' %}
        with:
          package_json_file: {{ ts_dir }}/package.json
{%- endif %}

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{ node_version }}"

      # The pnpm store is cached by hand: setup-node's cache saves on every event and has
      # no switch to stop that. A cache a pull request saves is readable by that pull
      # request alone, and it pushes main's entries out of the 10 GB per-repo limit, so
      # pull requests only restore.
      - id: pnpm-store
        run: echo "path=$(pnpm store path --silent)" >> "$GITHUB_OUTPUT"
      - id: pnpm-cache
        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: pnpm-check-{% raw %}${{ runner.os }}-${{ hashFiles('{% endraw %}{{ lock }}{% raw %}') }}{% endraw %}
          restore-keys: pnpm-check-{% raw %}${{ runner.os }}-{% endraw %}

      - run: pnpm install --frozen-lockfile
      - if: github.event_name != 'pull_request' && steps.pnpm-cache.outputs.cache-hit != 'true'
        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: {% raw %}${{ steps.pnpm-cache.outputs.cache-primary-key }}{% endraw %}

      - run: pnpm run check
      - run: pnpm run typecheck
{%- if codecov %}
      - run: pnpm run coverage --coverage.reporter=lcov

      # Dependabot pull requests get no secrets, so their upload fails without failing CI.
      - uses: codecov/codecov-action@303a32d7a59b442fa8d48b6a1cc6825c09c847a5 # v7.1.1
        with:
          token: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
          files: {% if ts_dir != '.' %}{{ ts_dir }}/{% endif %}coverage/lcov.info
{%- if 'python' in stacks %}
          flags: ts
{%- endif %}
{%- else %}
      - run: pnpm run test
{%- endif %}
      - run: pnpm run build
{%- if publish_to_npm %}
      # Fails when the built types differ from the committed {{ slug }}.api.md, so a
      # removed or changed export shows in review. `just ts-api` updates the report.
      - run: pnpm run api
{%- endif %}
{%- if ts_kind == 'web-app' %}
      - run: pnpm run budget

      # The preview and production jobs deploy this build, so they ship what the checks ran on.
      - if: github.event_name == 'pull_request' || github.event_name == 'push'
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: dist
          path: {% if ts_dir != '.' %}{{ ts_dir }}/{% endif %}dist
          if-no-files-found: error
          retention-days: 7
{%- endif %}
      # Known advisories, moderate and up, in what ships: dependencies, not dev tooling.
      - run: pnpm audit --prod --audit-level=moderate
{%- if ts_kind == 'web-app' %}

  # The e2e container's tag must match the locked Playwright exactly. A job of its own reads it,
  # so e2e starts beside check instead of waiting for all of it.
  playwright:
    name: "ts: playwright version"
    if: github.event_name != 'pull_request' || !github.event.pull_request.draft
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      version: {% raw %}${{ steps.version.outputs.version }}{% endraw %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          sparse-checkout: {{ lock }}
          sparse-checkout-cone-mode: false
      - id: version
        run: |
          version=$(grep -oPm1 "^  '@playwright/test@\K[0-9.]+(?=':)" {{ lock }})
          echo "version=$version" >> "$GITHUB_OUTPUT"

  e2e:
    name: e2e (chromium)
    needs: playwright
    runs-on: ubuntu-latest
    timeout-minutes: 20
    # The browser and its system libraries come with the image, at the version the
    # playwright job read, so a Playwright bump needs no edit here and no digest can sit beside it.
    container:
      # jactionlint ignore=unpinned-images
      image: mcr.microsoft.com/playwright:v{% raw %}${{ needs.playwright.outputs.version }}{% endraw %}-noble
{%- if ts_dir != '.' %}
    defaults:
      run:
        working-directory: {{ ts_dir }}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      # Without a Latin font, the image falls back to a CJK font whose narrow Latin
      # glyphs can hide text that overflows with the fonts real browsers use.
      - run: apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core

      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
{%- if ts_dir != '.' %}
        with:
          package_json_file: {{ ts_dir }}/package.json
{%- endif %}

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{ node_version }}"

      # Cached by hand, saved off pull requests only, as in the check job. The container's
      # store path differs from the runner's, so this is a cache of its own.
      - id: pnpm-store
        run: echo "path=$(pnpm store path --silent)" >> "$GITHUB_OUTPUT"
      - id: pnpm-cache
        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: pnpm-e2e-{% raw %}${{ runner.os }}-${{ hashFiles('{% endraw %}{{ lock }}{% raw %}') }}{% endraw %}
          restore-keys: pnpm-e2e-{% raw %}${{ runner.os }}-{% endraw %}

      - run: pnpm install --frozen-lockfile
      - if: github.event_name != 'pull_request' && steps.pnpm-cache.outputs.cache-hit != 'true'
        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: {% raw %}${{ steps.pnpm-cache.outputs.cache-primary-key }}{% endraw %}
      - run: pnpm run test:e2e

      - if: failure()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: playwright-report
          path: {% if ts_dir != '.' %}{{ ts_dir }}/{% endif %}playwright-report/
          retention-days: 7

  # The README's "Pull request previews" has the lifecycle. Fork pull requests never get
  # the token, so they skip with a notice, as does a repo without the secret.
  preview:
    name: preview
    # Bot pull requests (Renovate, Dependabot) get no preview, so their code never sees the token.
    if: github.event_name == 'pull_request' && !github.event.pull_request.draft && !endsWith(github.event.pull_request.user.login, '[bot]')
    # Shares the web app job of preview-retire.yml, so a retire waits for a deploy in flight.
    concurrency:
      group: preview-{% raw %}${{ github.event.pull_request.number }}{% endraw %}
    needs: check
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      pull-requests: read
    environment:
      name: preview
      url: {% raw %}${{ steps.upload.outputs.url }}{% endraw %}
{%- if ts_dir != '.' %}
    defaults:
      run:
        working-directory: {{ ts_dir }}
{%- endif %}
    steps:
      - id: gate
{%- if ts_dir != '.' %}
        # Runs before checkout, when {{ ts_dir }}/ does not exist yet.
        working-directory: .
{%- endif %}
        env:
          TOKEN: {% raw %}${{ secrets.CLOUDFLARE_API_TOKEN }}{% endraw %}
          ACCOUNT: {% raw %}${{ secrets.CLOUDFLARE_ACCOUNT_ID }}{% endraw %}
          FORK: {% raw %}${{ github.event.pull_request.head.repo.full_name != github.repository }}{% endraw %}
        run: |
          missing=""
          [ -n "$TOKEN" ] || missing=CLOUDFLARE_API_TOKEN
          [ -n "$ACCOUNT" ] || missing="${missing:+$missing and }CLOUDFLARE_ACCOUNT_ID"
          if [ "$FORK" = "true" ]; then
            echo "::notice::Preview skipped: fork PR."
            echo "run=false" >> "$GITHUB_OUTPUT"
          elif [ -n "$missing" ]; then
            echo "::notice::Preview skipped: $missing not set."
            echo "run=false" >> "$GITHUB_OUTPUT"
          else
            echo "run=true" >> "$GITHUB_OUTPUT"
          fi

      - if: steps.gate.outputs.run == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - if: steps.gate.outputs.run == 'true'
        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
{%- if ts_dir != '.' %}
        with:
          package_json_file: {{ ts_dir }}/package.json
{%- endif %}

      - if: steps.gate.outputs.run == 'true'
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{ node_version }}"

      - if: steps.gate.outputs.run == 'true'
        run: pnpm install --frozen-lockfile

      - if: steps.gate.outputs.run == 'true'
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: dist
          path: {% if ts_dir != '.' %}{{ ts_dir }}/{% endif %}dist

      # Search engines should index the production site, not the preview copies. This
      # block is appended to the build's own _headers, which keeps its security headers.
      - if: steps.gate.outputs.run == 'true'
        run: |
          printf '\n/*\n  X-Robots-Tag: noindex\n' >> dist/_headers

      - if: steps.gate.outputs.run == 'true'
        id: upload
        env:
          CLOUDFLARE_API_TOKEN: {% raw %}${{ secrets.CLOUDFLARE_API_TOKEN }}{% endraw %}
          CLOUDFLARE_ACCOUNT_ID: {% raw %}${{ secrets.CLOUDFLARE_ACCOUNT_ID }}{% endraw %}
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
          PR: {% raw %}${{ github.event.pull_request.number }}{% endraw %}
        run: |-
          # This job may have queued behind a close or a draft switch: a retire that
          # ran first must not be undone by a deploy.
          state=$(gh api "repos/$REPO/pulls/$PR" --jq '.state + " " + (.draft|tostring)')
          if [ "$state" != "open false" ]; then
            echo "::notice::Preview skipped: pull request $PR is no longer open and ready ($state)."
            exit 0
          fi
          "$GITHUB_WORKSPACE/.github/scripts/deploy-worker.sh" Preview "{{ worker_slug }}-pr-$PR"

  # Production: every push to main deploys the build the checks ran on. Without the
  # token, it skips with a notice.
  production:
    name: production
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    # Never cancelled halfway, so a deploy in flight finishes before the next starts.
    concurrency:
      group: production
      cancel-in-progress: false
    needs: [check, e2e]
    runs-on: ubuntu-latest
    timeout-minutes: 10
    environment:
      name: production
      url: {% raw %}${{ steps.deploy.outputs.url }}{% endraw %}
{%- if ts_dir != '.' %}
    defaults:
      run:
        working-directory: {{ ts_dir }}
{%- endif %}
    steps:
      - id: gate
{%- if ts_dir != '.' %}
        # Runs before checkout, when {{ ts_dir }}/ does not exist yet.
        working-directory: .
{%- endif %}
        env:
          TOKEN: {% raw %}${{ secrets.CLOUDFLARE_API_TOKEN }}{% endraw %}
          ACCOUNT: {% raw %}${{ secrets.CLOUDFLARE_ACCOUNT_ID }}{% endraw %}
        run: |
          missing=""
          [ -n "$TOKEN" ] || missing=CLOUDFLARE_API_TOKEN
          [ -n "$ACCOUNT" ] || missing="${missing:+$missing and }CLOUDFLARE_ACCOUNT_ID"
          if [ -n "$missing" ]; then
            echo "::notice::Production deploy skipped: $missing not set."
            echo "run=false" >> "$GITHUB_OUTPUT"
          else
            echo "run=true" >> "$GITHUB_OUTPUT"
          fi

      - if: steps.gate.outputs.run == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - if: steps.gate.outputs.run == 'true'
        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
{%- if ts_dir != '.' %}
        with:
          package_json_file: {{ ts_dir }}/package.json
{%- endif %}

      - if: steps.gate.outputs.run == 'true'
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: "{{ node_version }}"

      - if: steps.gate.outputs.run == 'true'
        run: pnpm install --frozen-lockfile

      - if: steps.gate.outputs.run == 'true'
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: dist
          path: {% if ts_dir != '.' %}{{ ts_dir }}/{% endif %}dist

      - if: steps.gate.outputs.run == 'true'
        id: deploy
        env:
          CLOUDFLARE_API_TOKEN: {% raw %}${{ secrets.CLOUDFLARE_API_TOKEN }}{% endraw %}
          CLOUDFLARE_ACCOUNT_ID: {% raw %}${{ secrets.CLOUDFLARE_ACCOUNT_ID }}{% endraw %}
{%- if custom_domain %}
        # --domain attaches the custom domain here only: previews deploy the same config.
        run: '"$GITHUB_WORKSPACE/.github/scripts/deploy-worker.sh" Production "" --domain {{ custom_domain }}'
{%- else %}
        run: '"$GITHUB_WORKSPACE/.github/scripts/deploy-worker.sh" Production'
{%- endif %}
{%- endif %}
