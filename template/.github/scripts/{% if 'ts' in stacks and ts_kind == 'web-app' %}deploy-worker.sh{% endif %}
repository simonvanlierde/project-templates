#!/usr/bin/env bash
# Deploy the built site to a Worker and report its workers.dev address as the step
# output "url" and in the job summary.
# Usage: deploy-worker.sh LABEL [WORKER]
# LABEL heads the summary line. WORKER overrides the name in wrangler.jsonc.
# Run it where wrangler is installed, with CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID
# set. Exits 1 when wrangler fails or prints no address.
set -euo pipefail

label=$1
args=()
if [ -n "${2:-}" ]; then args=(--name "$2"); fi

# pipefail (set above): the pipe would take tee's status, so a refused deploy would pass.
pnpm exec wrangler deploy ${args[@]+"${args[@]}"} 2>&1 | tee deploy.log
url=$(grep -Eo 'https://[^ ]+\.workers\.dev' deploy.log | head -n 1 || true)
if [ -z "$url" ]; then
  echo "::error::Worker deployed, but wrangler printed no workers.dev address. Check workers_dev in wrangler.jsonc."
  exit 1
fi
echo "url=$url" >>"$GITHUB_OUTPUT"
echo "### $label: $url" >>"$GITHUB_STEP_SUMMARY"
