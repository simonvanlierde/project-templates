#!/usr/bin/env bash
# Publish the update commit prepared by the workflow from its checkout and verified patch.
set -eo pipefail

branch=chore/copier-update
# `--head` matches a fork's branch of the same name too: only this repo's PRs count.
own='map(select(.isCrossRepository == false))'
# Closing an update unmerged declines that tag; a later tag can open a new PR.
declined=$(gh pr list --head "$branch" --base "$BASE" --state closed --json title,mergedAt,isCrossRepository |
  jq --arg title "chore: update from template $LATEST" "$own"' | any(.[]; .title == $title and .mergedAt == null)')
if [ "$declined" = true ]; then
  echo "::notice::Template $LATEST was declined; skipping this tag"
  exit 0
fi
if [ "$HAS_TOKEN" != true ] && [ "$WORKFLOWS" = true ]; then
  title="Update from template $LATEST by hand"
  issue_body="$RUNNER_TEMP/copier-update-issue.md"
  {
    echo "Template \`$LATEST\` changes files in \`.github/workflows/\`, and \`GITHUB_TOKEN\` can't push those."
    echo "Run \`copier update --answers-file <file> --vcs-ref <tag>\` locally for each template in it, and open the PR yourself, or set up the update App (see the template's docs/updates.md) so this workflow can."
  } >"$issue_body"
  # A closed issue counts too, so closing it stops the weekly reminder for this tag.
  # Only the issue this step opened with GITHUB_TOKEN counts, not one anyone titled so.
  if [ -z "$(gh issue list --state all --author app/github-actions --search "\"$title\" in:title" --json number --jq '.[0].number')" ]; then
    gh issue create --title "$title" --body-file "$issue_body"
  fi
  # The older PR may contain someone's work. Leave it for them to finish or close.
  stale=$(gh pr list --head "$branch" --state open --json number,isCrossRepository --jq "$own | .[0].number")
  if [ -n "$stale" ]; then
    echo "::notice::Pull request #$stale is still open for an older template version"
  fi
  echo "::warning::$title: GITHUB_TOKEN can't push workflow changes"
  exit 0
fi

if [ "$HAS_TOKEN" != true ]; then
  printf '\n%s\n' "This PR was opened without the update App, so its checks do not start: close it and reopen it to run them." >>"$RUNNER_TEMP/copier-update/body.md"
fi

# Git uses the credential helper for private repos without putting the token in the command line.
gh auth setup-git
url="https://github.com/${REPO}.git"
ref="refs/heads/$branch"
remote=$(git ls-remote --heads "$url" "$ref")
read -r expected _ <<<"$remote"
if [ -n "$expected" ]; then
  # The new commit's parent is the checkout that the patch was built from.
  # Keep both sides fixed so default-branch changes cannot shift commits between pages.
  base_sha=$(git rev-parse HEAD^)
  # A maintainer can amend a bot-authored commit without changing its author.
  identities=$(gh api --paginate "repos/$REPO/compare/$base_sha...$expected?per_page=100" \
    --jq '.commits[].commit | (.author.email, .committer.email) | if . == null or . == "" then "unknown" else . end')
  if grep -qvxF -e '' -e '41898282+github-actions[bot]@users.noreply.github.com' <<<"$identities"; then
    echo "::notice::$branch has commits from someone other than this workflow; leaving it for them to finish"
    echo "- \`$branch\` has commits from someone other than this workflow, so this run left it alone." >>"$GITHUB_STEP_SUMMARY"
    exit 0
  fi
fi

# An empty expectation allows creation only if the branch is still absent.
git -c core.hooksPath=/dev/null push "--force-with-lease=$ref:$expected" "$url" "$branch"

# With a .rej file left, the PR is a draft, which GitHub will not merge: Copier has already moved
# _commit past those changes, so merging them unresolved would drop them for good.
open=$(gh pr list --head "$branch" --state open --json number,isCrossRepository --jq "$own | .[0].number")
if [ -n "$open" ]; then
  gh pr edit "$open" --title "chore: update from template $LATEST" --body-file "$RUNNER_TEMP/copier-update/body.md"
  if [ "$CONFLICTS" = true ]; then gh pr ready "$open" --undo; fi
else
  draft=()
  if [ "$CONFLICTS" = true ]; then draft=(--draft); fi
  gh pr create --head "$branch" --base "$BASE" --title "chore: update from template $LATEST" --body-file "$RUNNER_TEMP/copier-update/body.md" "${draft[@]}"
fi
