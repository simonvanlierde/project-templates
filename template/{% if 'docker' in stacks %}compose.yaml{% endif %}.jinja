# `docker compose up --watch` rebuilds on source changes. There is no live reload:
# a runtime image ships the built artifact, not ./src.
#
# Ports bind to loopback because Docker's iptables rules run ahead of the host
# firewall. A bare "{{ app_port }}:{{ app_port }}" reaches the LAN even on a deny-by-default
# machine. Drop the 127.0.0.1 to publish a service.
name: {{ slug }}

services:
{%- for stack, service, dir, lock in [
      ('python', 'api', python_dir, 'uv.lock'),
      ('ts', 'web', ts_dir, 'pnpm-lock.yaml'),
    ] if stack in docker_stacks %}
  {{ 'app' if docker_stacks | length == 1 else service }}:
    build:
      context: {{ dir }}
    ports:
{%- if loop.index0 > 0 %}
      # Only the host side moves: each container keeps {{ app_port }} in its own
      # network namespace.
{%- endif %}
      - "127.0.0.1:{{ app_port + loop.index0 }}:{{ app_port }}"
    env_file:
      - path: .env
        required: false
{%- if stack == 'python' and kind == 'web-service' %}
    environment:
      # Fixed here, not in .env: the port mapping and the image's HEALTHCHECK both
      # expect the app on 0.0.0.0:{{ app_port }} in the container.
      HOST: 0.0.0.0
      PORT: "{{ app_port }}"
      # Telemetry stays off unless this names an OTLP/HTTP collector, for example
      # http://otel-collector:4318 on a shared Docker network. Empty means unset.
      OTEL_EXPORTER_OTLP_ENDPOINT: ${OTEL_EXPORTER_OTLP_ENDPOINT:-}
      OTEL_SERVICE_NAME: {{ slug }}
{%- endif %}
    restart: unless-stopped
{%- if loop.first %}
    # The image already runs as a non-root uid. These options stop it regaining what
    # it dropped, at no cost: the entrypoint needs no capability to bind {{ app_port }}.
{%- endif %}
    security_opt:
      - no-new-privileges:true
    cap_drop: [ALL]
    develop:
      watch:
        - action: rebuild
          path: {{ dir }}/src
        - action: rebuild
          path: {{ dir }}/{{ lock }}
{%- endfor %}
