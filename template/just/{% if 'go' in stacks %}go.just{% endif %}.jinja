{% from 'includes/dependency-licenses.jinja' import dependency_licenses with context -%}
{#- just runs every recipe from the root justfile's directory. golangci-lint has
    no flag naming the module, so a nested module is reached with just's own
    working-directory attribute rather than with a cd. It renders empty for the
    flat layout, where the root already is the module. -#}
{%- set wd = '' if go_dir == '.' else "[working-directory: '" ~ go_dir ~ "']\n" -%}
# What CI runs: format check, golangci-lint, tests (with the race detector and every Example), govulncheck{% if license != 'none' %}, licenses{% endif %}.
{{ wd }}go-check:
    golangci-lint fmt --diff
    golangci-lint run
    go test -race ./...
    go tool govulncheck ./...
{%- if license != 'none' %}
    go run github.com/google/go-licenses/v2@{{ go_licenses_version }} report --ignore {{ go_module }} ./...
    go run github.com/google/go-licenses/v2@{{ go_licenses_version }} check --ignore {{ go_module }} --allowed_licenses={{ dependency_licenses | join(',') }} ./...
{%- endif %}

# Resolve go.mod's requirements, govulncheck's included, and write go.sum.
{{ wd }}go-sync:
    go mod tidy

# Format, then apply golangci-lint's fixes.
{{ wd }}go-fmt:
    golangci-lint fmt
    golangci-lint run --fix

# Tests only; extra arguments reach go test (`just go-test -run TestName`).
{{ wd }}go-test *args:
    go test ./... {% raw %}{{ args }}{% endraw %}
{%- if go_kind == 'library' and 'mutation' in test_extras %}

# Slow: CI runs it weekly (mutation.yml); run it by hand after writing tests. `go run`
# keeps gremlins out of go.mod; `copier update` moves its version.

# Plant small bugs in the package and report each one the tests miss.
{{ wd }}go-mutation:
    go run github.com/go-gremlins/gremlins/cmd/gremlins@{{ gremlins_version }} unleash

# The ref is origin/main unless you give one: fast enough to run on each change.

# The same check for the code this branch changed since it split off a git ref.
{{ wd }}go-mutation-diff base='origin/main':
    #!/usr/bin/env bash
    set -euo pipefail
    # gremlins reads `git diff` paths from the repo root; diff.relative makes them relative to here.
    GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=diff.relative GIT_CONFIG_VALUE_0=true \
      go run github.com/go-gremlins/gremlins/cmd/gremlins@{{ gremlins_version }} unleash --diff "$(git merge-base {% raw %}{{ base }}{% endraw %} HEAD)"
{%- endif %}
{%- if go_kind == 'library' and 'property' in test_extras %}

# A later -fuzztime wins (`just go-property -fuzztime=30s`). A failing input is saved
# under testdata/fuzz/FuzzAdd/. CI runs it weekly (property.yml).

# Fuzz FuzzAdd for 10 minutes.
{{ wd }}go-property *args:
    go test -run='^$' -fuzz='^FuzzAdd$' -fuzztime=10m . {% raw %}{{ args }}{% endraw %}
{%- endif %}
