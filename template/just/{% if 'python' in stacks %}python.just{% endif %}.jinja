{#- just runs every recipe from the root justfile's directory, so a nested package
    is reached with uv's --directory, not a cd. It renders empty for the flat
    layout, where the root is the package. -#}
{%- set uv = 'uv' if python_dir == '.' else 'uv --directory ' ~ python_dir -%}
# Install the venv, writing uv.lock if it is missing or stale. CI uses --locked.
py-sync:
    {{ uv }} sync

# What CI runs: lint, format check, types, tests, dependency audit{% if license != 'none' %} and licenses{% endif %}{% if kind == 'data-pipeline' %}. CI also runs the `just pipeline` stages{% endif %}.
py-check:
    {{ uv }} run --locked ruff check
    {{ uv }} run --locked ruff format --check
    {{ uv }} run --locked ty check
    {{ uv }} run --locked pytest
    {{ uv }} audit --locked --preview-features audit-command
{%- if license != 'none' %}
    d=$(mktemp -d) && trap 'rm -rf "$d"' EXIT && {{ uv }} export --locked --no-default-groups --no-hashes --no-annotate --no-header --no-emit-project -q -o "$d/requirements.txt" && { test ! -s "$d/requirements.txt" || {{ uv }} run --locked --with licensecheck=={{ licensecheck_version }} licensecheck{% if license == 'AGPL-3.0-or-later' %} --license AGPL{% endif %} -r "$d/requirements.txt" --zero; }
{%- endif %}

# Fix what ruff can fix, then format.
py-fmt:
    {{ uv }} run ruff check --fix
    {{ uv }} run ruff format

# Tests with a coverage summary.
py-cov:
    {{ uv }} run pytest --cov --cov-report=term-missing

# Tests only; extra arguments reach pytest (`just py-test -k name`).
py-test *args:
    {{ uv }} run pytest {% raw %}{{ args }}{% endraw %}
{%- if kind == 'library' %}

# The tests on every Python version python.yml tests, each in a throwaway environment.
py-matrix:
    for v in {% for m in range(python_min.split('.')[1] | int, python_version.split('.')[1] | int + 1) %}3.{{ m }}{% if not loop.last %} {% endif %}{% endfor %}; do {{ uv }} run --isolated --locked --python "$v" pytest || exit 1; done
{%- endif %}
{%- if kind == 'library' and 'mutation' in test_extras %}
{%- set cd = '' if python_dir == '.' else 'cd ' ~ python_dir ~ '\n    ' %}

# A mutant that no test reaches counts as missed, unless tests/mutation-baseline.txt
# lists it. A listed one that no longer survives fails too. Slow: CI runs it weekly
# (mutation.yml); run it by hand after writing tests. Give mutmut patterns
# (`just py-mutation 'pkg.mod.x_name__mutmut_*'`) to mutate only those; that run skips
# the check for listed ones. `mutmut browse` shows survivors.

# Plant small bugs in the package; fail on a mutant the tests miss.
py-mutation *names:
    #!/usr/bin/env bash
    set -euo pipefail
    {{ cd }}# Byte order, so sort and comm agree on the ǁ in class method mutant names.
    export LC_ALL=C
    # mutmut reuses results from mutants/ even after the tests change, so start clean.
    rm -rf mutants
    # The patterns hold *, so keep the shell from expanding them as file names.
    set -f
    uv run mutmut run {% raw %}{{ names }}{% endraw %}
    survivors=$(uv run mutmut results | sed -nE 's/^ *(.*): (survived|no tests)$/\1/p' | sort)
    listed=$(grep -vE '^(#|$)' tests/mutation-baseline.txt | awk '{ print $1 }' | sort || true)
    new=$(comm -23 <(echo "$survivors" | sed '/^$/d') <(echo "$listed" | sed '/^$/d'))
    echo "$(echo "$survivors" | grep -c . || true) survivors; not in tests/mutation-baseline.txt:"
    echo "${new:-none}"
    gone=
    if [ -z "{% raw %}{{ names }}{% endraw %}" ]; then
        gone=$(comm -13 <(echo "$survivors") <(echo "$listed" | sed '/^$/d'))
        echo "listed but no longer surviving (drop them):"
        echo "${gone:-none}"
    fi
    [ -z "$new$gone" ]

# The ref is origin/main unless you give one: fast enough to run on each change. Fails
# on a survivor not in the baseline. Run `just py-mutation` before a release, since it
# also finds the listed ones to drop.

# The same check for the functions this branch changed since it split off a git ref.
py-mutation-diff base='origin/main':
    #!/usr/bin/env bash
    set -euo pipefail
    {{ cd }}patterns=$(uv run python {% raw %}{{ justfile_directory() }}{% endraw %}/just/mutation_diff.py "$(git merge-base {% raw %}{{ base }}{% endraw %} HEAD)")
    if [ -z "$patterns" ]; then echo "no changed function in a mutated module"; exit 0; fi
    set -f
    {% raw %}{{ just_executable() }} --justfile {{ justfile() }}{% endraw %} py-mutation $patterns
{%- endif %}
{%- if profiling %}

# E.g. `just py-profile -m mypackage.cli <args>`. Needs no perf events, so it runs on
# any host.

# Profile a script or module with pyinstrument and print the call tree.
py-profile *args:
    {{ uv }} run --with pyinstrument pyinstrument {% raw %}{{ args }}{% endraw %}
{%- endif %}
{%- if kind == 'library' and 'property' in test_extras %}

# The profile is in tests/conftest.py. CI runs it weekly (property.yml).

# The tests under Hypothesis's "long" profile: 10,000 examples a property instead of 100.
py-property:
    {{ uv }} run pytest --hypothesis-profile=long
{%- endif %}
{%- if kind == 'data-pipeline' %}

# Download each implemented source in sources.toml to data/raw/, with a fetch record.
fetch:
    {{ uv }} run {{ slug }} fetch

# Turn data/raw/ into data/processed/, verifying each checksum first.
build:
    {{ uv }} run {{ slug }} build

# Re-read data/processed/ and re-hash data/raw/ against the fetch records.
validate:
    {{ uv }} run {{ slug }} validate

# Print the Markdown table of implemented sources and their terms, for ATTRIBUTION.md.
attribution:
    {{ uv }} run {{ slug }} attribution

# One line per source: status, vintage, last fetch, checksum, licence. Reads no network.
status:
    {{ uv }} run {{ slug }} status

# The whole chain, from the network to validated output.
pipeline: fetch build validate
{%- endif %}
{%- if kind == 'web-service' %}

# Serve on 127.0.0.1:{{ app_port }} (HOST and PORT override), outside Docker.
serve:
    {{ uv }} run {{ slug }}
{%- endif %}
