# Keep the build context small: everything here is either rebuilt in the image,
# irrelevant to it, or a secret. Each image carries its own next to its
# Dockerfile, since Docker reads this from the root of the build context.

# VCS / tooling metadata
.git
.github
.copier

# Rebuilt inside the image
node_modules
dist

# Test, lint, and cache artifacts
coverage
*.tsbuildinfo

# Not in the image, and `COPY . .` would otherwise put them in the layer hash:
# touching a test would re-run the whole dependency install, which `docker compose
# up --watch` does on every source change. tsconfig.build.json already keeps them
# out of the build itself.
src/**/*.test.ts
.editorconfig
.pre-commit-config.yaml

# Secrets
.env
.env.*
!.env.example

# Docker meta files themselves
Dockerfile
.dockerignore
compose.yaml
