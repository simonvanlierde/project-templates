# Dependabot, not Renovate: it needs no app install, so a scaffolded repo gets
# updates the moment it is pushed. It covers every ecosystem these layers
# generate, including the `rev` pins in .pre-commit-config.yaml.
#
# No automerge: Dependabot has none natively, and adding it would take a workflow
# holding contents:write.
#
# `cooldown` holds a version update back until the release has been public for a
# week, which is the window a compromised release is caught and yanked in.
# Security updates ignore it, so a known CVE still lands the same day. Ecosystem
# support differs: github-actions and pre-commit take default-days only — see
# the options reference under "cooldown".
version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule: { interval: weekly }
    cooldown: { default-days: 7 }
    groups:
      actions: { patterns: ["*"] }

  # Version updates only; Dependabot has no security updates for this ecosystem.
  # Hook revs group wholesale: they are all dev tooling, and Dependabot reports
  # every pre-commit dep as a production one regardless.
  - package-ecosystem: pre-commit
    directory: /
    schedule: { interval: weekly }
    cooldown: { default-days: 7 }
    groups:
      hooks: { patterns: ["*"] }
{%- if 'python' in stacks %}

  # Dev tooling lands as one PR; a runtime dependency gets its own, so a risky
  # bump is never buried in lint-tool churn.
  - package-ecosystem: uv
    directory: {{ '/' if python_dir == '.' else '/' ~ python_dir }}
    schedule: { interval: weekly }
    cooldown: { default-days: 7, semver-major-days: 30 }
    groups:
      dev-tooling:
        dependency-type: development
        update-types: [minor, patch]
        patterns: ["*"]
{%- endif %}
{%- if 'ts' in stacks %}

  - package-ecosystem: npm
    directory: {{ '/' if ts_dir == '.' else '/' ~ ts_dir }}
    schedule: { interval: weekly }
    cooldown: { default-days: 7, semver-major-days: 30 }
    groups:
      dev-tooling:
        dependency-type: development
        update-types: [minor, patch]
        patterns: ["*"]
{%- endif %}

# No docker ecosystem. It reads FROM lines only, and those tags are copier
# answers rather than pins, so its PRs would fight the next `copier update`. The
# one pin that does want a bot, `COPY --from=ghcr.io/astral-sh/uv:<ver>`, it
# cannot see anyway.
