{#- vcs.root: biome looks for .gitignore beside biome.json unless told otherwise,
    and .gitignore is one file at the repository root, owned by the base layer.
    Nested packages therefore have to point back up at it. -#}
{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true{% if ts_dir != '.' %}, "root": "{{ (['..'] * ts_dir.split('/') | length) | join('/') }}"{% endif %} }
}
